{
  "name": "Noms de branches : feature/* et hotfix/* seulement",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": ["refs/heads/feature/**/*", "refs/heads/hotfix/**/*"]
    }
  },
  "rules": [
    { "type": "creation" }
  ],
  "bypass_actors": []
}
