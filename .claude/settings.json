{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "BASH_MAX_OUTPUT_LENGTH": "12000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-lecture.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git checkout -b feature/*)",
      "Bash(git switch -c feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push --force-with-lease origin feature/*)",
      "Bash(git push -u --force-with-lease origin feature/*)"
    ],
    "deny": [
      "Bash(git push --force origin *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * master)",
      "Bash(git push * master:*)",
      "Bash(git push * dev)",
      "Bash(git push * dev:*)",
      "Read(./**/node_modules/**)",
      "Read(./client/dist/**)",
      "Read(./client/.astro/**)",
      "Read(./client/package-lock.json)",
      "Read(./deploy/site/**)",
      "Read(./**/__pycache__/**)",
      "Read(./data/rows/historique_modification.sql)"
    ]
  }
}
