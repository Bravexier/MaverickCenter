# Maverick Center : Caddy (HTTPS automatique) devant les deux instances posées par les installateurs (deploy/installateur/).
#
#   https://maverick-jdr.com        serveur normal  (master) → 127.0.0.1:8080
#   https://dev.maverick-jdr.com    serveur de test (dev)    → 127.0.0.1:8081
#   https://www.maverick-jdr.com    redirigé vers maverick-jdr.com
#
# Chaque instance est un nginx (docker-compose.yml de l'installateur) protégé par un mot de passe INTERNE : les visiteurs n'en voient pas.
# Caddy le présente à leur place (variables ci-dessous). Pour fermer le site au public (connexion Discord, 1.0), retirer les lignes
# « header_up Authorization » et ne plus donner ce mot de passe à Caddy : le site redemande alors une identification.
#
# Variables, lues par systemd dans /etc/caddy/maverick.env (écrit par instances.sh, droits 600, jamais dans git) :
#   MAVERICK_DOMAINE        maverick-jdr.com (défaut ci-dessous)
#   MAVERICK_ACCES_NORMAL   « invite:motdepasse » encodé en base64 : le mot de passe interne du serveur normal
#   MAVERICK_ACCES_TEST     idem pour le serveur de test
#
# Les ports 8080 et 8081 ne sont publiés que sur 127.0.0.1 (.env de chaque instance, posé par instances.sh) : seul Caddy les atteint.

(maverick_commun) {
	encode zstd gzip

	header {
		# Le contenu appartient à un tiers : accès non référencé (comme les Google Docs actuels), pas d'indexation.
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		# same-origin : l'adresse de la page n'est donnée qu'au site lui-même, jamais à un site tiers ; le service en tire la page d'où vient chaque
		# appel /api/ (métriques, docs/serveur.md, « Métriques et volume »). Même valeur que deploy/nginx.conf.
		Referrer-Policy "same-origin"
		# Aucune page du site n'est faite pour être affichée dans le cadre d'un autre site (clickjacking) ni n'utilise ces capteurs.
		X-Frame-Options "SAMEORIGIN"
		# Politique de contenu minimale (comme deploy/nginx.conf) : ni cadrage, ni <base>, ni <object>, ni formulaire vers un autre site.
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /robots.txt {
		root * /srv/maverick-racine
		file_server
	}
}

{$MAVERICK_DOMAINE:maverick-jdr.com} {
	import maverick_commun

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up Authorization "Basic {$MAVERICK_ACCES_NORMAL}"
		}
	}
}

dev.{$MAVERICK_DOMAINE:maverick-jdr.com} {
	import maverick_commun

	# Serveur de test : jamais de copie gardée par le navigateur (on y modifie les règles, la page doit toujours être celle du serveur).
	header Cache-Control "no-store"

	# Accès au site de dev (R275) : le mot de passe pour modifier et lancer une mise à jour se pose avec « sudo sh /srv/maverick-center-test/acces/acces.sh »
	# et c'est le service qui le demande (docs/serveur.md, « Accès au site de dev ») : rien à changer ici. Le service ne voit jamais l'en-tête Authorization
	# ci-dessous (nginx l'efface) : la clé de lecture des sessions de Claude passe par X-Maverick-Cle ou X-Maverick-Key, que Caddy transmet tels quels.
	#
	# OPTION c, NON ACTIVÉE (« un mot de passe pour tout le site ») : le jour où le propriétaire la choisit, poser la portée avec
	# « sudo sh /srv/maverick-center-test/acces/acces.sh --portee tout », puis remplacer le « handle { … } » ci-dessous par ce qui suit (même mot de passe, une
	# seule saisie : le cookie de session est alors posé pour tout le site ; jamais essayé ici : à relire et à tester sur le serveur avant de s'y fier) :
	#
	#	@ouvert path /api/acces/* /api/mise-a-jour/lots/* /connexion/* /_astro/* /robots.txt
	#	handle @ouvert {
	#		reverse_proxy 127.0.0.1:8081 {
	#			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
	#		}
	#	}
	#	handle {
	#		forward_auth 127.0.0.1:8081 {
	#			uri /api/acces/verifier/
	#			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
	#		}
	#		reverse_proxy 127.0.0.1:8081 {
	#			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
	#		}
	#	}
	#
	# /api/mise-a-jour/lots/* reste ouvert : le workflow GitHub y télécharge le lot figé (adresse à uuid aléatoire, ni fiche ni compte). Un visiteur sans
	# session reçoit le 401 du service (JSON) : la page /connexion/ vers laquelle le renvoyer reste à écrire (tech-front) quand l'option c est choisie.

	handle {
		reverse_proxy 127.0.0.1:8081 {
			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
		}
	}
}

www.{$MAVERICK_DOMAINE:maverick-jdr.com} {
	redir https://{$MAVERICK_DOMAINE:maverick-jdr.com}{uri} permanent
}
