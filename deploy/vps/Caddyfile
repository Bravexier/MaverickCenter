# Maverick Center : Caddy (HTTPS automatique) devant les deux instances posées par les installateurs (deploy/installateur/).
#
#   https://maverick-jdr.com        serveur normal  (master) → 127.0.0.1:8080
#   https://dev.maverick-jdr.com    serveur de test (dev)    → 127.0.0.1:8081
#   https://www.maverick-jdr.com    redirigé vers maverick-jdr.com
#
# Chaque instance est un nginx (docker-compose.yml de l'installateur) protégé par un mot de passe INTERNE : les visiteurs n'en voient pas.
# Caddy le présente à leur place (variables ci-dessous). Le site de dev, lui, est fermé par la connexion Discord (R310 : bloc « dev. » ci-dessous) ; la production
# reste ouverte (R307). Pour fermer aussi la production, il faudrait lui donner la même porte : rien n'est décidé.
#
# Variables, lues par systemd dans /etc/caddy/maverick.env (écrit par instances.sh, droits 600, jamais dans git) :
#   MAVERICK_DOMAINE        maverick-jdr.com (défaut ci-dessous)
#   MAVERICK_ACCES_NORMAL   « invite:motdepasse » encodé en base64 : le mot de passe interne du serveur normal
#   MAVERICK_ACCES_TEST     idem pour le serveur de test
#
# Les ports 8080 et 8081 ne sont publiés que sur 127.0.0.1 (.env de chaque instance, posé par instances.sh) : seul Caddy les atteint.

# HTTP/3 coupé : le Caddy des paquets Ubuntu (2.6.2, recompilé avec quic-go 0.54) laisse vivre l'ancien serveur HTTP/3 après un rechargement
# (« systemctl reload caddy », « caddy reload ») ; ce serveur prend la connexion QUIC suivante sans jamais la servir, et le navigateur qui l'a ouverte
# attend sans fin (constaté le 2026-11-27 ; caddyserver/caddy#7172, corrigé dans Caddy 2.10.1). HTTP/1.1 et HTTP/2 suffisent au site.
# Ce fichier se pose donc par « systemctl restart caddy » (instances.sh le fait), jamais par un rechargement : seul un redémarrage ferme l'écoute UDP
# d'un ancien serveur HTTP/3. Rallumer HTTP/3 demande d'abord un Caddy qui porte ce correctif.
{
	servers {
		protocols h1 h2
	}
}

(maverick_commun) {
	encode zstd gzip

	header {
		# Le contenu appartient à un tiers : accès non référencé (comme les Google Docs actuels), pas d'indexation.
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		# same-origin : l'adresse de la page n'est donnée qu'au site lui-même, jamais à un site tiers ; le service en tire la page d'où vient chaque
		# appel /api/ (métriques, docs/serveur.md, « Métriques et volume »). Même valeur que deploy/nginx.conf.
		Referrer-Policy "same-origin"
		# Aucune page du site n'est faite pour être affichée dans le cadre d'un autre site (clickjacking) ni n'utilise ces capteurs.
		X-Frame-Options "SAMEORIGIN"
		# Politique de contenu minimale (comme deploy/nginx.conf) : ni cadrage, ni <base>, ni <object>, ni formulaire vers un autre site.
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /robots.txt {
		root * /srv/maverick-racine
		file_server
	}
}

{$MAVERICK_DOMAINE:maverick-jdr.com} {
	import maverick_commun

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up Authorization "Basic {$MAVERICK_ACCES_NORMAL}"
		}
	}
}

dev.{$MAVERICK_DOMAINE:maverick-jdr.com} {
	import maverick_commun

	# Serveur de test : jamais de copie gardée par le navigateur (on y modifie les règles, la page doit toujours être celle du serveur).
	header Cache-Control "no-store"

	# Site de dev FERMÉ (R310, docs/serveur.md, « Accès au site de dev ») : plus rien sans une connexion Discord de niveau MJ au moins (ou une clé, pour les
	# sessions de Claude, la CI et les workflows). Deux portes, qui disent la même chose :
	#   - /api/ : le service juge lui-même chaque route (serveur/acces-routes.mjs) et répond en JSON (401 sans session, 403 de niveau trop bas) ; il ne voit jamais
	#     l'en-tête Authorization (nginx l'efface) : les clés passent par X-Maverick-Cle ou X-Maverick-Key, que Caddy transmet tels quels, et la session par le cookie
	#     maverick_session. Y passent donc aussi, sans connexion : la connexion elle-même, le lot figé de la mise à jour (le workflow GitHub le télécharge) et l'état du service.
	#   - les pages (nginx) : « forward_auth » interroge /api/acces/verifier/ avant de les servir ; sans session (401), le visiteur est renvoyé vers /connexion/?retour=<la page> ;
	#     avec une session de niveau trop bas (403), vers /connexion/?erreur=niveau. Restent ouvertes les pages /connexion/ et /confidentialite/ et ce qu'elles chargent (/_astro/, l'icône, le logo).
	#     `retour` porte le chemin décodé (`orig_uri.path`) : Caddy ne documente aucun marqueur de chemin encodé, et les chemins du site sont des identifiants ASCII ; le service
	#     remet `retour` en forme (serveur/discord.mjs#retourValide : encodé, jamais « // » ni une autre origine), et un chemin illisible ramène à /profil/.
	# Jamais essayé sur le serveur avant ce lot : à contrôler après « caddy validate » (https://dev.<domaine>/ sans session doit renvoyer vers /connexion/).
	# La production n'a rien de tel (R307 : aucune restriction nouvelle) : sa connexion et son profil sont ouverts, comme le reste.

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8081 {
			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
		}
	}

	@ouvert path /connexion /connexion/* /confidentialite /confidentialite/* /_astro/* /favicon.png /apple-touch-icon.png /logo.webp
	handle @ouvert {
		reverse_proxy 127.0.0.1:8081 {
			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
		}
	}

	handle {
		forward_auth 127.0.0.1:8081 {
			uri /api/acces/verifier/
			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
			@sans_session status 401
			handle_response @sans_session {
				redir * /connexion/?retour={http.request.orig_uri.path} 302
			}
			@niveau_trop_bas status 403
			handle_response @niveau_trop_bas {
				redir * /connexion/?erreur=niveau 302
			}
		}
		reverse_proxy 127.0.0.1:8081 {
			header_up Authorization "Basic {$MAVERICK_ACCES_TEST}"
		}
	}
}

www.{$MAVERICK_DOMAINE:maverick-jdr.com} {
	redir https://{$MAVERICK_DOMAINE:maverick-jdr.com}{uri} permanent
}
