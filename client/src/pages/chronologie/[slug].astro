---
import Base from '../../layouts/Base.astro';
import ChronologieEvenement from '../../components/chronologie/ChronologieEvenement.astro';
import { chargerChronologie } from '../../lib/chronologie-db.mjs';
import { libelleDeDate } from '../../lib/chronologie.mjs';
import { ouvrirBase } from '../../lib/donnees.mjs';

// Un événement de la chronologie (lib/chronologie.mjs) ; le premier est servi à /chronologie/ (index.astro), pas ici.
export function getStaticPaths() {
  return chargerChronologie(ouvrirBase())
    .slice(1)
    .map((e) => ({ params: { slug: e.id } }));
}

const { slug } = Astro.params as { slug: string };
const evenements = chargerChronologie(ouvrirBase());
const evenement = evenements.find((e) => e.id === slug)!;
---

<Base title={`Chronologie : ${evenement.titre}`} description={`${libelleDeDate(evenement)} : ${evenement.titre}`}>
  <ChronologieEvenement evenements={evenements} id={evenement.id} />
</Base>
