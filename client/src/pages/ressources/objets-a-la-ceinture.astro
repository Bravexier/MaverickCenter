---
import Base from '../../layouts/Base.astro';
import CeinturePage from '../../components/ceinture/CeinturePage.astro';
import { chargerObjetsDeCeinture } from '../../lib/ceinture-db.mjs';
import { ouvrirBase } from '../../lib/donnees.mjs';
import { url } from '../../lib/wiki';

// /ressources/objets-a-la-ceinture/ (menu Ressources, demande du propriétaire, décisions R81 et R82) : une page sans page du wiki, rendue depuis la base
// (vue v_objet_ceinture, components/ceinture/) ; pas encore modifiable sur le site de dev (les potions et les bâtons se modifieront avec leurs pages).
const objets = chargerObjetsDeCeinture(ouvrirBase());
---

<Base title="Objets à la ceinture" description="Potions, huiles, carquois et sacs, bâtons magiques : des objets à mettre à la ceinture.">
  <p class="muted"><a href={url()}>Accueil</a> › <a href={url('ressources/')}>Ressources</a></p>
  <CeinturePage objets={objets} />
</Base>
