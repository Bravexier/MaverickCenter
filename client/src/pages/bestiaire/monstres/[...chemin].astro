---
import Base from '../../../layouts/Base.astro';
import PageMonstre from '../../../components/bestiaire/PageMonstre.astro';
import { chargerMonstres } from '../../../lib/bestiaire-db.mjs';
import { cheminDeMonstre } from '../../../lib/bestiaire-rendu.mjs';
import { ouvrirBase } from '../../../lib/donnees.mjs';

// La page d'un monstre (une carte, ou une espèce sans carte) : bestiaire/monstres/<espèce>/<carte>/ (lib/bestiaire-rendu.mjs#cheminDeMonstre, tiré de
// l'identifiant figé). Le bestiaire est lu une fois : chaque page reçoit sa ligne et le reste en props.
export function getStaticPaths() {
  const monstres = chargerMonstres(ouvrirBase());
  return monstres.lignes.map((ligne) => ({
    params: { chemin: cheminDeMonstre(ligne.id)!.replace(/^bestiaire\/monstres\//, '').replace(/\/$/, '') },
    props: { ligne, monstres },
  }));
}

const { ligne, monstres } = Astro.props;
const description = ligne.carte ? `${ligne.nom} (${ligne.espece.nom}) : la carte du bestiaire.` : `${ligne.nom} : l’espèce du bestiaire.`;
---

<Base title={`${ligne.nom} — Bestiaire`} description={description}>
  <PageMonstre ligne={ligne} monstres={monstres} />
</Base>
