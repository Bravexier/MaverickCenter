---
import Base from '../layouts/Base.astro';
import listeCss from '../styles/personnages/liste.css?raw';
import { COLONNES } from '../lib/personnages-liste.mjs';
import { ouvrirBase } from '../lib/donnees.mjs';
import { couleurDeMagie } from '../lib/sort-format.mjs';
import { url } from '../lib/wiki';

// Recherche des personnages (demande du propriétaire) : tous les prétirés, avec des filtres, en une liste triée par la colonne choisie ; chaque ligne
// (portrait, nom, race, magies, niveau, rien d'autre) est tout entière le lien vers la fiche, bordée de la couleur de la magie innée, en dégradé vers
// l'acquise en bi-magie. Les données viennent du service des personnages (GET /api/personnages/, docs/serveur.md) ; les couleurs des magies, de la
// base au build (celles des pages de magie) ; filtres et tri : lib/personnages-liste.mjs ; le reste : src/scripts/personnages.mjs.
// CSS : styles/personnages/liste.css, inséré ici (?raw).
const couleurs = Object.fromEntries(ouvrirBase().prepare('SELECT id, nom FROM magie ORDER BY ordre').all().map((m) => [m.id, couleurDeMagie(String(m.nom))]));
---

<Base title="Personnages" description="Rechercher les personnages prétirés : filtres et tri par colonne">
  <style is:inline set:html={listeCss}></style>
  <div class="personnages" id="personnages" data-api={url('api/')} data-fiche={url('fiche/')} data-logo={url('logo.webp')} data-couleurs={JSON.stringify(couleurs)}>
    <h1>Personnages</h1>

    <form class="personnages-filtres" id="filtres" role="search" aria-label="Filtres">
      <label class="large">Nom, surnom ou origine<input type="search" name="texte" autocomplete="off" placeholder="Rechercher…" /></label>
      <label>Race<select name="race"><option value="">Toutes</option></select></label>
      <label>Magie<select name="magie"><option value="">Toutes</option></select></label>
      <label>Classe<select name="classe"><option value="">Toutes</option></select></label>
      <label>Niveau
        <span class="niveaux">
          <input type="number" name="niveauMin" min="1" max="20" placeholder="de" aria-label="Niveau minimum" />
          <input type="number" name="niveauMax" min="1" max="20" placeholder="à" aria-label="Niveau maximum" />
        </span>
      </label>
      <label>Règles à revoir
        <select name="regles">
          <option value="">Peu importe</option>
          <option value="sans">Aucune</option>
          <option value="avec">Au moins une</option>
        </select>
      </label>
      <span class="actions"><button type="reset" id="effacer">Effacer les filtres</button></span>
    </form>

    <p class="personnages-compte" id="compte" aria-live="polite">Chargement…</p>
    <p class="banner" id="indisponible" hidden></p>
    <noscript><p class="banner">Cette page a besoin de JavaScript pour interroger le service des personnages.</p></noscript>

    <div class="personnages-liste">
      <div class="personnages-tete" id="tete">
        {COLONNES.map((c) => (c.tri
          ? <button type="button" class={`col col--${c.cle}`} data-cle={c.cle}>{c.titre}<span class="fleche" aria-hidden="true">↕</span></button>
          : <span class={`col col--${c.cle}`}>{c.titre}</span>))}
      </div>
      <ol class="personnages-lignes" id="lignes" aria-label="Personnages"></ol>
    </div>
  </div>
</Base>

<script>
  import '../scripts/personnages.mjs';
</script>
