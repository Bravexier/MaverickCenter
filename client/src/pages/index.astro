---
import Base from '../layouts/Base.astro';
import { TYPES } from '../lib/types.mjs';
import { entriesOfType, loadWiki, url } from '../lib/wiki';

const { entries, unresolved } = await loadWiki();
---

<Base title="Accueil">
  <h1>Maverick Center</h1>
  <p class="prose">
    Le codex de Maverick JDR : toutes les règles et le lore au même endroit, avec des pages reliées entre elles par mots-clés,
    et la fiche de personnage.
  </p>

  <ul class="grid">
    <li><a class="card" href={url('fiche/')}><strong>Fiche de personnage →</strong><small>Race, magies, classe, caractéristiques, sorts, équipement : créez un prétiré étape par étape.</small></a></li>
    <li><a class="card" href={url('personnages/')}><strong>Personnages →</strong><small>Tous les prétirés : recherche, filtres et tri.</small></a></li>
  </ul>

  <h2>Parcourir le wiki</h2>
  <ul class="grid">
    {
      Object.entries(TYPES).map(([key, type]) => (
        <li>
          <a class="card" href={url(`${key}/`)}>
            <strong>{type.label}</strong>
            <small>{type.blurb} ({entriesOfType(entries, key).length})</small>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="muted">
    {entries.length} pages · {unresolved.length} lien(s) à créer.
    <a href={url('pages/')}>Index alphabétique</a> · <a href={url('tags/')}>Mots-clés</a>
  </p>
</Base>
