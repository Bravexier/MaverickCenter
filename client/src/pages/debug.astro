---
import Base from '../layouts/Base.astro';
import debugCss from '../styles/debug/debug.css?raw';
import packageInfo from '../../package.json';
import { modeDuSite } from '../lib/mode-site.mjs';
import { NIVEAUX } from '../lib/debug-journaux.mjs';
import { COLONNES_DES_ROUTES, INSTANCES, MESURES_DE_PAGE, PERIODES, PERIODE_PAR_DEFAUT, TRIS, TRI_PAR_DEFAUT, ariaSort, sensParDefaut } from '../lib/debug-metriques.mjs';
import { url } from '../lib/wiki';
import SchemaDeLaBase from '../components/debug/SchemaDeLaBase.astro';

// Debug (menu Outils, site de dev seulement ; demande du propriétaire : « une page Debug, visible uniquement sur le serveur dev. Dedans tu y mettras
// un menu qui permettra de tester chaque requête à l'image d'un swagger. L'ensemble de ce swagger est caché dans un menu déroulant. En dessous on
// trouvera les logs du serveur (avec une possibilité de filtrer) ») :
//   - « Tester l'API » (details fermé) : le testeur, construit par le script depuis la description OpenAPI du service (GET <base>api/v1/openapi.json,
//     serveur/openapi.mjs ; rendu pur : lib/debug-api.mjs) ;
//   - « Schéma de la base » (details fermé, juste après le testeur ; demande du propriétaire du 2026-10-15 : « En plus d'un openapi, je veux un
//     mappage vectoriel des tables […] D'un double clic sur une de ces tables, ça ouvrirait une popup avec le contenu dans un tableau ») : toutes les
//     tables et vues, leurs colonnes, types et clés étrangères (structure calculée au build : lib/schema-structure.mjs), dessinées à la première
//     ouverture, zoom et déplacement ; le contenu d'une table par GET <base>api/debug/tables/<nom>/ (components/debug/SchemaDeLaBase.astro, son
//     script scripts/debug-schema.mjs, rendu pur lib/debug-schema.mjs) ;
//   - « Performances » (details ouvert ; demande du propriétaire du 2026-10-15 : « isoler les informations de temps de réponse […] voir quels sont les
//     appels les plus lents en moyenne ») : les métriques de l'instance choisie — dev OU production, deux jeux de données séparés (décision du
//     propriétaire) — sur une période : routes (triables, les plus lentes mises en évidence), courbe, pages vues mesurées par le navigateur
//     (balise de layouts/Base.astro), navigateurs et appareils, origines, requêtes récentes (mémoire du site de dev), export CSV
//     (GET <base>api/debug/metriques/…, serveur/metriques.mjs ; rendu pur : lib/debug-metriques.mjs), relevées toutes les 30 s ;
//   - « Système » (details ouvert) : processus, disque, fichiers, volume des métriques et sa croissance, échantillons, évènements, alertes
//     (GET <base>api/debug/systeme/), même instance, toutes les 30 s ;
//   - « Journaux du serveur » : le journal du service en mémoire (GET <base>api/debug/journal/, serveur/journal-du-service.mjs ; rendu pur :
//     lib/debug-journaux.mjs), relevé toutes les 2 s, filtré dans la page ; une colonne Durée (isolée, triable) et « plus lent que … ms » (?min_ms=).
//   - « Espace disque du serveur », tout en bas (demande du propriétaire du 2026-10-15 : « la métrique de la place occupée sur le serveur sur la
//     place totale sous forme de jauge, colorée en fonction du type de données (DB, Code, Import images, etc.) ») : une jauge pleine largeur,
//     un segment coloré par type (`disque.repartition` de GET <base>api/debug/systeme/, même instance, même relève que « Système »), le libre en
//     clair, et la légende (nom, taille, part du total) ; rendu pur : lib/debug-metriques.mjs#htmlDeLEspaceDisque.
// Le script (scripts/debug.mjs) lit d'abord GET <base>api/etat/ : sans `edition: true`, le service n'est pas celui du site de dev et il s'arrête.
// Build de production (SITE_MODE=prod) et version portable (pas de service ; tools/build-artifact.mjs ne l'emporte pas) : une phrase, sans script.
// Hors du menu ailleurs que sur le site de dev (lib/nav.mjs#entreesDuMenu). CSS : styles/debug/, inséré ici (?raw).
const site = modeDuSite(process.env, packageInfo.version);
const portable = process.env.INLINE_CSS === '1';
const actif = !site.prod && !portable;
---

<Base title="Debug" description="Outils du serveur de dev : tester l’API du service, parcourir le schéma de la base, suivre ses performances, son système, ses journaux et son espace disque">
  <style is:inline set:html={debugCss}></style>
  <h1>Debug</h1>
  {
    actif ? (
      <div class="debug" data-debug data-api={url('api/')} data-base={url()}>
        <p class="debug-etat" data-debug-etat role="status">Interrogation du service…</p>
        <noscript>
          <p class="debug-etat debug-etat--erreur">Cette page demande JavaScript : le testeur, les métriques et les journaux sont construits dans le navigateur.</p>
        </noscript>

        <details class="debug-testeur" data-debug-testeur hidden>
          <summary>
            <span class="debug-testeur__titre">Tester l’API</span>
            <span class="debug-testeur__compte" data-testeur-compte></span>
          </summary>
          <div class="debug-testeur__contenu">
            <p class="debug-avertissement">
              Les requêtes partent vers le service de ce site : une écriture (POST, PUT, PATCH, DELETE) modifie la base du site de dev, comme le mode
              modification. Chaque réponse donne la commande curl équivalente ; si le site demande un mot de passe, ajoutez-y
              <code>-u &lt;utilisateur&gt;</code>.
            </p>
            <div class="debug-filtre">
              <label for="debug-filtre-ops">Filtrer les opérations</label>
              <input type="search" id="debug-filtre-ops" data-testeur-filtre placeholder="méthode, adresse, résumé…" autocomplete="off" spellcheck="false" />
              <span class="debug-filtre__resume" data-testeur-resume></span>
            </div>
            <div class="debug-groupes" data-testeur-groupes>
              <p class="debug-attente">La description de l’API se charge à l’ouverture.</p>
            </div>
          </div>
        </details>

        <SchemaDeLaBase />

        <details class="debug-bloc debug-perfs" data-debug-perfs open hidden>
          <summary>
            <h2 class="debug-bloc__titre" id="debug-perfs-titre">Performances</h2>
            <span class="debug-bloc__resume" data-perfs-resume></span>
          </summary>
          <div class="debug-bloc__contenu">
            <form class="debug-choix" data-perfs-choix>
              <div class="debug-choix__champ">
                <label for="debug-perfs-instance">Instance (performances et système)</label>
                <select id="debug-perfs-instance" data-perfs-instance>
                  {INSTANCES.map((i, rang) => <option value={i.cle} selected={rang === 0}>{i.libelle}</option>)}
                </select>
              </div>
              <div class="debug-choix__champ">
                <label for="debug-perfs-periode">Période</label>
                <select id="debug-perfs-periode" data-perfs-periode>
                  {PERIODES.map((p) => <option value={p.cle} selected={p.cle === PERIODE_PAR_DEFAUT}>{p.libelle}</option>)}
                </select>
              </div>
              <div class="debug-choix__champ">
                <label for="debug-perfs-tri">Trier les routes par</label>
                <select id="debug-perfs-tri" data-perfs-tri>
                  {TRIS.map((t) => <option value={t.cle} selected={t.cle === TRI_PAR_DEFAUT}>{t.libelle}</option>)}
                </select>
              </div>
              <div class="debug-choix__actions">
                <button type="button" data-perfs-actualiser>Actualiser</button>
                <a class="debug-bouton" data-perfs-export="csv" href={url(`api/debug/metriques/export/?instance=dev&periode=${PERIODE_PAR_DEFAUT}&format=csv`)} download>Exporter (CSV)</a>
                <a class="debug-bouton debug-bouton--discret" data-perfs-export="json" href={url(`api/debug/metriques/export/?instance=dev&periode=${PERIODE_PAR_DEFAUT}&format=json`)} download>JSON</a>
              </div>
            </form>
            <p class="debug-annonce" data-perfs-annonce role="status" aria-live="polite"></p>
            <p class="debug-petit">
              Chiffres d’ensemble et courbe sans les relèves automatiques (journal, métriques et système de cette page, état de maintenance de chaque
              page, balise des pages vues) : chacune garde sa ligne dans le tableau des routes. « > 5 s » : au-delà de la dernière classe mesurée.
            </p>
            <dl class="debug-chiffres" data-perfs-global></dl>
            <div class="debug-figure" data-perfs-serie></div>

            <h3 id="debug-routes-titre">Routes</h3>
            <p class="debug-petit">
              Temps de réponse du service par route (gabarit sans identifiant). Marquées : moyenne d’au moins 100 ms (lente) ou 500 ms (très lente), et
              les trois plus lentes en moyenne. Un en-tête trie le tableau.
            </p>
            <div class="debug-cadre" tabindex="0" role="region" aria-labelledby="debug-routes-titre">
              <table class="debug-tableau debug-routes">
                <thead>
                  <tr>
                    {
                      COLONNES_DES_ROUTES.map((col) => (
                        <th scope="col" aria-sort={ariaSort({ cle: TRI_PAR_DEFAUT, sens: sensParDefaut(TRI_PAR_DEFAUT) }, col.cle)}>
                          <button type="button" class="debug-tri" data-tri-colonne={col.cle}>{col.libelle}</button>
                        </th>
                      ))
                    }
                  </tr>
                </thead>
                <tbody data-perfs-routes></tbody>
              </table>
              <p class="debug-vide" data-perfs-routes-vide>Aucun appel sur la période.</p>
            </div>

            <h3 id="debug-pages-titre">Pages vues (temps mesurés par le navigateur)</h3>
            <p class="debug-petit">Moyenne / p95 de chaque temps, depuis le début de la navigation ; LCP marqué au-delà de 2,5 s (lent) et 4 s (très lent) ; « > 60 s » : au-delà de la dernière classe mesurée.</p>
            <p class="debug-petit" data-perfs-fenetre hidden></p>
            <div class="debug-cadre" tabindex="0" role="region" aria-labelledby="debug-pages-titre">
              <table class="debug-tableau">
                <thead>
                  <tr>
                    <th scope="col">Page</th>
                    <th scope="col">Vues</th>
                    {MESURES_DE_PAGE.map((m) => <th scope="col">{m.libelle}</th>)}
                  </tr>
                </thead>
                <tbody data-perfs-pages></tbody>
              </table>
              <p class="debug-vide" data-perfs-pages-vide>Aucune page vue mesurée sur la période.</p>
            </div>

            <div class="debug-deux">
              <section aria-labelledby="debug-navigateurs-titre">
                <h3 id="debug-navigateurs-titre">Navigateurs et appareils</h3>
                <div class="debug-cadre" tabindex="0" role="region" aria-labelledby="debug-navigateurs-titre">
                  <table class="debug-tableau">
                    <thead>
                      <tr><th scope="col">Navigateur</th><th scope="col">Appareil</th><th scope="col">Appels</th><th scope="col">Part</th></tr>
                    </thead>
                    <tbody data-perfs-navigateurs></tbody>
                  </table>
                  <p class="debug-vide" data-perfs-navigateurs-vide>Aucun appel sur la période.</p>
                </div>
              </section>
              <section aria-labelledby="debug-origines-titre">
                <h3 id="debug-origines-titre">Origines des appels</h3>
                <div class="debug-cadre" tabindex="0" role="region" aria-labelledby="debug-origines-titre">
                  <table class="debug-tableau">
                    <thead>
                      <tr><th scope="col">Page</th><th scope="col">Route appelée</th><th scope="col">Appels</th></tr>
                    </thead>
                    <tbody data-perfs-origines></tbody>
                  </table>
                  <p class="debug-vide" data-perfs-origines-vide>Aucun appel sur la période.</p>
                </div>
              </section>
            </div>

            <section class="debug-requetes" aria-labelledby="debug-requetes-titre">
              <h3 id="debug-requetes-titre">Requêtes récentes <small>(site de dev, en mémoire)</small></h3>
              <p class="debug-petit" data-requetes-autre hidden></p>
              <div data-requetes-contenu>
              <form class="debug-choix" data-requetes-filtres>
                <div class="debug-choix__champ">
                  <label for="debug-requetes-min">Plus lentes que (ms)</label>
                  <input type="number" id="debug-requetes-min" data-requetes-min min="0" step="1" inputmode="decimal" autocomplete="off" />
                </div>
                <div class="debug-choix__champ debug-choix__champ--large">
                  <label for="debug-requetes-route">Route</label>
                  <select id="debug-requetes-route" data-requetes-route>
                    <option value="">Toutes</option>
                  </select>
                </div>
              </form>
              <p class="debug-annonce" data-requetes-annonce role="status" aria-live="polite"></p>
              <ul class="debug-requetes__liste" data-requetes-liste></ul>
              <p class="debug-vide" data-requetes-vide>Aucune requête en mémoire.</p>
              </div>
            </section>
          </div>
        </details>

        <details class="debug-bloc debug-systeme" data-debug-systeme open hidden>
          <summary>
            <h2 class="debug-bloc__titre" id="debug-systeme-titre">Système</h2>
            <span class="debug-bloc__resume" data-systeme-resume></span>
          </summary>
          <div class="debug-bloc__contenu">
            <p class="debug-annonce" data-systeme-annonce role="status" aria-live="polite"></p>
            <div data-systeme-alertes></div>
            <div class="debug-trois">
              <section aria-labelledby="debug-processus-titre">
                <h3 id="debug-processus-titre">Processus</h3>
                <div data-systeme-processus></div>
              </section>
              <section aria-labelledby="debug-disque-titre">
                <h3 id="debug-disque-titre">Disque</h3>
                <div data-systeme-disque></div>
              </section>
              <section aria-labelledby="debug-volume-titre">
                <h3 id="debug-volume-titre">Volume des métriques</h3>
                <div data-systeme-volume></div>
              </section>
            </div>
            <h3>Mémoire et boucle d’événements</h3>
            <div class="debug-figure" data-systeme-echantillons></div>
            <h3 id="debug-fichiers-titre">Fichiers</h3>
            <div class="debug-cadre" tabindex="0" role="region" aria-labelledby="debug-fichiers-titre">
              <table class="debug-tableau">
                <thead>
                  <tr><th scope="col">Fichier</th><th scope="col">Chemin</th><th scope="col">Taille</th></tr>
                </thead>
                <tbody data-systeme-fichiers></tbody>
              </table>
            </div>
            <h3 id="debug-evenements-titre">Évènements du service</h3>
            <div class="debug-cadre debug-cadre--haut" tabindex="0" role="region" aria-labelledby="debug-evenements-titre">
              <table class="debug-tableau">
                <thead>
                  <tr><th scope="col">Heure</th><th scope="col">Type</th><th scope="col">Durée</th><th scope="col">Détail</th></tr>
                </thead>
                <tbody data-systeme-evenements></tbody>
              </table>
              <p class="debug-vide" data-systeme-evenements-vide>Aucun évènement enregistré.</p>
            </div>
          </div>
        </details>

        <section class="debug-journaux" data-debug-journaux aria-labelledby="debug-journaux-titre" hidden>
          <h2 id="debug-journaux-titre">Journaux du serveur</h2>
          <form class="debug-journaux__filtres" data-journaux-filtres>
            <fieldset class="debug-journaux__niveaux">
              <legend>Niveaux</legend>
              {
                NIVEAUX.map((n) => (
                  <label class={`debug-niveau-choix debug-niveau-choix--${n.cle}`}>
                    <input type="checkbox" name="niveau" value={n.cle} checked /> {n.libelle}
                  </label>
                ))
              }
            </fieldset>
            <div class="debug-journaux__champ">
              <label for="debug-journaux-categorie">Catégorie</label>
              <select id="debug-journaux-categorie" data-journaux-categorie>
                <option value="">Toutes</option>
              </select>
            </div>
            <div class="debug-journaux__champ debug-journaux__champ--texte">
              <label for="debug-journaux-texte">Texte</label>
              <input type="search" id="debug-journaux-texte" data-journaux-texte autocomplete="off" spellcheck="false" />
            </div>
            <div class="debug-journaux__champ debug-journaux__champ--duree">
              <label for="debug-journaux-min-ms">Plus lent que (ms)</label>
              <input type="number" id="debug-journaux-min-ms" data-journaux-min-ms min="0" step="1" inputmode="decimal" autocomplete="off" />
            </div>
            <div class="debug-journaux__actions">
              <button type="button" data-journaux-pause aria-pressed="false">Pause</button>
              <button type="button" data-journaux-effacer>Effacer l’affichage</button>
            </div>
          </form>
          <p class="debug-journaux__annonce" data-journaux-annonce role="status" aria-live="polite"></p>
          <p class="debug-journaux__resume" data-journaux-resume></p>
          <div class="debug-journaux__cadre" tabindex="0" role="region" aria-label="Entrées du journal (défilement)">
            <table class="debug-journaux__tableau">
              <thead>
                <tr>
                  <th scope="col" aria-sort="descending"><button type="button" class="debug-tri" data-journaux-tri="instant">Heure</button></th>
                  <th scope="col">Niveau</th>
                  <th scope="col">Catégorie</th>
                  <th scope="col" aria-sort="none"><button type="button" class="debug-tri" data-journaux-tri="duree">Durée</button></th>
                  <th scope="col">Message</th>
                </tr>
              </thead>
              <tbody data-journaux-lignes></tbody>
            </table>
            <p class="debug-journaux__vide" data-journaux-vide>Aucune entrée pour l’instant.</p>
          </div>
        </section>

        <section class="debug-espace" data-debug-espace aria-labelledby="debug-espace-titre" hidden>
          <h2 id="debug-espace-titre">Espace disque du serveur</h2>
          <p class="debug-petit">
            La place occupée sur la place totale du disque de l’instance choisie (« Instance », dans Performances), par type de données ; le
            service relève la répartition toutes les 10 minutes. Survolez un segment ou un type de la légende pour le repérer.
          </p>
          <p class="debug-annonce" data-espace-annonce role="status" aria-live="polite"></p>
          <div class="debug-espace__contenu" data-espace-jauge></div>
        </section>
      </div>
    ) : (
      <p class="debug-reservee">Cette page est réservée au serveur de dev.</p>
    )
  }
  {actif && <script>import '../scripts/debug.mjs';</script>}
</Base>
