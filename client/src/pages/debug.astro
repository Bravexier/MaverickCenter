---
import Base from '../layouts/Base.astro';
import debugCss from '../styles/debug/debug.css?raw';
import packageInfo from '../../package.json';
import { modeDuSite } from '../lib/mode-site.mjs';
import { NIVEAUX } from '../lib/debug-journaux.mjs';
import { url } from '../lib/wiki';

// Debug (menu Outils, site de dev seulement ; demande du propriétaire : « une page Debug, visible uniquement sur le serveur dev. Dedans tu y mettras
// un menu qui permettra de tester chaque requête à l'image d'un swagger. L'ensemble de ce swagger est caché dans un menu déroulant. En dessous on
// trouvera les logs du serveur (avec une possibilité de filtrer) ») :
//   - « Tester l'API » (details fermé) : le testeur, construit par le script depuis la description OpenAPI du service (GET <base>api/v1/openapi.json,
//     serveur/openapi.mjs ; rendu pur : lib/debug-api.mjs) ;
//   - « Journaux du serveur » : le journal du service en mémoire (GET <base>api/debug/journal/, serveur/journal-du-service.mjs ; rendu pur :
//     lib/debug-journaux.mjs), relevé toutes les 2 s, filtré dans la page.
// Le script (scripts/debug.mjs) lit d'abord GET <base>api/etat/ : sans `edition: true`, le service n'est pas celui du site de dev et il s'arrête.
// Build de production (SITE_MODE=prod) et version portable (pas de service ; tools/build-artifact.mjs ne l'emporte pas) : une phrase, sans script.
// Hors du menu ailleurs que sur le site de dev (lib/nav.mjs#entreesDuMenu). CSS : styles/debug/, inséré ici (?raw).
const site = modeDuSite(process.env, packageInfo.version);
const portable = process.env.INLINE_CSS === '1';
const actif = !site.prod && !portable;
---

<Base title="Debug" description="Outils du serveur de dev : tester l’API du service et lire ses journaux">
  <style is:inline set:html={debugCss}></style>
  <h1>Debug</h1>
  {
    actif ? (
      <div class="debug" data-debug data-api={url('api/')} data-base={url()}>
        <p class="debug-etat" data-debug-etat role="status">Interrogation du service…</p>
        <noscript>
          <p class="debug-etat debug-etat--erreur">Cette page demande JavaScript : le testeur et les journaux sont construits dans le navigateur.</p>
        </noscript>

        <details class="debug-testeur" data-debug-testeur hidden>
          <summary>
            <span class="debug-testeur__titre">Tester l’API</span>
            <span class="debug-testeur__compte" data-testeur-compte></span>
          </summary>
          <div class="debug-testeur__contenu">
            <p class="debug-avertissement">
              Les requêtes partent vers le service de ce site : une écriture (POST, PUT, PATCH, DELETE) modifie la base du site de dev, comme le mode
              modification. Chaque réponse donne la commande curl équivalente ; si le site demande un mot de passe, ajoutez-y
              <code>-u &lt;utilisateur&gt;</code>.
            </p>
            <div class="debug-filtre">
              <label for="debug-filtre-ops">Filtrer les opérations</label>
              <input type="search" id="debug-filtre-ops" data-testeur-filtre placeholder="méthode, adresse, résumé…" autocomplete="off" spellcheck="false" />
              <span class="debug-filtre__resume" data-testeur-resume></span>
            </div>
            <div class="debug-groupes" data-testeur-groupes>
              <p class="debug-attente">La description de l’API se charge à l’ouverture.</p>
            </div>
          </div>
        </details>

        <section class="debug-journaux" data-debug-journaux aria-labelledby="debug-journaux-titre" hidden>
          <h2 id="debug-journaux-titre">Journaux du serveur</h2>
          <form class="debug-journaux__filtres" data-journaux-filtres>
            <fieldset class="debug-journaux__niveaux">
              <legend>Niveaux</legend>
              {
                NIVEAUX.map((n) => (
                  <label class={`debug-niveau-choix debug-niveau-choix--${n.cle}`}>
                    <input type="checkbox" name="niveau" value={n.cle} checked /> {n.libelle}
                  </label>
                ))
              }
            </fieldset>
            <div class="debug-journaux__champ">
              <label for="debug-journaux-categorie">Catégorie</label>
              <select id="debug-journaux-categorie" data-journaux-categorie>
                <option value="">Toutes</option>
              </select>
            </div>
            <div class="debug-journaux__champ debug-journaux__champ--texte">
              <label for="debug-journaux-texte">Texte</label>
              <input type="search" id="debug-journaux-texte" data-journaux-texte autocomplete="off" spellcheck="false" />
            </div>
            <div class="debug-journaux__actions">
              <button type="button" data-journaux-pause aria-pressed="false">Pause</button>
              <button type="button" data-journaux-effacer>Effacer l’affichage</button>
            </div>
          </form>
          <p class="debug-journaux__annonce" data-journaux-annonce role="status" aria-live="polite"></p>
          <p class="debug-journaux__resume" data-journaux-resume></p>
          <div class="debug-journaux__cadre" tabindex="0" role="region" aria-label="Entrées du journal (défilement)">
            <table class="debug-journaux__tableau">
              <thead>
                <tr>
                  <th scope="col">Heure</th>
                  <th scope="col">Niveau</th>
                  <th scope="col">Catégorie</th>
                  <th scope="col">Message</th>
                </tr>
              </thead>
              <tbody data-journaux-lignes></tbody>
            </table>
            <p class="debug-journaux__vide" data-journaux-vide>Aucune entrée pour l’instant.</p>
          </div>
        </section>
      </div>
    ) : (
      <p class="debug-reservee">Cette page est réservée au serveur de dev.</p>
    )
  }
  {actif && <script>import '../scripts/debug.mjs';</script>}
</Base>
