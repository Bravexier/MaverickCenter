---
import Base from '../layouts/Base.astro';
import rulesData from '../data/rules.json';
import { loadWiki, url } from '../lib/wiki';

// Un lien `wiki` dont la page n'existe pas dans ce build (ex. pages d'exemple masquées) est retiré.
const { entries } = await loadWiki();
const known = new Set(entries.map((e) => e.id));
const keepKnownLinks = <T extends { wiki?: string }>(list: T[]) =>
  list.map((item) => (item.wiki && !known.has(item.wiki) ? { ...item, wiki: undefined } : item));
const rules = {
  ...rulesData,
  races: keepKnownLinks(rulesData.races),
  classes: keepKnownLinks(rulesData.classes),
  magies: keepKnownLinks(rulesData.magies),
};

const isExample = rules.meta.status === 'example';
---

<Base title="Générateur de fiche" description="Créez une fiche de personnage pour Maverick JDR">
  <h1 class="no-print">Générateur de fiche de personnage</h1>
  {isExample && <p class="banner no-print" role="note">{rules.meta.note}</p>}

  <script id="rules-data" type="application/json" set:html={JSON.stringify(rules)} />

  <div class="generator" data-base={url()} data-suffix="">
    <form class="generator__form no-print" id="character-form" autocomplete="off">
      <p class="generator__actions">
        <button type="button" id="btn-new">Nouveau</button>
        <button type="button" id="btn-export">Exporter (JSON)</button>
        <button type="button" id="btn-import">Importer…</button>
        <button type="button" id="btn-print">Imprimer / PDF</button>
        <input type="file" id="file-import" accept="application/json,.json" hidden />
      </p>
      <p id="messages" class="muted" aria-live="polite"></p>

      <label>Nom du personnage <input type="text" id="c-name" maxlength="100" /></label>

      <label>Race
        <select id="c-race">
          <option value="">— choisir —</option>
          {rules.races.map((race) => <option value={race.id}>{race.name}</option>)}
        </select>
      </label>

      <fieldset>
        <legend>Classe{rules.limits.classes > 1 ? `s (max. ${rules.limits.classes})` : ''}</legend>
        {rules.classes.map((cls) => <label class="check"><input type="checkbox" data-kind="classes" value={cls.id} /> {cls.name}</label>)}
      </fieldset>

      <fieldset>
        <legend>Magie{rules.limits.magies > 1 ? `s (max. ${rules.limits.magies})` : ''}</legend>
        {rules.magies.map((magic) => <label class="check"><input type="checkbox" data-kind="magies" value={magic.id} /> {magic.name}</label>)}
      </fieldset>

      <fieldset>
        <legend>Caractéristiques — <span id="points-left"></span> point(s) à répartir</legend>
        <table class="attrs">
          <thead><tr><th>Caractéristique</th><th>Points</th><th>Bonus</th><th>Total</th></tr></thead>
          <tbody>
            {
              rules.attributes.map((attr) => (
                <tr data-attr={attr.id}>
                  <th scope="row">{attr.label}</th>
                  <td>
                    <button type="button" data-delta="-1" aria-label={`Retirer un point : ${attr.label}`}>−</button>
                    <output class="spent"></output>
                    <button type="button" data-delta="1" aria-label={`Ajouter un point : ${attr.label}`}>+</button>
                  </td>
                  <td class="bonus"></td>
                  <td class="final"></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </fieldset>

      <label>Notes <textarea id="c-notes" rows="5" maxlength="5000"></textarea></label>
    </form>

    <section class="sheet" id="sheet" aria-label="Fiche de personnage">
      <h2 data-out="name"></h2>
      <p data-out="identity"></p>
      <table class="attrs">
        <tbody id="sheet-attrs"></tbody>
      </table>
      <ul id="sheet-derived" class="plain"></ul>
      <div id="sheet-traits"></div>
      <h3>Notes</h3>
      <p data-out="notes" class="pre"></p>
    </section>
  </div>
</Base>

<script>
  import {
    changeAttribute, derivedStats, finalAttributes, bonuses, isClassAllowed, isMagicAllowed, newCharacter,
    parseExport, pointsLeft, sanitize, serialize, setRace, toggleChoice, validate,
  } from '../lib/character.mjs';

  const STORAGE_KEY = 'maverick.character.v1';
  const rules = JSON.parse(document.querySelector('#rules-data')!.textContent!);
  const root = document.querySelector<HTMLElement>('.generator')!;
  const base = root.dataset.base!.replace(/\/$/, '');
  const suffix = root.dataset.suffix ?? '';
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;

  const nameInput = $<HTMLInputElement>('#c-name');
  const raceSelect = $<HTMLSelectElement>('#c-race');
  const notesInput = $<HTMLTextAreaElement>('#c-notes');
  const messages = $('#messages');
  const fileInput = $<HTMLInputElement>('#file-import');

  let ch = load();

  function load() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) return sanitize(rules, JSON.parse(saved));
    } catch {
      /* stockage indisponible ou corrompu : on repart d'une fiche vide */
    }
    return newCharacter(rules);
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(ch));
    } catch {
      /* navigation privée, quota… : la fiche reste utilisable, sans sauvegarde auto */
    }
  }

  const choice = (kind: 'races' | 'classes' | 'magies', id: string) => rules[kind].find((c: { id: string }) => c.id === id);

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) {
    const node = document.createElement(tag);
    if (text !== undefined) node.textContent = text;
    if (className) node.className = className;
    return node;
  }

  /** Nom d'un choix, lié à sa page du wiki quand elle est renseignée. */
  function nameOf(kind: 'races' | 'classes' | 'magies', id: string) {
    const item = choice(kind, id);
    if (!item?.wiki) return el('span', item?.name);
    const a = el('a', item.name);
    a.href = `${base}/${item.wiki}/${suffix}`;
    return a;
  }

  function joined(kind: 'races' | 'classes' | 'magies', ids: string[]) {
    const out = el('span');
    ids.forEach((id, i) => out.append(i ? ', ' : '', nameOf(kind, id)));
    return out;
  }

  function render() {
    // Formulaire
    raceSelect.value = ch.race;
    for (const box of document.querySelectorAll<HTMLInputElement>('input[data-kind]')) {
      const kind = box.dataset.kind as 'classes' | 'magies';
      const item = choice(kind, box.value);
      const allowed = kind === 'classes' ? isClassAllowed(ch, item) : isMagicAllowed(ch, item);
      box.checked = ch[kind].includes(box.value);
      box.disabled = !allowed;
      box.closest('label')!.classList.toggle('is-disabled', !allowed);
    }

    const left = pointsLeft(rules, ch);
    $('#points-left').textContent = String(left);
    const bonus = bonuses(rules, ch);
    const final = finalAttributes(rules, ch);
    for (const row of document.querySelectorAll<HTMLElement>('tr[data-attr]')) {
      const id = row.dataset.attr!;
      row.querySelector('.spent')!.textContent = String(rules.creation.base + ch.spent[id]);
      row.querySelector('.bonus')!.textContent = bonus[id] ? (bonus[id] > 0 ? `+${bonus[id]}` : String(bonus[id])) : '';
      row.querySelector('.final')!.textContent = String(final[id]);
      for (const button of row.querySelectorAll<HTMLButtonElement>('button[data-delta]')) {
        button.disabled = changeAttribute(rules, ch, id, Number(button.dataset.delta)) === ch;
      }
    }

    const { errors, warnings } = validate(rules, ch);
    messages.textContent = [...errors, ...warnings].join(' ');

    // Fiche (aperçu et impression)
    $('[data-out="name"]').textContent = ch.name || 'Personnage sans nom';
    const identity = $('[data-out="identity"]');
    identity.replaceChildren();
    const groups: Node[] = [];
    if (ch.race) groups.push(nameOf('races', ch.race));
    if (ch.classes.length) groups.push(joined('classes', ch.classes));
    if (ch.magies.length) {
      const magic = el('span', 'Magie : ');
      magic.append(joined('magies', ch.magies));
      groups.push(magic);
    }
    groups.forEach((group, i) => identity.append(...(i ? [' · '] : []), group));

    const attrs = $('#sheet-attrs');
    attrs.replaceChildren(
      ...rules.attributes.map((attr: { id: string; label: string }) => {
        const tr = el('tr');
        tr.append(el('th', attr.label), el('td', String(final[attr.id])));
        return tr;
      }),
    );
    $('#sheet-derived').replaceChildren(
      ...derivedStats(rules, ch).map((d: { label: string; value: number }) => el('li', `${d.label} : ${d.value}`)),
    );

    const traits = $('#sheet-traits');
    traits.replaceChildren();
    const sources = [choice('races', ch.race), ...ch.classes.map((id: string) => choice('classes', id))].filter(Boolean);
    for (const source of sources) {
      if (!source.traits?.length) continue;
      traits.append(el('h3', source.name));
      const ul = el('ul');
      source.traits.forEach((t: string) => ul.append(el('li', t)));
      traits.append(ul);
    }
    $('[data-out="notes"]').textContent = ch.notes;
  }

  function update(next: typeof ch) {
    ch = next;
    save();
    render();
  }

  // Interactions
  nameInput.addEventListener('input', () => update({ ...ch, name: nameInput.value }));
  notesInput.addEventListener('input', () => update({ ...ch, notes: notesInput.value }));
  raceSelect.addEventListener('change', () => update(setRace(rules, ch, raceSelect.value)));

  $('#character-form').addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-delta]');
    if (button) update(changeAttribute(rules, ch, button.closest<HTMLElement>('tr')!.dataset.attr!, Number(button.dataset.delta)));
  });
  $('#character-form').addEventListener('change', (event) => {
    const box = event.target as HTMLInputElement;
    if (box.dataset?.kind) update(toggleChoice(rules, ch, box.dataset.kind as 'classes' | 'magies', box.value));
  });

  function syncTextFields() {
    nameInput.value = ch.name;
    notesInput.value = ch.notes;
  }

  $('#btn-new').addEventListener('click', () => {
    if (confirm('Effacer la fiche actuelle et recommencer ?')) {
      ch = newCharacter(rules);
      save();
      syncTextFields();
      render();
    }
  });
  $('#btn-print').addEventListener('click', () => window.print());
  $('#btn-export').addEventListener('click', () => {
    const blob = new Blob([serialize(rules, ch)], { type: 'application/json' });
    const link = Object.assign(document.createElement('a'), {
      href: URL.createObjectURL(blob),
      download: `${(ch.name || 'personnage').replace(/[^\p{L}\p{N}_-]+/gu, '_')}.maverick.json`,
    });
    link.click();
    URL.revokeObjectURL(link.href);
  });
  $('#btn-import').addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (!file) return;
    try {
      ch = parseExport(rules, await file.text());
      save();
      syncTextFields();
      render();
    } catch (err) {
      messages.textContent = (err as Error).message;
    }
  });

  syncTextFields();
  render();
</script>
