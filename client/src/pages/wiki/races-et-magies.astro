---
import Base from '../../layouts/Base.astro';
import { accessMatrix, entriesAvecRelationsDeLaBase, relationMatrix } from '../../lib/magie-relations.mjs';
import { loadMagies } from '../../lib/magies';
import { groupRaces } from '../../lib/race-kinds.mjs';
import { entryHref, loadWiki, url } from '../../lib/wiki';

const { entries } = await loadWiki();
const access = accessMatrix(entries);
// Résistances, vulnérabilités et incompatibilités : celles de la base, comme sur les pages de magie.
const relations = relationMatrix(entriesAvecRelationsDeLaBase(entries, loadMagies()));
// Lignes du premier tableau : races pures puis hybrides (même rangement que la liste des races).
const rowOf = new Map(access.races.map((race, i) => [race.id, i]));
const groups = groupRaces(entries)
  .map((g) => ({ ...g, entries: g.entries.filter((r) => rowOf.has(r.id)) }))
  .filter((g) => g.entries.length > 0);
const unavailable = access.races.length === 0 || access.magies.length === 0;
---

<Base title="Races et magies" description="Quelles magies innées pour chaque race, et relations entre les magies.">
  <p class="muted"><a href={url('wiki/')}>Wiki</a> › Races et magies</p>
  <h1>Races et magies</h1>

  {
    unavailable ? (
      <p>Les données d’accessibilité des magies ne sont pas disponibles.</p>
    ) : (
      <>
        <nav class="class-nav" aria-label="Sections">
          <a class="badge" href="#acces">Magies innées par race</a>
          <a class="badge" href="#relations">Relations entre magies</a>
        </nav>

        <h2 id="acces">Magies innées par race</h2>
        <p class="legend">
          ✓ = la race peut avoir cette magie en magie innée. Les races hybrides sont celles qui ont leur propre classe raciale, et le Drassah'thac.
        </p>
        <div class="matrix-wrap">
          <table class="matrix">
            <thead>
              <tr>
                <th scope="col">Race</th>
                {access.magies.map((m) => <th scope="col"><a href={entryHref(m)} title={m.data.title}>{m.data.nom_court}</a></th>)}
                <th scope="col">Total</th>
              </tr>
            </thead>
            <tbody>
              {groups.map((group) => (
                <>
                  <tr class="group-row"><th colspan={access.magies.length + 2} scope="colgroup">{group.label} ({group.entries.length})</th></tr>
                  {group.entries.map((race) => {
                    const cells = access.cells[rowOf.get(race.id)!];
                    return (
                      <tr>
                        <th scope="row"><a href={entryHref(race)}>{race.data.title}</a></th>
                        {cells.map((yes, j) =>
                          yes ? (
                            <td class="yes" aria-label={`${race.data.title} peut avoir ${access.magies[j].data.nom_court}`}>✓</td>
                          ) : (
                            <td class="no" aria-label={`${race.data.title} ne peut pas avoir ${access.magies[j].data.nom_court}`}>·</td>
                          ),
                        )}
                        <td>{cells.filter(Boolean).length}</td>
                      </tr>
                    );
                  })}
                </>
              ))}
            </tbody>
          </table>
        </div>

        <h2 id="relations">Relations entre magies</h2>
        <p class="legend">
          Ligne = la magie décrite, colonne = l’autre magie. <span class="fort">▲ fort contre</span> (résistance magique),
          <span class="faible">▼ faible contre</span> (vulnérabilité magique), <span class="incompatible">✕ incompatible</span> (ne se combine pas).
          Une case « – » veut dire que la page de la magie ne donne pas de liste.
        </p>
        <div class="matrix-wrap">
          <table class="matrix">
            <thead>
              <tr>
                <th scope="col">Magie</th>
                {relations.magies.map((m) => <th scope="col"><a href={entryHref(m)} title={m.data.title}>{m.data.nom_court}</a></th>)}
              </tr>
            </thead>
            <tbody>
              {relations.magies.map((row, i) => (
                <tr>
                  <th scope="row"><a href={entryHref(row)}>{row.data.nom_court}</a></th>
                  {relations.cells[i].map((cell, j) => {
                    if (cell === null) return <td class="no" aria-label="pas de donnée">–</td>;
                    const marks = [cell.fort && '▲', cell.faible && '▼', cell.incompatible && '✕'].filter(Boolean);
                    const label = [cell.fort && 'fort contre', cell.faible && 'faible contre', cell.incompatible && 'incompatible'].filter(Boolean).join(', ');
                    const cls = cell.fort ? 'fort' : cell.faible ? 'faible' : cell.incompatible ? 'incompatible' : 'no';
                    return marks.length ? (
                      <td class={cls} aria-label={`${row.data.nom_court} : ${label} ${relations.magies[j].data.nom_court}`}>{marks.join('')}</td>
                    ) : (
                      <td class="no" aria-hidden="true">·</td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
</Base>
