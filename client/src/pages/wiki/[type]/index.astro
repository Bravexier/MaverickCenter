---
import Base from '../../../layouts/Base.astro';
import EntryList from '../../../components/EntryList.astro';
import RaceList from '../../../components/RaceList.astro';
import ClassesTableau from '../../../components/classes/ClassesTableau.astro';
import MagiesConstellation from '../../../components/magie/MagiesConstellation.astro';
import TableauMagiesInnees from '../../../components/magie/TableauMagiesInnees.astro';
import TableauRelationsMagies from '../../../components/magie/TableauRelationsMagies.astro';
import { TYPES, TYPE_KEYS } from '../../../lib/types.mjs';
import { groupClasses } from '../../../lib/class-groups.mjs';
import { groupRaces } from '../../../lib/race-kinds.mjs';
import { groupByClass } from '../../../lib/capacites.mjs';
import { loadMagies } from '../../../lib/magies';
import { entryHref } from '../../../lib/wiki';
import { entriesOfType, loadWiki } from '../../../lib/wiki';

export function getStaticPaths() {
  return TYPE_KEYS.map((type) => ({ params: { type } }));
}

const { type } = Astro.params as { type: keyof typeof TYPES };
const { entries } = await loadWiki();
const list = entriesOfType(entries, type);
// Les magies : la carte (MagiesConstellation), puis le tableau des relations entre magies.
const dbMagies = type === 'magies' ? loadMagies() : null;
const entriesById = new Map(list.map((entry) => [entry.id, entry]));
const magiesIndex = dbMagies
  ? [...dbMagies.magies.values()].flatMap((magie) => {
      const entry = entriesById.get(magie.id);
      return entry ? [{ entry, magie }] : [];
    })
  : [];
// Les classes sont présentées en tableau, une colonne par catégorie (voir lib/class-groups.mjs) ; les autres types en liste alphabétique.
const classGroups = type === 'classes' ? groupClasses(list) : [];
// Les races sont présentées en deux colonnes, pures à gauche et hybrides à droite, dans l'ordre du propriétaire (lib/race-kinds.mjs) ;
// nom et accroche seulement. Le tableau des magies innées de toutes les races est en bas de la page.
const raceGroups = type === 'races' ? groupRaces(entries) : [];
// Les dons de classe (pages `capacites/…`) sont rangés par classe (une fiche par don : plus de 600).
const capaciteGroups = type === 'capacites' ? groupByClass(entries) : [];
const capaciteDetail = (e: any) => [`Niveau ${e.data.niveau}`, e.data.specialite, e.data.type_capacite].filter(Boolean).join(' · ');
---

<Base title={TYPES[type].label}>
  <h1>{TYPES[type].label}</h1>
  {type !== 'magies' && <p class="muted">{TYPES[type].blurb}</p>}
  {
    type === 'magies' ? (
      <>
        <MagiesConstellation magies={magiesIndex} />
        <section id="relations" aria-labelledby="relations-titre">
          <h2 id="relations-titre">Relations entre magies</h2>
          <TableauRelationsMagies entries={entries} />
        </section>
      </>
    ) : classGroups.length > 0 ? (
      <ClassesTableau groups={classGroups} />
    ) : capaciteGroups.length > 0 ? (
      <>
        <p class="muted">
          Une fiche par don de classe. Les dons d'une même ligne dans l'onglet de la classe sont un choix : un seul peut être pris. La page de chaque classe les montre disposés comme l'onglet.
        </p>
        {capaciteGroups.map((group) => (
          <section>
            <h2>{group.classe ? <a href={entryHref(group.classe)}>{group.classe.data.title}</a> : 'Sans classe'} <span class="muted">({group.entries.length})</span></h2>
            <ul class="entry-list">
              {group.entries.map((e) => (
                <li>
                  <a href={entryHref(e)}>{e.data.title}</a> <span class="muted">{capaciteDetail(e)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    ) : raceGroups.length > 0 ? (
      <>
        <div class="race-columns">
          {raceGroups.map((group) => (
            <section id={group.key} class="race-column">
              <h2>{group.label} <span class="muted">({group.entries.length})</span></h2>
              <RaceList races={group.entries} />
            </section>
          ))}
        </div>
        <section id="magies-innees" aria-labelledby="magies-innees-titre">
          <h2 id="magies-innees-titre">Magies innées par race</h2>
          <p class="legend">Une pastille de la couleur de la magie : la race peut l’avoir en magie innée.</p>
          <TableauMagiesInnees entries={entries} />
        </section>
      </>
    ) : list.length ? (
      <EntryList entries={list} showType={false} />
    ) : (
      <p>Aucune page pour l’instant dans cette catégorie.</p>
    )
  }
</Base>
