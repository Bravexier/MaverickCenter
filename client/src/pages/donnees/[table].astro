---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/wiki';
import { lister, ouvrirBase, preparerTable } from '../../lib/donnees.mjs';

export function getStaticPaths() {
  return lister(ouvrirBase()).flatMap((s) => s.objets.map((o) => ({ params: { table: o.nom } })));
}

const { table } = Astro.params;
const t = preparerTable(ouvrirBase(), table as string);
const avecPage = t.lignes.some((l) => l.page);
const nature = t.genre === 'vue' ? 'Vue : calculée à partir d’autres tables, toujours à jour. ' : t.derivee ? 'Table dérivée : recalculée à chaque construction de la base. ' : '';
---

<Base title={`Données : ${t.nom}`} description={t.description || `Table ${t.nom} de la base de données`}>
  <p class="donnees-fil"><a href={url('donnees/')}>Données</a> › <code>{t.nom}</code></p>
  <h1><code>{t.nom}</code></h1>
  <p class="donnees-role">{nature}{t.description}</p>
  <details class="donnees-colonnes">
    <summary>{t.colonnes.length} colonnes</summary>
    <table>
      <thead><tr><th>Colonne</th><th>Type</th><th>Clé</th><th>Description</th></tr></thead>
      <tbody>
        {
          t.colonnes.map((c) => (
            <tr>
              <td><code>{c.nom}</code></td>
              <td>{c.type}</td>
              <td>{c.cle ? 'clé primaire' : ''}{c.vers && <>{c.cle ? ', ' : ''}→ <a href={url(`donnees/${c.vers}/`)}><code>{c.vers}</code></a></>}</td>
              <td>{c.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
  <p class="donnees-filtre">
    <label>Filtrer les lignes <input type="search" id="filtre" autocomplete="off" /></label>
    <span id="compte" aria-live="polite">{t.lignes.length.toLocaleString('fr-FR')} lignes</span>
    <span class="donnees-aide">Cliquer sur un titre de colonne pour trier.</span>
  </p>
  <div class="donnees-wrap">
    <table class="donnees" id="donnees">
      <thead>
        <tr>
          {avecPage && <th title="Page du wiki">Page</th>}
          {t.colonnes.map((c) => <th title={c.note || c.type}>{c.nom}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          t.lignes.map((l) => (
            <tr id={l.ancre ?? undefined}>
              {avecPage && <td>{l.page && <a href={url(`wiki/${l.page}/`)} title="Page du wiki">↗</a>}</td>}
              {l.cellules.map((c) =>
                c.nul ? <td class="nul" /> : c.lien ? <td><a href={`${url(`donnees/${c.lien.table}/`)}#${c.lien.ancre}`}>{c.t}</a></td> : <td>{c.t}</td>,
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <script is:inline>
    (() => {
      const table = document.getElementById('donnees');
      const champ = document.getElementById('filtre');
      const compte = document.getElementById('compte');
      if (!table || !champ) return;
      const corps = table.tBodies[0];
      const lignes = [...corps.rows];
      const decalage = table.tHead.rows[0].cells[0].textContent === 'Page' ? 1 : 0;
      const plier = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
      const textes = lignes.map((tr) => plier([...tr.cells].slice(decalage).map((c) => c.textContent).join(' ')));
      const maj = () => {
        const q = plier(champ.value.trim());
        let n = 0;
        lignes.forEach((tr, i) => { const ok = !q || textes[i].includes(q); tr.hidden = !ok; if (ok) n += 1; });
        compte.textContent = `${n.toLocaleString('fr-FR')} / ${lignes.length.toLocaleString('fr-FR')} lignes`;
      };
      champ.addEventListener('input', maj);
      table.tHead.addEventListener('click', (e) => {
        const th = e.target.closest('th');
        if (!th || th.cellIndex < decalage) return;
        const i = th.cellIndex;
        const sens = th.dataset.sens === 'asc' ? 'desc' : 'asc';
        table.tHead.querySelectorAll('th').forEach((x) => { delete x.dataset.sens; });
        th.dataset.sens = sens;
        const val = (tr) => tr.cells[i].textContent.trim();
        const nombres = lignes.every((tr) => val(tr) === '' || !Number.isNaN(Number(val(tr))));
        lignes.sort((a, b) => {
          const x = val(a);
          const y = val(b);
          let c;
          if (nombres) c = x === y ? 0 : x === '' ? -1 : y === '' ? 1 : Number(x) - Number(y);
          else c = x.localeCompare(y, 'fr', { numeric: true });
          return sens === 'asc' ? c : -c;
        });
        lignes.forEach((tr) => corps.appendChild(tr));
      });
    })();
  </script>
</Base>
