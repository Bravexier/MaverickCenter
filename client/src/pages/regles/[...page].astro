---
import PageDuPlan from '../../components/guide/PageDuPlan.astro';
import { loadWiki, pagesSous, type WikiEntry } from '../../lib/wiki';

// Les pages des Bases (lib/livres.mjs#LES_BASES) à /regles/<slug>/, celles des Règles avancées (REGLES_AVANCEES) à /regles/avancees/<slug>/, chacune
// à côté du menu latéral de sa rubrique (components/guide/MenuLateral.astro). /regles/ (pages/regles/index.astro) et /regles/avancees/
// (pages/regles/avancees/index.astro) montrent ce menu ouvert sur leur première page ; le sommaire de l'Artisanat est pages/regles/artisanat.astro.
export async function getStaticPaths() {
  const { entries } = await loadWiki();
  return pagesSous(entries, 'regles/').filter(({ reste }) => reste).map(({ entry, reste }) => ({ params: { page: reste }, props: { entry } }));
}
const { entry } = Astro.props as { entry: WikiEntry };
---

<PageDuPlan entry={entry} />
