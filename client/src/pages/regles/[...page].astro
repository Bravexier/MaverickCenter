---
import PageDuPlan from '../../components/guide/PageDuPlan.astro';
import { loadWiki, pagesSous, type WikiEntry } from '../../lib/wiki';

// Les pages des Bases (lib/livres.mjs#LES_BASES) à /regles/<slug>/, à côté de leur menu latéral (components/guide/LesBases.astro), celles des Règles
// avancées à /regles/avancees/<slug>/. /regles/ (pages/regles/index.astro) montre le menu des Bases ouvert sur leur première page ; le sommaire des
// Règles avancées est pages/regles/avancees/index.astro, celui de l'Artisanat pages/regles/artisanat.astro.
export async function getStaticPaths() {
  const { entries } = await loadWiki();
  return pagesSous(entries, 'regles/').filter(({ reste }) => reste).map(({ entry, reste }) => ({ params: { page: reste }, props: { entry } }));
}
const { entry } = Astro.props as { entry: WikiEntry };
---

<PageDuPlan entry={entry} />
