---
import PageDuPlan from '../../../components/guide/PageDuPlan.astro';
import { REGLES_AVANCEES } from '../../../lib/livres.mjs';
import { loadWiki } from '../../../lib/wiki';

// /regles/avancees/ : les Règles avancées, ouvertes sur leur première page (lib/livres.mjs#REGLES_AVANCEES.ouverture, « Le Mode Hyper »), comme
// /regles/ pour Les bases (demande du propriétaire du 2026-11-05 : « Suite à la modification de la page "les bases" refait la même avec les "règles
// avancées", tout sur la même page avec menu lattéral. » ; réponses : « Liste sans groupes » — « Comme Les bases : une seule liste de titres, dans
// l'ordre actuel des groupes. » — et « Le Mode Hyper ») : le menu latéral des pages, le texte de la page choisie à droite. Plus de sommaire en groupes ;
// la page garde son adresse /regles/avancees/<slug>/, que celle-ci désigne comme canonique (components/guide/PageDuPlan.astro).
const { entries } = await loadWiki();
const entry = entries.find((e) => e.id === REGLES_AVANCEES.ouverture);
if (!entry) throw new Error(`/${REGLES_AVANCEES.chemin} : ${REGLES_AVANCEES.ouverture} n'existe pas (plan du guide, lib/livres.mjs)`);
---

<PageDuPlan entry={entry} ouverture />
