---
import Base from '../../layouts/Base.astro';
import Tableau from '../../components/Tableau.astro';
import glossaireCss from '../../styles/glossaire/glossaire.css?raw';
import { url } from '../../lib/wiki';
import { COLONNES_DU_GLOSSAIRE, htmlDeLaLigneDuGlossaire } from '../../lib/mots-cles-balises.mjs';
import { categoriesDesMotsCles, chargerVocabulaire, pagesDesLiens } from '../../lib/mots-cles-db.mjs';
import { mentionsDesMotsCles } from '../../lib/mentions-des-mots-cles.mjs';
import { choixDesCouleurs } from '../../lib/glossaire-couleurs.mjs';
import { cssDesFamilles, FAMILLES_DES_ZONES } from '../../lib/palette-css.mjs';
import { ouvrirBase } from '../../lib/donnees.mjs';

// Le Glossaire (réponses du propriétaire du 2026-11-06, Q6 et Q7 : une entrée « Glossaire » dans le menu Règles, après Exploration ; une page seule,
// /regles/glossaire/) : le tableau de TOUS les mots-clés du glossaire (table mot_cle), avec ou sans définition (décision R234 : « dans le même style que
// les autres », le gabarit commun des tableaux, components/Tableau.astro, avec la couleur du mot-clé en liseré comme pour les armes) — ses noms (le
// libellé et ses synonymes, R233), ses catégories (R232), son lien (le titre de la page où il mène, sinon l'adresse : lib/mots-cles-db.mjs#pagesDesLiens),
// le menu des pages qui le mentionnent (ses mentions, R196 : étiquettes et balises, lib/mentions-des-mots-cles.mjs), et sa définition dans une ligne
// en plus, sous la sienne. Une ligne : lib/mots-cles-balises.mjs#htmlDeLaLigneDuGlossaire, le même HTML que l'extension de l'éditeur. Les filtres (texte,
// catégorie : R234 (4)) : src/scripts/glossaire.mjs.
// Sur le site de dev, en mode modification, toute la gestion du vocabulaire est ici (src/scripts/edition/mots-cles.mjs : créer, renommer, définir, les
// synonymes, les catégories, fusionner, supprimer, la balise à copier, l'adresse et la couleur ; les catégories elles-mêmes) ; /recherche/ ne fait plus que
// chercher. Les couleurs que le choix propose (`data-couleurs`, lib/glossaire-couleurs.mjs : toutes les familles de la palette, que le navigateur
// n'importe pas) et leurs feuilles : les familles d'une zone émises ici (celles de chaque page viennent de layouts/Base.astro), pour que le liseré et la
// liste les montrent.
// Aucun id de la page ne commence par « mot-cle- » : c'est celui des bulles du glossaire (lib/mots-cles-balises.mjs#idDeBulle).
const db = ouvrirBase();
const base = import.meta.env.BASE_URL;
const vocabulaire = chargerVocabulaire(db);
const categories = categoriesDesMotsCles(db);
const mentions = mentionsDesMotsCles(db, vocabulaire.map((m) => m.id));
const liens = pagesDesLiens(db, vocabulaire);
const lignes = vocabulaire
  .map((m) => htmlDeLaLigneDuGlossaire({ ...m, mentions: mentions.get(m.id) ?? [], lien: liens.get(m.id) ?? null }, { base, categories }))
  .join('');
const entete = `<thead><tr>${COLONNES_DU_GLOSSAIRE.map((c) => `<th scope="col">${c}</th>`).join('')}</tr></thead>`;
const couleurs = JSON.stringify(choixDesCouleurs(db));
---

<Base title="Glossaire" description="Le glossaire de Maverick : tous les mots-clés des règles et du lore, leur définition et les pages qui les citent" edition="regles/glossaire/">
  <style is:inline set:html={glossaireCss}></style>
  {/* les familles d'une zone de la palette : le liseré d'un mot-clé et le choix de sa couleur en mode modification */}
  <style is:inline set:html={cssDesFamilles(FAMILLES_DES_ZONES)}></style>
  <div class="glossaire" data-glossaire data-couleurs={couleurs}>
    <h1>Glossaire</h1>
    <p class="glossaire-intro">Les mots-clés des règles et du lore : leurs noms, leurs catégories, leur définition, et les pages qui les citent.</p>
    <form class="glossaire-filtre" role="search">
      <input id="filtre-glossaire" type="search" aria-label="Filtrer le glossaire" placeholder="Filtrer : mot-clé, synonyme, définition…" autocomplete="off" />
      <select id="filtre-categorie" aria-label="Filtrer par catégorie">
        <option value="">Toutes les catégories</option>
        <option value="sans">Sans catégorie</option>
        {categories.map((c) => <option value={String(c.id)}>{c.libelle}</option>)}
      </select>
      <span id="glossaire-compte" class="muted" aria-live="polite">{vocabulaire.length} mots-clés</span>
    </form>
    <noscript><p class="banner">Les filtres demandent JavaScript ; le tableau est complet sans lui.</p></noscript>
    <Tableau class="glossaire-tableau" classeTable="glossaire-table" attributsTable={{ id: 'liste-mots-cles', 'aria-label': 'Mots-clés du glossaire' }}>
      <Fragment set:html={entete + lignes} />
    </Tableau>
    <p id="aucun-mot-cle" class="muted" hidden>Aucun mot-clé ne correspond.</p>
    <p class="muted glossaire-voir-aussi">Chercher dans tout le site : la <a href={url('recherche/')}>recherche</a>.</p>
  </div>
</Base>

<script>
  import '../../scripts/glossaire.mjs';
</script>
