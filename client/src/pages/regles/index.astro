---
import Base from '../../layouts/Base.astro';
import Sommaire from '../../components/guide/Sommaire.astro';
import { groupesDesBases, LES_BASES, verifierLePlan } from '../../lib/livres.mjs';
import { entryHref, loadWiki } from '../../lib/wiki';

// Le sommaire des Bases (lib/livres.mjs#LES_BASES ; choix du propriétaire du 2026-10-18 : « Les bases = une page par sujet, listées sur un sommaire
// « Les bases » à /regles/ (comme les Règles avancées) ») : les groupes « Jouer », « Progresser », « Pour aller plus loin », chacun dans sa couleur, le
// titre et le résumé de chaque page (tels que la base les écrit), rien d'autre.
const { entries } = await loadWiki();
const groupes = groupesDesBases(verifierLePlan(entries)).map((g) => ({
  id: g.id,
  titre: g.titre,
  couleur: g.couleur,
  elements: g.pages.map((e) => ({ href: entryHref(e), titre: e.data.title, resume: e.data.summary })),
}));
---

<Base title={LES_BASES.titre}>
  <h1>{LES_BASES.titre}</h1>
  <Sommaire groupes={groupes} />
</Base>
