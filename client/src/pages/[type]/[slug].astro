---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PiedDePage from '../../components/PiedDePage.astro';
import MagiesDeRace from '../../components/magie/MagiesDeRace.astro';
import RacesDeMagie from '../../components/magie/RacesDeMagie.astro';
import MagiePage from '../../components/magie/MagiePage.astro';
import RacePage from '../../components/race/RacePage.astro';
import ClassePage from '../../components/classes/ClassePage.astro';
import ChoixDeCapacite from '../../components/classes/ChoixDeCapacite.astro';
import { TYPES } from '../../lib/types.mjs';
import { classCategory } from '../../lib/class-groups.mjs';
import { isMagicalClass } from '../../lib/classe-magique.mjs';
import { loadMagies } from '../../lib/magies';
import { loadRaces } from '../../lib/races';
import { loadClasses } from '../../lib/classes';
import { raceKind, raceOfClass } from '../../lib/race-kinds.mjs';
import { estServieASonId } from '../../lib/metiers.mjs';
import { entryHref, loadWiki, slugOf, typeOf, url, type WikiEntry } from '../../lib/wiki';
import { attributEd, texteDePageModifiable } from '../../lib/edition-modele.mjs';

export async function getStaticPaths() {
  const { entries } = await loadWiki();
  // Seules les pages servies à `<id>/` (lib/metiers.mjs#estServieASonId) : les métiers n'ont pas de page, ce sont les lignes du tableau de /metiers/,
  // où mènent leurs liens ; les pages « Armes », « Armures », « Bouclier » et « Accessoires » sont servies par les pages de l'équipement
  // (pages/ressources/armes.astro…), « Bâton magique » par la page Ceinture, « Pièces élémentaires » par les pages Armes et Armures
  // (lib/metiers.mjs#pageSansAdresse) ; les pages du guide sont rangées par lib/livres.mjs et servies
  // par pages/decouvrir/, pages/regles/ et pages/mj/ (components/guide/PageDuPlan.astro).
  return entries.filter((entry) => estServieASonId(entry.id))
    .map((entry) => ({ params: { type: typeOf(entry), slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: WikiEntry };
const { entries } = await loadWiki();

const type = TYPES[typeOf(entry)];
const category = typeOf(entry) === 'classes' ? classCategory(entry) : null;
const isMagic = typeOf(entry) === 'classes' && isMagicalClass(entries, entry);
const kind = typeOf(entry) === 'races' ? raceKind(entries, entry) : null;
const raceOfThisClass = typeOf(entry) === 'classes' ? raceOfClass(entries, entry) : null;
const classOfAbility = typeOf(entry) === 'capacites' ? entries.find((e) => e.id === entry.data.classe) : null;
// Pages de magie : gabarit commun (components/magie/MagiePage.astro) alimenté par les tables de la base ; une page sans ligne dans `magie`
// (la magie d'exemple) garde le rendu Markdown.
const magies = typeOf(entry) === 'magies' ? loadMagies() : null;
const magie = magies?.magies.get(entry.id) ?? null;
// Pages de race : même principe (components/race/RacePage.astro, tables race, race_onglet, race_don… ; lib/races-db.mjs) ; la race d'exemple garde le Markdown.
const races = typeOf(entry) === 'races' ? loadRaces() : null;
const race = races?.races.get(entry.id) ?? null;
// Pages de classe : même principe (components/classes/ClassePage.astro, tables classe, specialite, capacite… ; lib/classes-db.mjs) ; la classe d'exemple garde le Markdown.
const classes = typeOf(entry) === 'classes' ? loadClasses() : null;
const classe = classes?.classes.get(entry.id) ?? null;
const gabarit = Boolean(magie || race || classe);
const Content = gabarit ? null : (await render(entry)).Content; // les gabarits des magies, des races et des classes ne rendent pas le Markdown
// Seules les pages d'exemple ont un bandeau : plus de bandeau « brouillon » sur les pages `draft` (demande du propriétaire).
const statusNote = entry.data.status === 'example' ? 'Contenu d’exemple : à remplacer par le contenu réel du codex.' : '';
// Mode modification du site de dev (demande du propriétaire) : les pages des races, des magies et des classes (les métiers sont sur /metiers/, les pages
// du guide sur leurs routes : components/guide/PageDuPlan.astro), et celles du Codex (« Exactement comme pour les pages des règles les pages du codex
// doivent pouvoir être modifiées aussi »).
const pageDeTexte = texteDePageModifiable(typeOf(entry), entry.data.sources[0]); // le Codex (lib/edition-modele.mjs)
const modifiable = (pageDeTexte || ['races', 'magies', 'classes'].includes(typeOf(entry))) && entry.data.status !== 'example';
// une page du Codex : titre et texte modifiables (src/scripts/edition/guide.mjs) ; les autres pages suivent leurs tables
const texteModifiable = modifiable && pageDeTexte;
---

<Base title={entry.data.title} description={entry.data.summary} edition={modifiable ? entry.id : undefined}>
  <p class="muted"><a href={url()}>Accueil</a> › <a href={url(`${typeOf(entry)}/`)}>{type.label}</a>{
    typeOf(entry) === 'capacites' && classOfAbility && (
      <>
        {' › '}
        <a href={entryHref(classOfAbility)}>{classOfAbility.data.title}</a>
        {entry.data.specialite && <> › {entry.data.specialite}</>}
      </>
    )
  }{
    race && (
      <>
        {' › '}
        <a href={url(`races/#${race.hybride ? 'hybrides' : 'pures'}`)}>{race.hybride ? 'Races hybrides' : 'Races pures'}</a>
      </>
    )
  }{
    category && (
      <>
        {' › '}
        <a href={url(`classes/#${category.key}`)}>{category.label}</a>
      </>
    )
  }</p>
  {
    magie && magies ? (
      <MagiePage entry={entry} entries={entries} magie={magie} magies={magies} statusNote={statusNote} />
    ) : race && races ? (
      <RacePage entry={entry} entries={entries} race={race} races={races} statusNote={statusNote} />
    ) : classe ? (
      <ClassePage entry={entry} classe={classe} statusNote={statusNote} />
    ) : (
      <>
        <h1>
          {texteModifiable ? <span data-ed={attributEd('page', { id: entry.id }, 'titre')}>{entry.data.title}</span> : entry.data.title}{' '}
          {
            kind ? (
              <span class={`badge badge--${kind}`}>{kind === 'hybride' ? 'Race hybride' : 'Race pure'}</span>
            ) : (
              <span class="badge">{type.singular}</span>
            )
          }
        </h1>
        {isMagic && <p class="banner" role="note"><strong>Classe magique</strong> : +4 AM de base selon sa catégorie ou la spécialité choisie.</p>}
        {entry.data.aliases.length > 0 && <p class="muted">Aussi appelé : {entry.data.aliases.join(', ')}</p>}
        {statusNote && <p class="banner" role="note">{statusNote}</p>}

        {raceOfThisClass && (
          <p>Classe raciale de la race <a href={entryHref(raceOfThisClass)}>{raceOfThisClass.data.title}</a>.</p>
        )}
        {typeOf(entry) === 'capacites' && <ChoixDeCapacite entry={entry} entries={entries} />}
        {typeOf(entry) === 'races' && <MagiesDeRace entry={entry} entries={entries} />}
        {typeOf(entry) === 'magies' && <RacesDeMagie entry={entry} entries={entries} />}

        {texteModifiable ? (
          <div class="prose" data-ed-corps={entry.id} data-ed-morceau>{Content && <Content />}</div>
        ) : (
          <div class="prose">{Content && <Content />}</div>
        )}
      </>
    )
  }

  {/* plus de sources sous une page (réponse du propriétaire du 2026-10-22) : seulement sur /archives/ */}
  <PiedDePage entry={entry} />
</Base>
