---
import Base from '../layouts/Base.astro';
import rechercheCss from '../styles/recherche/recherche.css?raw';
import { url } from '../lib/wiki';
import { indexDeRecherche } from '../lib/recherche-index';
import { comptesDesMotsCles, PARAMETRE_MOT_CLE, TAILLE_DE_PAGE_DE_LA_RECHERCHE } from '../lib/recherche-mots-cles.mjs';
import { htmlDeLaDefinition, htmlDeLaPastille } from '../lib/mots-cles-balises.mjs';
import { chargerVocabulaire } from '../lib/mots-cles-db.mjs';
import { ouvrirBase } from '../lib/donnees.mjs';

// Recherche (menu du profil, R319) : plus de barre de recherche dans l'en-tête, la recherche est cette page, mêlée aux mots-clés (demande du propriétaire).
// Sans recherche, tous les mots-clés ; en tapant, les mots-clés dont le libellé ou un synonyme correspond puis les pages et les événements trouvés (lib/search.mjs ; un
// événement de la chronologie se trouve par son texte et par les libellés de ses catégories : lib/recherche-index.ts).
// Les mots-clés sont le glossaire de la base (table mot_cle, migrations 0043 et 0056 ; demande du propriétaire du 2026-10-16 : « Le mot-clé devra désormais
// servir un peu comme un glossaire ») : TOUS, même ceux qu'aucune page ne porte, chacun avec le nombre de pages visibles qui le portent ou le citent (pages
// du wiki et événements de l'index : étiquettes et balises, lib/recherche-index.ts), et l'infobulle de sa définition quand il en a une (data-bulle
// « mot-cle-<clé> » : le middleware pose la bulle, src/middleware.mjs). Les événements de la chronologie ont aussi des catégories, filtre de la frise
// (/chronologie/). Un mot-clé est un lien /recherche/?mot-cle=<clé> (sa clé, décision R232 (3) ; une clé qu'il a quittée y mène encore :
// lib/recherche-mots-cles.mjs#idDeLaCle) : le script de la page (src/scripts/recherche.mjs) y affiche son libellé,
// sa définition, puis les pages qui le portent ou le citent (demande du propriétaire : « cliquer sur un mot clé lance une recherche sur ce mot clé et
// liste les éléments qui ont ce mot clé ») ; les pastilles des pages du wiki y mènent, et les anciennes adresses /tags/<clé>/ aussi (page 404,
// lib/nav.mjs#nouvelleAdresse).
// Le vocabulaire se modifie sur le Glossaire (/regles/glossaire/, en mode modification sur le site de dev : src/scripts/edition/mots-cles.mjs ; réponses
// du propriétaire du 2026-11-06) : cette page ne fait plus que chercher, et liste toujours les mots-clés ; leurs pastilles mènent toujours à la liste de
// leurs pages (?mot-cle=<clé>), jamais à l'adresse du mot-clé (réponse Q12). CSS : styles/recherche/, inséré ici (?raw). Aucun id de la page ne commence
// par « mot-cle- » : c'est celui des bulles du glossaire (« mot-cle-<clé> », lib/mots-cles-balises.mjs#idDeBulle).
// Décision R309 (docs/chantier-ancrage-mots-cles.md §8, §9) : la liste ne garde dans son HTML que les définitions ÉCRITES (le texte de l'élément d'un
// mot-clé ancré arrive avec la vue : /search-elements.json, src/pages/search-elements.json.ts) ; seule la première page de 100 pastilles est
// visible, les suivantes portent `hidden` (le script de la page les pagine ; sans JavaScript, le <noscript> les redonne). La vue d'un mot-clé montre son
// élément (#vue-du-mot-cle-element) avant ses pages.
const index = await indexDeRecherche();
const comptes = comptesDesMotsCles(index);
// La pastille d'un mot-clé montre son libellé seul (décision R233 (9) : « Armure magique · 3 » ; une monnaie : « Ricken d’or » et son icône, R63 ;
// lib/mots-cles-balises.mjs#htmlDeLaPastille), et la recherche le trouve aussi par ses synonymes (R233 (1), data-synonymes ; l'ancienne abréviation en
// est un). La définition de chaque mot-clé décrit est rendue ici, monnaies en icônes (R63) et balises rendues par le middleware
// (#definitions-des-mots-cles, [data-definition-de] : htmlDeLaDefinition, par l'id du mot-clé) : la vue d'un mot-clé la recopie, son script ne lit aucune
// monnaie (il n'importe pas lib/monnaies.mjs : skill site-version-portable).
const json = (liste) => (liste?.length ? JSON.stringify(liste) : undefined);
const motsCles = chargerVocabulaire(ouvrirBase()).map((m) => ({
  id: m.id, libelle: m.libelle, cle: m.cle, icone: m.icone ?? null, synonymes: json(m.synonymes), anciennes: json(m.anciennes_cles),
  definition: m.description, n: comptes.get(m.id) ?? 0,
}));
// sans JavaScript, tout s'affiche : les pastilles d'après la première page (`hidden`) sont rendues, et la navigation, que le script crée, n'existe pas
// (« html » en tête : la feuille de la page, plus bas dans le document, a la même règle `display: none` ; celle-ci doit l'emporter)
const sansScript = 'html .recherche-mots-cles .tags li[hidden] { display: list-item; }';
const lienDuMotCle = `${url('recherche/')}?${PARAMETRE_MOT_CLE}=`;
---

<Base title="Recherche" description="Rechercher dans le site : les pages, les événements de la chronologie et le glossaire des mots-clés">
  <style is:inline set:html={rechercheCss}></style>
  <noscript slot="tete"><style is:inline set:html={sansScript}></style></noscript>
  <div class="recherche" data-recherche data-lien-mot-cle={lienDuMotCle}>
    <h1>Recherche</h1>
    <form id="search-form" action={url('recherche/')} data-index-url={url('search-index.json')} data-elements-url={url('search-elements.json')} data-base={url()} data-suffix="" role="search">
      <input id="q" type="search" name="q" placeholder="Nom, mot-clé, texte…" aria-label="Rechercher dans le site" autocomplete="off" autofocus />
      <button type="submit">Chercher</button>
    </form>
    <noscript><p class="banner">La recherche et la liste des pages d’un mot-clé demandent JavaScript. Sans lui, voyez l’<a href={url('pages/')}>index de toutes les pages</a>.</p></noscript>
    <p id="status" class="muted" aria-live="polite"></p>

    <section class="recherche-mots-cles" id="mots-cles" aria-labelledby="titre-mots-cles">
      <h2 id="titre-mots-cles">Mots-clés <small id="nombre-mots-cles" class="muted">({motsCles.length})</small></h2>
      <ul class="tags" id="liste-mots-cles">
        {
          motsCles.map((m, i) => (
            <li data-id={m.id} data-cle={m.cle} data-n={m.n} data-libelle={m.libelle} data-synonymes={m.synonymes} data-anciennes-cles={m.anciennes} data-definition={m.definition || undefined} hidden={i >= TAILLE_DE_PAGE_DE_LA_RECHERCHE}>
              <a class="badge" href={`${lienDuMotCle}${encodeURIComponent(m.cle)}`} data-bulle={m.definition ? `mot-cle-${m.cle}` : undefined}
                aria-describedby={m.definition ? `mot-cle-${m.cle}` : undefined} set:html={htmlDeLaPastille(m)} />
            </li>
          ))
        }
      </ul>
      <p id="aucun-mot-cle" class="muted" hidden>Aucun mot-clé ne correspond.</p>
    </section>

    <section class="recherche-mot-cle" id="vue-du-mot-cle" aria-labelledby="titre-mot-cle" hidden>
      <p class="muted"><a id="tous-les-mots-cles" href={url('recherche/')}>Tous les mots-clés</a></p>
      <h2 id="titre-mot-cle"></h2>
      <p id="vue-du-mot-cle-definition" class="recherche-definition" hidden></p>
      <div id="vue-du-mot-cle-element" class="recherche-element" hidden>
        <h3 id="titre-element">Élément</h3>
        <ul id="vue-du-mot-cle-element-liste" class="entry-list"></ul>
      </div>
      <p id="vue-du-mot-cle-compte" class="muted"></p>
      <ul id="vue-du-mot-cle-pages" class="entry-list" hidden></ul>
      <div id="definitions-des-mots-cles" hidden>
        {motsCles.filter((m) => m.definition).map((m) => <div data-definition-de={m.id} set:html={htmlDeLaDefinition(m.definition)} />)}
      </div>
    </section>

    <section class="recherche-pages" id="pages-trouvees" aria-labelledby="titre-pages" hidden>
      <h2 id="titre-pages">Pages</h2>
      <ul id="results" class="entry-list"></ul>
    </section>

    <p class="muted recherche-voir-aussi">Voir aussi le <a href={url('regles/glossaire/')}>glossaire</a>, l’<a href={url('pages/')}>index alphabétique de toutes les pages</a> et la <a href={url('donnees/')}>base de données</a>.</p>
  </div>
</Base>

<script>
  import '../scripts/recherche.mjs';
</script>
