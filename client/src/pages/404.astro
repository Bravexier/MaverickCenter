---
import Base from '../layouts/Base.astro';
import { url } from '../lib/wiki';
---

<Base title="Page introuvable" edition="404">
  <h1>Page introuvable</h1>
  <p id="introuvable" data-base={url()}>Cette page n’existe pas (ou plus). Essayez la <a href={url('recherche/')}>recherche</a> ou l’<a href={url('pages/')}>index du wiki</a>.</p>
</Base>

<script>
  import { nouvelleAdresse } from '../lib/nav.mjs';

  // Anciennes adresses (/wiki/…, liens enregistrés avant la suppression du préfixe ; /generateur/, devenu /fiche/) : renvoi vers la nouvelle adresse.
  const base = document.querySelector<HTMLElement>('#introuvable')!.dataset.base!;
  const target = nouvelleAdresse(location.pathname, base);
  if (target) location.replace(target + location.search + location.hash);
</script>
