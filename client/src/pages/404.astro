---
import Base from '../layouts/Base.astro';
import { url } from '../lib/wiki';
---

<Base title="Page introuvable" edition="404">
  <h1>Page introuvable</h1>
  <p id="introuvable" data-base={url()}>Cette page n’existe pas (ou plus). Essayez la <a href={url('recherche/')}>recherche</a> ou l’<a href={url('pages/')}>index du wiki</a>.</p>
</Base>

<script>
  import { adresseComplete, nouvelleAdresse } from '../lib/nav.mjs';

  // Anciennes adresses (/wiki/…, liens enregistrés avant la suppression du préfixe ; /generateur/, devenu /fiche/ ; /tags/<clé>/, devenu
  // /recherche/?mot-cle=<clé>) : renvoi vers la nouvelle adresse, la requête d'origine fusionnée avec la sienne (adresseComplete : jamais deux « ? »).
  const base = document.querySelector<HTMLElement>('#introuvable')!.dataset.base!;
  const target = nouvelleAdresse(location.pathname, base);
  // jamais hors du site, quelle que soit l'adresse demandée
  const cible = target ? new URL(adresseComplete(target, location.search, location.hash), location.href) : null;
  if (cible && cible.origin === location.origin) location.replace(cible.href);
</script>
