---
import Base from '../../layouts/Base.astro';
import { loadWiki, url } from '../../lib/wiki';

const { tags } = await loadWiki();
const sorted = [...tags.entries()].sort(([, a], [, b]) => a.label.localeCompare(b.label, 'fr'));
---

<Base title="Mots-clés">
  <h1>Mots-clés</h1>
  {
    sorted.length ? (
      <ul class="tags">
        {sorted.map(([key, tag]) => <li><a class="badge" href={url(`tags/${key}/`)}>{tag.label} ({tag.entries.length})</a></li>)}
      </ul>
    ) : (
      <p>Aucun mot-clé pour l’instant : ajoutez <code>tags: [...]</code> dans l’en-tête d’une page.</p>
    )
  }
</Base>
