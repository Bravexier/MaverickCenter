---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { loadWiki, url } from '../../lib/wiki';

export async function getStaticPaths() {
  const { tags } = await loadWiki();
  return [...tags.entries()].map(([key, tag]) => ({ params: { tag: key }, props: { tag } }));
}

const { tag } = Astro.props;
---

<Base title={`Mot-clé : ${tag.label}`}>
  <p class="muted"><a href={url('recherche/#mots-cles')}>Mots-clés</a> ›</p>
  <h1>{tag.label}</h1>
  <EntryList entries={tag.entries} />
</Base>
