---
// Le compte du visiteur, à droite de l'en-tête (R310 : connexion par Discord ; R319 (1) : le menu du profil) : le menu (components/MenuDuProfil.astro) et le script du
// compte, src/scripts/compte.mjs (qui importe lib/compte.mjs, seul), qui demande UN `GET /api/moi/` et le remplit. Posé par layouts/Base.astro, jamais dans la version
// portable (pas de service : elle ne pose que MenuDuProfil, avec `portable`) ni sur la page de maintenance (en-tête inerte). Le même script remplit aussi les pages
// /profil/ et /connexion/ (jamais deux scripts de page sur le même module : skill site-version-portable).
import MenuDuProfil from './MenuDuProfil.astro';

interface Props {
  prod?: boolean;
  dev?: boolean;
  ici?: string;
}
const { prod = false, dev = true, ici } = Astro.props;
---
<MenuDuProfil prod={prod} dev={dev} ici={ici} />
<script>
  import '../scripts/compte.mjs';
</script>
