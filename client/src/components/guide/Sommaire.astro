---
import { htmlAvecMonnaies } from '../../lib/monnaies.mjs';
import { cssDesParties } from '../../lib/palette-css.mjs';

// Un sommaire (lib/livres.mjs : Les bases, Règles avancées, Guide du MJ, Artisanat) : des groupes, chacun son titre (un libellé de navigation), son ancre
// et, pour Les bases, sa couleur (`classe` : la classe de sa partie, lib/palette-css.mjs#classeDePartie ; un filet à gauche du titre du groupe, la
// feuille des parties émise ici quand un groupe en pose une), puis une ligne par page, son titre lié et son résumé (le `summary` de la page, tel que la
// base l'écrit ; rien si elle n'en a pas), comme l'index du wiki (components/EntryList.astro). Aucun autre texte.
interface Element {
  href: string;
  titre: string;
  resume?: string | null;
}
interface Props {
  groupes: { id?: string; titre?: string; classe?: string | null; elements: Element[] }[];
}
const { groupes } = Astro.props;
const enCouleur = groupes.some((g) => g.classe);
---

{enCouleur && <style is:inline set:html={cssDesParties()}></style>}

{
  groupes.map((g) => (
    <section
      class:list={['sommaire', g.classe && ['sommaire--couleur', g.classe]]}
      id={g.id}
      aria-labelledby={g.id && g.titre ? `${g.id}-titre` : undefined}
    >
      {g.titre && <h2 id={g.id ? `${g.id}-titre` : undefined}>{g.titre}</h2>}
      <ul class="entry-list">
        {g.elements.map((e) => (
          <li>
            <a href={e.href}>{e.titre}</a>
            {e.resume && <div class="muted" set:html={htmlAvecMonnaies(e.resume)} />}
          </li>
        ))}
      </ul>
    </section>
  ))
}
