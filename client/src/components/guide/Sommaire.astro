---
import { htmlAvecMonnaies } from '../../lib/monnaies.mjs';

// Un sommaire (lib/livres.mjs : Règles avancées, Guide du MJ, Artisanat) : des groupes, chacun son titre (un libellé de navigation) et son ancre,
// puis une ligne par page, son titre lié et son résumé (le `summary` de la page, tel que la base l'écrit ; rien si elle n'en a pas), comme l'index du
// wiki (components/EntryList.astro). Aucun autre texte.
interface Element {
  href: string;
  titre: string;
  resume?: string | null;
}
interface Props {
  groupes: { id?: string; titre?: string; elements: Element[] }[];
}
const { groupes } = Astro.props;
---

{
  groupes.map((g) => (
    <section class="sommaire" id={g.id} aria-labelledby={g.id && g.titre ? `${g.id}-titre` : undefined}>
      {g.titre && <h2 id={g.id ? `${g.id}-titre` : undefined}>{g.titre}</h2>}
      <ul class="entry-list">
        {g.elements.map((e) => (
          <li>
            <a href={e.href}>{e.titre}</a>
            {e.resume && <div class="muted" set:html={htmlAvecMonnaies(e.resume)} />}
          </li>
        ))}
      </ul>
    </section>
  ))
}
