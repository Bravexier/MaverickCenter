---
import blocsCss from '../../styles/guide/blocs.css?raw';
import ongletsCss from '../../styles/guide/onglets.css?raw';
import magieTooltipsCss from '../../styles/magie/tooltips.css?raw';
import Onglets from '../Onglets.astro';
import PiedDePage from '../PiedDePage.astro';
import GuideBloc from './GuideBloc.astro';
import { morceauxDuChapitre } from '../../lib/guide.mjs';
import { dansLOrdre, decouperEnOnglets, panneauRendu } from '../../lib/guide-onglets.mjs';
import { ALIGNEMENTS_EN_GRILLE } from '../../lib/caracteristiques-postures.mjs';
import { estDuGuideDuMj, filDAriane, partieDeLaPage, RUBRIQUES_SOUS_LA_PAGE } from '../../lib/livres.mjs';
import { classeDAlignement, classeDePartie, cssDesAlignements, cssDesParties, idDeCouleur } from '../../lib/palette-css.mjs';
import { classeDeLaPageDuSite } from '../../lib/couleur-de-la-page.mjs';
import { rendreMarkdown } from '../../lib/guide-rendu';
import { attributEd } from '../../lib/edition-modele.mjs';
import { cheminDePage } from '../../lib/metiers.mjs';
import { TYPES } from '../../lib/types.mjs';
import { url, type WikiEntry } from '../../lib/wiki';

// Une page du guide, quelle qu'elle soit (lib/livres.mjs : Découvrir, les onglets des Règles, Guide du MJ) : une page simple, comme une page du wiki
// (demande du propriétaire du 2026-10-18 : « Retirer le mécanisme de swipe, et les flèches suivant / précédent et la pagination »). Fil d'Ariane vers sa
// rubrique ou son sommaire (lib/livres.mjs#filDAriane), titre, texte coupé à ses blocs tirés de la base (GuideBloc : le tableau de la
// montée de niveau, les postures, les personnages fil rouge…), sous L'univers les rubriques qu'elle présente (RUBRIQUES_SOUS_LA_PAGE), puis mots-clés
// (PiedDePage ; plus de rétroliens sur aucune page : « Supprime ces colonnes de toutes les pages. Elles polluent l'affichage pour rien. », 2026-11-05).
// Les liens Discord et Tipeee et l'encart « Notre prochaine rencontre IRL », sous le texte de Bienvenue jusqu'au 2026-10-23, sont sur l'accueil
// (components/accueil/LiensEtRencontre.astro ; « Ces 3 blocs auraient plus leur place dans l'onglet d'acceuil. »). Aucune page
// ne cite ses sources sous le texte (réponse du propriétaire du 2026-10-22 : « Plus de sources ailleurs que dans les archives. ») : `sources:` reste
// dans le frontmatter, /archives/ le lit. Une page de Découvrir ou de la création du personnage (l'introduction et ses six étapes) prend la couleur
// de sa partie (partieDeLaPage, classeDePartie : `.couleur-partie-<id>`, lib/palette-css.mjs, dont la page émet la feuille ; filet du titre,
// intertitres, blocs) ; les autres pages des onglets des Règles gardent l'accent du site (réponse du propriétaire du 2026-11-05 : « Accent du site » ;
// leur menu latéral : MenuLateral.astro), comme le Guide du MJ ; seules celles du Guide du MJ ont en plus leur badge « Guide ». Chaque morceau de texte
// est modifiable sur le site de dev (data-ed-morceau ; src/scripts/edition/guide.mjs), comme le titre (data-ed).
interface Props {
  entry: WikiEntry;
  entries: WikiEntry[];
  modifiable: boolean;
}
const { entry, entries, modifiable } = Astro.props;
const fil = filDAriane(entry.id);
const ici = cheminDePage(entry.id);
// la couleur du mot-clé coloré qui mène à la page d'abord (réponse Q5 du propriétaire, migration 0098 : lib/couleur-de-la-page.mjs), sinon celle de sa partie
const couleur = classeDeLaPageDuSite(url(ici), classeDePartie(partieDeLaPage(entry.id)), { base: import.meta.env.BASE_URL });
// Badge « Guide » et ligne « Aussi appelé » : seulement dans le Guide du MJ, ni dans Découvrir ni dans les onglets des Règles (réponse du propriétaire
// du 2026-11-05 : « Retirer, comme Les bases » ; « Les deux rubriques ont la même présentation : le titre, puis le texte, sans badge « Guide » ni ligne
// « Aussi appelé ». »).
const reference = estDuGuideDuMj(entry.id);
// Les neuf alignements de « Alignement » en onglets, un par intertitre `###` dont l'ancre figée est celle d'un alignement de la palette (lib/guide-onglets.mjs :
// jamais son texte, qui se renomme sur le site de dev), chacun dans la classe de sa couleur (`couleur-alignement-<id>`, lib/palette-css.mjs) : demande du
// propriétaire, « Liste les 9 allignements sous forme de tableau (ou de tuile) à onglet ou chaque onglet a la couleur de l'alignement ».
// La barre suit la grille des alignements (ALIGNEMENTS_EN_GRILLE : « LB NB CB / LN N CN / LM NM CM »), les panneaux l'ordre du texte ; le premier de la barre
// est ouvert.
const classesDesOnglets = new Map(ALIGNEMENTS_EN_GRILLE.map((nom) => [idDeCouleur(nom), classeDAlignement(nom)]));
const rendre = async (markdown: string) => (markdown.trim() ? rendreMarkdown(markdown, entry.id, entry.data.status) : '');
const morceaux: any[] = await Promise.all(
  morceauxDuChapitre(entry.body ?? '').map(async (m: any) => {
    if ('bloc' in m) return m;
    const decoupe = decouperEnOnglets(m.markdown, new Set(classesDesOnglets.keys()));
    if (!decoupe) return { html: await rendre(m.markdown) };
    const premier = dansLOrdre(decoupe.panneaux, classesDesOnglets.keys())[0].ancre;
    const panneaux = await Promise.all(
      decoupe.panneaux.map(async (p: any) => ({ ...panneauRendu(await rendre(p.markdown), p.ancre), ancre: p.ancre, classe: classesDesOnglets.get(p.ancre), actif: p.ancre === premier })),
    );
    const barre = dansLOrdre(panneaux, classesDesOnglets.keys());
    return { onglets: { avant: await rendre(decoupe.avant), panneaux, barre, apres: await rendre(decoupe.apres), etiquette: decoupe.etiquette } };
  }),
);
const avecOnglets = morceaux.some((m) => 'onglets' in m);
const rubriques = (RUBRIQUES_SOUS_LA_PAGE as Record<string, readonly string[]>)[entry.id] ?? [];
// Seules les pages d'exemple ont un bandeau (comme pages/[type]/[slug].astro).
const statusNote = entry.data.status === 'example' ? 'Contenu d’exemple : à remplacer par le contenu réel du codex.' : '';
const css = [blocsCss, magieTooltipsCss, ...(avecOnglets ? [ongletsCss] : [])].join('\n');
---

<style is:inline set:html={css}></style>
{/* la feuille des parties du guide (une famille d'une zone de la palette) : seulement sur une page qui en pose la classe (une autre couleur, celle d'un
    mot-clé : dans la feuille des mots-clés colorés, layouts/Base.astro) */}
{couleur?.startsWith('couleur-partie-') && <style is:inline set:html={cssDesParties()}></style>}
{/* les onglets : le script partagé, posé une fois (skill ui-onglets), et la feuille des alignements (une famille d'une zone de la palette) */}
{avecOnglets && <Onglets />}
{avecOnglets && <style is:inline set:html={cssDesAlignements()}></style>}
<div class:list={['guide-reference', couleur && ['guide-reference--couleur', couleur]]}>
  <p class="muted guide-fil">
    <a href={url()}>Accueil</a>{
      fil.map((m) => (
        <>
          {' › '}
          <a href={url(m.chemin)} aria-current={m.chemin === ici ? 'page' : undefined}>{m.titre}</a>
        </>
      ))
    }
  </p>
  <h1 id="guide-titre">
    {modifiable ? <span data-ed={attributEd('page', { id: entry.id }, 'titre')}>{entry.data.title}</span> : entry.data.title}
    {reference && <>{' '}<span class="badge">{TYPES.guide.singular}</span></>}
  </h1>
  {entry.data.aliases.length > 0 && reference && <p class="muted">Aussi appelé : {entry.data.aliases.join(', ')}</p>}
  {statusNote && <p class="banner" role="note">{statusNote}</p>}
  {/* data-ed-corps, data-ed-morceau : morceaux de texte modifiables sur le site de dev (src/scripts/edition/guide.mjs) */}
  <div class="guide-corps" data-ed-corps={modifiable ? entry.id : undefined}>
    {
      morceaux.map((m) =>
        'bloc' in m ? (
          <GuideBloc bloc={m.bloc} entry={entry} entries={entries} />
        ) : 'onglets' in m ? (
          // un morceau de texte, avec sa barre d'onglets au milieu : la barre est ignorée de l'éditeur (data-ed-ignorer), le groupe et les panneaux sont
          // transparents (lib/markdown-edition.mjs#versMarkdown) — le Markdown relu est celui de la page
          <div class="prose" data-ed-morceau={modifiable ? '' : undefined}>
            <Fragment set:html={m.onglets.avant} />
            <div class="onglets-guide" data-onglets>
              <nav class="onglets-guide__liste" aria-labelledby={m.onglets.etiquette ?? undefined} data-ed-ignorer contenteditable="false">
                {m.onglets.barre.map((p: any) => (
                  <a class:list={['onglet', 'onglets-guide__onglet', p.classe, p.actif && 'is-active']} id={`onglet-${p.ancre}`} href={`#${p.ancre}`} set:html={p.titre} />
                ))}
              </nav>
              {m.onglets.panneaux.map((p: any) => (
                <section class:list={['onglets-guide__panneau', p.classe, p.actif && 'is-active']} id={p.ancre} set:html={p.html} />
              ))}
            </div>
            <Fragment set:html={m.onglets.apres} />
          </div>
        ) : (
          <div class="prose" data-ed-morceau={modifiable ? '' : undefined} set:html={m.html} />
        ),
      )
    }
  </div>
  {
    rubriques.length > 0 && (
      <nav class="guide-rubriques" aria-label="Rubriques">
        <ul>
          {rubriques.map((cle) => (
            <li><a class="guide-rubriques__lien" href={url(`${cle}/`)}>{TYPES[cle as keyof typeof TYPES].label}</a></li>
          ))}
        </ul>
      </nav>
    )
  }
</div>

<PiedDePage entry={entry} />
