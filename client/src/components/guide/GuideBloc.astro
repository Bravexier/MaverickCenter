---
import { ouvrirBase } from '../../lib/donnees.mjs';
import { pagesDeReference } from '../../lib/guide.mjs';
import {
  chargerCompetences,
  chargerEntrainement,
  chargerInitiative,
  chargerMagiesDuGuide,
  chargerNiveaux,
  chargerPostures,
  chargerTypesDeDon,
} from '../../lib/guide-db.mjs';
import { rendreLigne } from '../../lib/guide-rendu';
import { idBulle, pageHref } from '../../lib/magies';
import { couleurDeMagie } from '../../lib/sort-format.mjs';
import type { WikiEntry } from '../../lib/wiki';

// Un bloc d'un chapitre du guide (`<!-- guide:<bloc> -->`, lib/guide.mjs#BLOCS), tiré de la base : rien n'y est écrit à la main, la base le tient à jour.
interface Props {
  bloc: string;
  entry: WikiEntry;
  entries: WikiEntry[];
  chapitres: { id: string; numero: number; titre: string; resume: string }[];
}
const { bloc, entry, entries, chapitres } = Astro.props;
const db = ouvrirBase();

const niveaux = bloc === 'niveaux' ? chargerNiveaux(db) : [];
const postures = bloc === 'postures' ? chargerPostures(db) : [];
const magies = bloc === 'magies' || bloc === 'magie-bonus' ? chargerMagiesDuGuide(db) : [];
const initiative = bloc === 'initiative' ? chargerInitiative(db) : [];
const entrainement = bloc === 'entrainement' ? chargerEntrainement(db) : [];
const typesDeDon = bloc === 'types-de-don' ? chargerTypesDeDon(db) : [];
const competences =
  bloc === 'competences'
    ? await Promise.all(
        chargerCompetences(db).map(async (c) => ({
          ...c,
          competences: await Promise.all(c.competences.map(async (k) => ({ ...k, html: k.description ? await rendreLigne(k.description, entry.id) : '' }))),
        })),
      )
    : [];
const references = bloc === 'documents' ? pagesDeReference(entries) : [];
const nombre = (n: number) => n.toLocaleString('fr-FR');
---

{
  bloc === 'sommaire' && (
    <ol class="guide-sommaire">
      {chapitres
        .filter((c) => c.id !== entry.id)
        .map((c) => (
          <li>
            <a class="guide-sommaire__lien" href={pageHref(c.id)}>
              <span class="guide-sommaire__numero" aria-hidden="true">{c.numero}</span>
              <span class="guide-sommaire__titre">{c.titre}</span>
            </a>
            <span class="guide-sommaire__resume">{c.resume}</span>
          </li>
        ))}
    </ol>
  )
}

{
  bloc === 'magies' && (
    <ul class="guide-magies" aria-label="Les 15 magies et leur dieu">
      {magies.map((m) => (
        <li style={`--couleur-magie: ${couleurDeMagie(m.nom)}`}>
          <a class="guide-magie" href={pageHref(m.id)}>
            <span class="guide-magie__point" aria-hidden="true" />
            <span class="guide-magie__nom">{m.nom}</span>
          </a>
          {m.dieux.length > 0 && <span class="guide-magie__dieu">{m.dieux.join(' & ')}</span>}
        </li>
      ))}
    </ul>
  )
}

{
  bloc === 'magie-bonus' && (
    <div class="guide-defile" tabindex="0" role="region" aria-label="Ce que donne chaque magie">
      <table class="guide-table">
        <thead>
          <tr>
            <th scope="col">Magie</th>
            <th scope="col">+1 en caractéristique (magie innée)</th>
            <th scope="col">Chakra offert</th>
            <th scope="col">Santé offerte</th>
          </tr>
        </thead>
        <tbody>
          {magies.map((m) => (
            <tr style={`--couleur-magie: ${couleurDeMagie(m.nom)}`}>
              <th scope="row">
                <a class="guide-magie guide-magie--ligne" href={pageHref(m.id)}>
                  <span class="guide-magie__point" aria-hidden="true" />
                  <span class="guide-magie__nom">{m.nom}</span>
                </a>
              </th>
              <td>{m.caracteristique ?? '—'}</td>
              <td class="guide-nombre">{m.chakra ?? '—'}</td>
              <td class="guide-nombre">{m.sante ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  bloc === 'initiative' && (
    <div class="guide-defile" tabindex="0" role="region" aria-label="Initiative selon l’Agilité">
      <table class="guide-table guide-table--compacte">
        <thead>
          <tr>
            <th scope="row">Agilité</th>
            {initiative.map((i) => <th scope="col">{i.agilite}{i.note && <sup>*</sup>}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Initiative</th>
            {initiative.map((i) => <td class="guide-nombre">{i.bonus_brut.replace(/ initiative$/, '')}</td>)}
          </tr>
        </tbody>
      </table>
      {initiative.filter((i) => i.note).map((i) => <p class="guide-note"><sup>*</sup> {i.agilite} en Agilité : {i.note.charAt(0).toLowerCase() + i.note.slice(1)}.</p>)}
    </div>
  )
}

{
  bloc === 'competences' && (
    <div class="guide-competences">
      {competences.map((c) => (
        <section class="guide-competences__groupe" aria-labelledby={`competences-${c.id}`}>
          <h4 id={`competences-${c.id}`}>
            {c.nom} <span class="guide-lettre">({c.lettre})</span>
          </h4>
          <ul>
            {c.competences.map((k) => (
              <li>
                <strong>{k.nom}</strong>
                {k.html && <> — <Fragment set:html={k.html} /></>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}

{
  bloc === 'niveaux' && (
    <div class="guide-defile" tabindex="0" role="region" aria-label="Tableau de la montée de niveau">
      <table class="guide-table guide-table--niveaux">
        <thead>
          <tr>
            <th scope="col">Niveau</th>
            <th scope="col">XP nécessaire</th>
            <th scope="col">Points de compétences</th>
            <th scope="col">Points d’attributs</th>
            <th scope="col">Niveaux de classe</th>
            <th scope="col">Niveau de maîtrise d’un sort</th>
            <th scope="col">Et aussi</th>
          </tr>
        </thead>
        <tbody>
          {niveaux.map((n) => (
            <tr>
              <th scope="row">{n.niveau}</th>
              <td class="guide-nombre">{nombre(n.xp)}</td>
              <td class="guide-nombre">{n.competences ?? '—'}</td>
              <td class="guide-nombre">{n.attributs ?? '—'}</td>
              <td class="guide-nombre">{n.classe ? `+${n.classe}` : '—'}</td>
              <td class="guide-nombre">{n.maitrise ? `+${n.maitrise}` : '—'}</td>
              <td>{n.autres.length > 0 ? <ul class="guide-gains">{n.autres.map((a) => <li>{a}</li>)}</ul> : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  bloc === 'types-de-don' && (
    <dl class="guide-definitions">
      {typesDeDon.map((t) => (
        <>
          <dt>{t.nom}</dt>
          <dd>{t.definition}</dd>
        </>
      ))}
    </dl>
  )
}

{
  bloc === 'entrainement' && (
    <div class="guide-defile" tabindex="0" role="region" aria-label="Jet d’entraînement">
      <table class="guide-table guide-table--compacte">
        <thead>
          <tr>
            <th scope="col">Résultat du D100</th>
            <th scope="col">Bonus obtenu</th>
          </tr>
        </thead>
        <tbody>
          {entrainement.map((e) => (
            <tr class={e.rate ? 'guide-rate' : undefined}>
              <td class="guide-nombre">{e.valeur_brut}</td>
              <td>{e.resultat_brut}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  bloc === 'postures' && (
    <div class="guide-postures">
      {postures.map((p) => {
        const id = idBulle('posture');
        return (
          <section class="guide-posture" aria-labelledby={`${id}-titre`}>
            <h3 id={`${id}-titre`}>
              <span class="bulle-zone">
                <button type="button" class="guide-posture__nom" data-bulle={id} aria-describedby={id} title={p.description}>
                  {p.nom}
                </button>
                <span class="bulle" role="tooltip" id={id} hidden>
                  {p.description}
                </span>
              </span>
            </h3>
            <ul>{p.effets.map((e) => <li>{e}</li>)}</ul>
          </section>
        );
      })}
    </div>
  )
}

{
  bloc === 'documents' && (
    <div class="guide-references">
      {references.map((g) => (
        <section class="guide-references__groupe">
          <h3>
            {g.document} {g.genre && <span class="guide-lettre">(Google {g.genre})</span>}
          </h3>
          <ul>
            {g.pages.map((p) => (
              <li>
                <a href={pageHref(p.id)}>{p.titre}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}
