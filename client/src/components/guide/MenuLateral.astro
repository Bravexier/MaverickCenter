---
import menuLateralCss from '../../styles/guide/menu-lateral.css?raw';
import { entryHref, url, type WikiEntry } from '../../lib/wiki';

// Le menu latéral d'une rubrique lue page à page, sur le modèle de la chronologie : les onglets des Règles (/regles/<onglet>/ et /regles/<slug>/, R184),
// où le posent PageDuPlan.astro (onglet et entrées tirés du plan, lib/livres.mjs#menuLateralDe) et pages/regles/artisanat.astro (l'onglet Exploration,
// dont l'Artisanat est une entrée lien), et les pages de race (/races/<race>/), où le pose components/race/MenuDesRaces.astro (la demande et les
// réponses du propriétaire y sont citées).
//   - Le modèle : demande du propriétaire du 2026-11-05 pour Les bases (« Au lieu de lister les différentes pages, réécrit directement le contenu.
//     […] Pour la présation je préfèrera un menu latéral sous le même modèle que la chronologie. » ; réponse « Comme la chronologie (Recommandé) »),
//     repris par les Règles avancées (« Liste sans groupes »), puis par chaque onglet des Règles (R184 : un menu latéral par onglet, sans groupes).
// À gauche, en vertical, le menu (une seule liste, dans l'ordre reçu, sans groupes) : une page par son titre (l'entrée affichée marquée,
// aria-current) ; un lien vers une autre adresse du site par son libellé (`{ libelle, adresse }` : l'Artisanat), marqué quand il mène à la page
// affichée (`entry.id` + « / » : pages/regles/artisanat.astro passe { id: 'regles/artisanat' }) ; une entrée « bientôt » (`{ bientot }` : une puce du
// propriétaire sans texte encore, R184 (1)) grisée, sans lien, comme celles du menu du site. À droite, la page choisie, que l'appelant passe en
// contenu (<slot /> : PageDuGuide pour le guide, fil d'Ariane et gabarit RacePage pour une race). Chaque page garde son adresse : le menu fait des
// liens ordinaires, tout se lit sans JavaScript. Pas de couleur de partie : l'accent du site (réponse du propriétaire : « Accent du site »). De la
// chronologie, la mise en page et le comportement seulement : ni barre en dégradé, ni dates, ni chevrons.
// Petit écran (<= 56rem, comme la chronologie) : le menu replié au-dessus de la page (un <details> : le titre de la rubrique et celui de la page
// affichée), un appui l'ouvre. Sans JavaScript il reste ouvert (attribut `open` du build) ; le script en ligne qui le suit le replie sur petit écran et
// le rouvre sur grand écran (il n'importe rien : aucun module partagé entre scripts de page, skill site-version-portable). Un seul menu par page.
// Mode modification du site de dev (lot de l'édition des menus ; demande du propriétaire : « changer l'ordre des menu latéraux (par un glisser
// déposer) », réponse « Règles + Races ») : `edition`, facultatif, pose sur la liste le menu qu'elle est (`data-ed-menu` : `onglet:<id>`, lib/livres.mjs
// #editionDuMenuLateral ; `races`, components/race/MenuDesRaces.astro) et, sur chaque entrée (même ordre que `pages`), l'id et le rang de sa ligne
// (`data-ed-entree`, `data-ed-rang` : regles_onglet_entree, ou la race et son rang_liste) et, pour les races, son groupe (`data-ed-groupe` : pures ou
// hybrides ; une race reste dans le sien). Le glisser-déposer, l'ajout et la suppression d'une page : src/scripts/edition/menus.mjs. Rien ne change
// à l'affichage.
type Entree = WikiEntry | { libelle: string; adresse: string } | { bientot: string };
type EntreeModifiable = { id: string | null; rang: number | null; groupe?: string };
interface Props {
  rubrique: { titre: string; chemin: string };
  pages: Entree[];
  entry: { id: string; data: { title: string } };
  edition?: { menu: string; entrees: EntreeModifiable[] };
}
const { rubrique, pages, entry, edition } = Astro.props;
/** Les attributs du mode modification de la i-ième entrée (aucun sans `edition`). */
const ed = (i: number) => {
  const e = edition?.entrees[i];
  return e ? { 'data-ed-entree': e.id ?? undefined, 'data-ed-rang': e.rang ?? undefined, 'data-ed-groupe': e.groupe } : {};
};
---

<style is:inline set:html={menuLateralCss}></style>
<div class="lateral">
  <nav class="lateral-menu" aria-label={rubrique.titre}>
    <details class="lateral-menu__repli" open data-lateral-repli>
      <summary class="lateral-menu__resume">
        <span class="lateral-menu__resume-rubrique">{rubrique.titre}</span>
        <span class="lateral-menu__resume-page">{entry.data.title}</span>
      </summary>
      <p class="lateral-menu__titre"><a href={url(rubrique.chemin)}>{rubrique.titre}</a></p>
      <ol class="lateral-menu__liste" data-ed-menu={edition?.menu}>
        {
          pages.map((p, i) =>
            'bientot' in p ? (
              <li {...ed(i)}><span class="lateral-menu__bientot nav-soon">{p.bientot} <small>(bientôt)</small></span></li>
            ) : 'adresse' in p ? (
              <li {...ed(i)}><a class="lateral-menu__lien" href={url(p.adresse)} aria-current={p.adresse === `${entry.id}/` ? 'page' : undefined}>{p.libelle}</a></li>
            ) : (
              <li {...ed(i)}><a class="lateral-menu__lien" href={entryHref(p)} aria-current={p.id === entry.id ? 'page' : undefined}>{p.data.title}</a></li>
            ),
          )
        }
      </ol>
    </details>
  </nav>
  <script is:inline>
    // Petit écran : le menu replié au premier affichage (la page d'abord), rouvert sur grand écran (une tablette tournée) ; sans JavaScript, ouvert.
    (function () {
      var repli = document.querySelector('[data-lateral-repli]');
      if (!repli) return;
      var petit = matchMedia('(max-width: 56rem)');
      function regler() { repli.open = !petit.matches; }
      regler();
      petit.addEventListener('change', regler);
    })();
  </script>
  <div class="lateral-page">
    <slot />
  </div>
</div>
