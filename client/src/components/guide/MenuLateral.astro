---
import menuLateralCss from '../../styles/guide/menu-lateral.css?raw';
import { entryHref, url, type WikiEntry } from '../../lib/wiki';

// Le menu latéral d'une rubrique lue page à page, sur le modèle de la chronologie : Les bases (/regles/ et /regles/<slug>/) et les Règles avancées
// (/regles/avancees/ et /regles/avancees/<slug>/), où le pose PageDuPlan.astro (rubrique et pages tirées du plan, lib/livres.mjs#menuLateralDe), et
// les pages de race (/races/<race>/), où le pose components/race/MenuDesRaces.astro (la demande et les réponses du propriétaire y sont citées).
//   - Les bases : demande du propriétaire du 2026-11-05 (« Au lieu de lister les différentes pages, réécrit directement le contenu. […] Inutile de
//     séparer les catégories les Jouer / Progresser / Pour aller plus loin. Pour la présation je préfèrera un menu latéral sous le même modèle que la
//     chronologie. » ; réponse « Comme la chronologie (Recommandé) »).
//   - Les Règles avancées : demande du propriétaire du 2026-11-05 (« Suite à la modification de la page "les bases" refait la même avec les "règles
//     avancées", tout sur la même page avec menu lattéral. » ; réponses « Liste sans groupes » — « Comme Les bases : une seule liste de titres, dans
//     l'ordre actuel des groupes. » — et « Le Mode Hyper » pour la page d'ouverture).
// À gauche, en vertical, le menu des pages (leurs titres, dans l'ordre reçu, sans groupes ; l'entrée affichée marquée, aria-current) ; à droite, la
// page choisie, que l'appelant passe en contenu (<slot /> : PageDuGuide pour le guide, fil d'Ariane et gabarit RacePage pour une race). Chaque page
// garde son adresse : le menu fait des liens ordinaires, tout se lit sans JavaScript. Pas de couleur de partie : l'accent du site (réponse du
// propriétaire : « Accent du site »). De la chronologie, la mise en page et le comportement seulement : ni barre en dégradé, ni dates, ni chevrons.
// Petit écran (<= 56rem, comme la chronologie) : le menu replié au-dessus de la page (un <details> : le titre de la rubrique et celui de la page
// affichée), un appui l'ouvre. Sans JavaScript il reste ouvert (attribut `open` du build) ; le script en ligne qui le suit le replie sur petit écran et
// le rouvre sur grand écran (il n'importe rien : aucun module partagé entre scripts de page, skill site-version-portable). Un seul menu par page.
interface Props {
  rubrique: { titre: string; chemin: string };
  pages: WikiEntry[];
  entry: WikiEntry;
}
const { rubrique, pages, entry } = Astro.props;
---

<style is:inline set:html={menuLateralCss}></style>
<div class="lateral">
  <nav class="lateral-menu" aria-label={rubrique.titre}>
    <details class="lateral-menu__repli" open data-lateral-repli>
      <summary class="lateral-menu__resume">
        <span class="lateral-menu__resume-rubrique">{rubrique.titre}</span>
        <span class="lateral-menu__resume-page">{entry.data.title}</span>
      </summary>
      <p class="lateral-menu__titre"><a href={url(rubrique.chemin)}>{rubrique.titre}</a></p>
      <ol class="lateral-menu__liste">
        {
          pages.map((p) => (
            <li>
              <a class="lateral-menu__lien" href={entryHref(p)} aria-current={p.id === entry.id ? 'page' : undefined}>{p.data.title}</a>
            </li>
          ))
        }
      </ol>
    </details>
  </nav>
  <script is:inline>
    // Petit écran : le menu replié au premier affichage (la page d'abord), rouvert sur grand écran (une tablette tournée) ; sans JavaScript, ouvert.
    (function () {
      var repli = document.querySelector('[data-lateral-repli]');
      if (!repli) return;
      var petit = matchMedia('(max-width: 56rem)');
      function regler() { repli.open = !petit.matches; }
      regler();
      petit.addEventListener('change', regler);
    })();
  </script>
  <div class="lateral-page">
    <slot />
  </div>
</div>
