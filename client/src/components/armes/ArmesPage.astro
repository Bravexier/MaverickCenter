---
import armesCss from '../../styles/armes/armes.css?raw';
import { attributEd } from '../../lib/edition-modele.mjs';
import { RENDUS } from '../../lib/edition-rendu.mjs';
import { ancreDeMateriau, type chargerArmes, type contexteDesArmes } from '../../lib/armes-db.mjs';
import { COMPETENCES_D_ARME } from '../../lib/arme-champs.mjs';
import { htmlDuFiltreDeCompetence } from '../../lib/armes-rendu.mjs';
import { htmlDePiece, MONNAIES_DU_JEU } from '../../lib/monnaies.mjs';
import Tableau from '../Tableau.astro';
import TableauArmes from './TableauArmes.astro';
import PanneauDeRegles from '../equipement/PanneauDeRegles.astro';
import type { PanneauRendu } from '../equipement/PanneauDeRegles.astro';

// Onglet « Armes » de la page /ressources/equipement/ (components/equipement/EquipementPage.astro ; demande du propriétaire, 2026-10-16 : « J'aimerai
// fusionner "Armes" et "Armures" dans un seule onglet : "Equipement" […] les "Armes" seront dans un onglet à part » ; avant, la page /ressources/armes/,
// dont l'adresse mène à l'onglet ; demande du propriétaire, 2026-10-13 : « refaire intégralement la présentation de l'onglet des armes », « Pas de tableau
// markdown, inspire-toi des sorts et fais un tableau par type d'arme ») : un panneau (`section.equipement-panneau#armes`, ouvert au départ), rendu
// depuis les tables de la base (lib/armes-db.mjs), jamais depuis le Markdown de la page « Armes ». Le panneau de règles de l'onglet en tête, replié
// (components/equipement/PanneauDeRegles.astro, migration 0056 ; texte du classeur avec sa mise en forme, et en tuiles Recharge longue, Recharge très
// longue, Mordhau, Dague, Arme de jet et le prix : demande du propriétaire, 2026-10-16) ; un filtre par compétence (Lourde, Légère, Arc, Arbalète, et
// « Arme de départ » : lib/armes-filtres.mjs) ; un tableau repliable par famille (TableauArmes.astro) ; à côté, toujours affiché et de la
// largeur de celui des armures (demande du propriétaire, 2026-10-16 : « Avoir l'endroit de l'arme en permanence visible comme c'est le cas pour
// l'armure, et avec la même largeur »), le panneau de l'arme : sa fiche (vide tant qu'aucune arme n'est choisie ; un seul cadre, réduit à trois tuiles,
// le détail de leur calcul dans leur infobulle, puis effets, description et origine) et, dessous, les matériaux (chaque ligne dans la couleur du
// matériau, ses effets sur une ligne) et les améliorations côte à côte : choisir un matériau et une amélioration ajuste les dégâts, la durabilité, les
// effets et le coût de la fiche (src/scripts/armes.mjs, calcul : lib/arme-forge.mjs). Sans JavaScript, tout est affiché (ni fiche ni filtre).
// Mode modification du site de dev : pas de sélection, la fiche est cachée, tous les tableaux sont visibles et leurs champs modifiables
// (src/scripts/edition/armes.mjs), sauf les matériaux : leur référence est la page « Composants » (décision R62), ils ne sont ici qu'en lecture. CSS : styles/armes/armes.css (?raw, inséré ici seulement).
type Armes = ReturnType<typeof chargerArmes>;
interface Props {
  armes: Armes;
  contexte: ReturnType<typeof contexteDesArmes>;
  /** le panneau de règles de l'onglet (`armes`), le Markdown de ses blocs rendu (src/pages/ressources/equipement.astro) */
  regles: PanneauRendu | null;
}
const { armes, contexte, regles } = Astro.props;
const edM = (id: string, colonne: string) => attributEd('materiau_arme', { ressource_id: id }, colonne);
const edA = (id: string, colonne: string) => attributEd('amelioration_equipement', { id }, colonne);
const nbArmes = armes.familles.reduce((n, f) => n + f.armes.length, 0);
// filtre par compétence (demande du propriétaire ; lib/armes-filtres.mjs) : un bouton par compétence d'arme, dans la couleur de sa caractéristique
// (décision R48), qui sert aussi de légende aux pastilles des tableaux
const FILTRES = Object.keys(COMPETENCES_D_ARME).map((id) => htmlDuFiltreDeCompetence(id, contexte));
---

<style is:inline set:html={armesCss}></style>
<script is:inline>
  document.documentElement.classList.add('js');
</script>
<section class="equipement-panneau is-active" id="armes" aria-labelledby="titre-armes">
<h2 class="equipement-panneau__titre" id="titre-armes">{armes.page?.titre ?? 'Armes'}</h2>
<div class="armes" data-armes>
  {/* l'icône du Ricken d'or (lib/monnaies.mjs), que le script de la page reprend pour les coûts qu'il écrit (aucun module partagé avec lui) */}
  {Object.keys(MONNAIES_DU_JEU).map((abr) => <template data-armes-piece={abr} set:html={htmlDePiece(abr)}></template>)}
  <PanneauDeRegles panneau={regles} />

  <div class="armes-outils">
    <div class="armes-filtre js-seul" role="group" aria-labelledby="armes-filtre-titre" data-armes-filtre>
      <span class="armes-filtre__titre" id="armes-filtre-titre">Compétence</span>
      {FILTRES.map((html) => <Fragment set:html={html} />)}
      <span class="armes-filtre__sep" aria-hidden="true"></span>
      <button type="button" class="armes-filtre__depart" data-armes-filtre-depart aria-pressed="false" title="N’afficher que les armes possibles en arme de départ">Arme de départ</button>
      <button type="button" class="armes-filtre__tout" data-armes-filtre-tout hidden>Toutes</button>
    </div>
    <p class="armes-legende sans-js"><span class="armes-legende__depart" title="Arme de départ">Arme de départ</span></p>
    <p class="armes-outils__boutons js-seul">
      <span class="armes-aide"><span data-armes-compte>{nbArmes} armes</span>. Cliquez sur une arme pour ouvrir sa fiche et la forger.</span>
      <button type="button" class="armes-bouton" data-armes-tout="ouvrir">Tout déplier</button>
      <button type="button" class="armes-bouton" data-armes-tout="fermer">Tout replier</button>
    </p>
  </div>

  <div class="armes-vue">
    <div class="armes-tableaux">
      {armes.familles.map((f) => <TableauArmes famille={f} {contexte} />)}
    </div>

    <aside class="armes-cote" aria-label="Arme choisie, matériaux et améliorations">
      <section class="arme-fiche" aria-label="Fiche de l’arme" aria-live="polite">
        <p class="arme-fiche__vide">Choisissez une arme dans un tableau : sa fiche s’affiche ici, forgée dans le matériau et avec l’amélioration choisis dessous.</p>
      </section>

      <div class="armes-cote__tables">
        <Tableau id="materiaux-armes" titre="Matériaux" compte={armes.materiaux.length} bloc="armes-famille" class="armes-materiaux" classeTable="armes-table armes-table--materiaux table-donnees--serree">
          <p slot="avant" class="tableau__note armes-famille__note js-seul">Le matériau dont l’arme est forgée (fer par défaut) : son prix et ses bonus s’ajoutent à la fiche.</p>
          <thead><tr><th scope="col">Matière</th><th scope="col">Prix</th><th scope="col" title="Le bonus aux dégâts, puis les autres effets">Effets</th></tr></thead>
          <tbody>
            {
              armes.materiaux.map((m) => (
                <tr class="materiau ligne-couleur" id={ancreDeMateriau(m.ligne.ressource_id)} data-materiau={m.ligne.ressource_id} data-defaut={m.defaut ? '1' : undefined} style={`--mat: ${m.couleur.fond}; --mat-texte: ${m.couleur.texte}`}>
                  <th scope="row" class="materiau__nom">
                    <span data-ed-lecture={attributEd('ressource', { id: m.ligne.ressource_id }, 'nom')} data-ed-cible=".materiau__choisir">
                      <button type="button" class="materiau__choisir" aria-pressed="false">{m.nom}</button>
                    </span>
                  </th>
                  <td class="materiau__prix" data-ed-lecture={attributEd('ressource', { id: m.ligne.ressource_id }, 'prix_brut')} data-ed-rendu="materiau-prix" set:html={RENDUS['materiau-prix'](m.prix, m.ligne, contexte)} />
                  <td class="materiau__effet" data-ed-lecture={edM(m.ligne.ressource_id, 'effet_brut')} data-ed-rendu="materiau-effet" set:html={RENDUS['materiau-effet'](m.ligne.effet_brut, m.ligne, contexte)} />
                </tr>
              ))
            }
          </tbody>
        </Tableau>

        <Tableau id="ameliorations-arme" titre="Améliorations" compte={`+1 à +${armes.ameliorations.length}`} bloc="armes-famille" class="armes-ameliorations" classeTable="armes-table armes-table--ameliorations table-donnees--serree"
          note="Une amélioration +N demande les coûts des niveaux +1 à +N ; un « Matériel » est une unité du matériau de l’arme.">
          <thead><tr><th scope="col">Niveau</th><th scope="col">Coût</th><th scope="col">Effet</th></tr></thead>
          <tbody>
            <tr class="amelioration amelioration--aucune js-seul-ligne" data-niveau="0">
              <th scope="row" class="amelioration__niveau"><button type="button" class="amelioration__choisir" aria-pressed="false">Aucune</button></th>
              <td colspan="2" class="muted">Arme non améliorée</td>
            </tr>
            {
              armes.ameliorations.map((a) => (
                <tr class="amelioration" id={`amelioration-${a.niveau}`} data-niveau={a.niveau}>
                  <th scope="row" class="amelioration__niveau"><button type="button" class="amelioration__choisir" aria-pressed="false">+{a.niveau}</button></th>
                  <td class="amelioration__cout" data-ed={edA(a.id, 'cout_brut')} data-ed-rendu="amelioration-cout" set:html={RENDUS['amelioration-cout'](a.cout_brut, a, contexte)} />
                  <td class="amelioration__effet" data-ed={edA(a.id, 'effet_brut')} data-ed-rendu="amelioration-effet" set:html={RENDUS['amelioration-effet'](a.effet_brut, a, contexte)} />
                </tr>
              ))
            }
          </tbody>
        </Tableau>
      </div>
    </aside>
  </div>
  {/* les infobulles des tuiles de la fiche (le détail des dégâts, de la durabilité et du coût), écrites par le script hors du panneau de côté, qui défile */}
  <div class="armes-bulles" data-armes-bulles></div>
</div>
</section>

<script>
  import '../../scripts/armes.mjs';
</script>
