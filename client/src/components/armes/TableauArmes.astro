---
import { htmlDeLigneDArme } from '../../lib/armes-rendu.mjs';
import type { chargerArmes, contexteDesArmes } from '../../lib/armes-db.mjs';
import Tableau from '../Tableau.astro';

// Le tableau d'UNE famille d'armes (bandeau de l'onglet « Armes »), repliable (demande du propriétaire : « chaque tableau peut être réduit si besoin »),
// sur le gabarit commun des tableaux (components/Tableau.astro), aéré (« l'affichage est trop serré ») :
// Nom (la description en infobulle : « La description prend trop de place dans le tableau. Mets-la en tooltip »), Compétence (pastille dans la couleur
// de sa caractéristique : Force pour l'Arme Lourde et l'Arc, Agilité pour l'Arme Légère, Perception pour l'Arbalète, dégradé pour deux ; décision R48),
// Type, Dégâts, Type de dégâts, Portée (1 par défaut, décision R50), Solidité (le mot-clé du glossaire, migration 0058), Origine ; les effets supplémentaires sur une seconde ligne, sous l'arme
// (« à l'instar des sorts choisis de la fiche de personnage »). Une arme de départ (nom sur fond bleu dans la source) a ses lignes en bleu, avec
// l'infobulle « Arme de départ ». Cliquer une arme la sélectionne : sa fiche s'ouvre à côté (src/scripts/armes.mjs).
// La ligne d'une arme est le HTML de lib/armes-rendu.mjs#htmlDeLigneDArme (celui que le mode modification pose pour une arme créée), ses cellules les
// rendus que le mode modification réécrit après un enregistrement.
// Mode modification (site de dev) : chaque champ porte son `data-ed` ; les colonnes tirées de l'effet sont en lecture (`data-ed-lecture`, recalculées
// par le service) ; cinq colonnes n'apparaissent qu'en mode modification (classe `ed-seul`) : Description, Coût, Effet (le texte de l'onglet, d'où
// les colonnes tirées viennent), Arme de départ, Remarque (l'étoile ★ à côté du nom ; vidée, l'étoile part).
type Armes = ReturnType<typeof chargerArmes>;
interface Props {
  famille: Armes['familles'][number];
  contexte: ReturnType<typeof contexteDesArmes>;
}
const { famille, contexte } = Astro.props;
const id = `famille-${famille.id}`;
const unite = famille.cout_libelle.includes('(unité)');
---

<Tableau
  id={id}
  titre={famille.nom}
  compte={`${famille.armes.length} arme${famille.armes.length > 1 ? 's' : ''}`}
  note={famille.note_brut ? famille.note_brut.split('\n').join(' · ') : null}
  bloc="armes-famille"
  classeTable="armes-table table-donnees--aeree"
  attributs={{ 'data-note': famille.note_brut ?? '', 'data-unite': unite ? '1' : undefined }}
>
  {famille.de_brut && <span slot="outils" class="armes-famille__de" title="Dé de la famille, sauf indication contraire">{famille.de_brut}</span>}
  <thead>
    <tr>
      <th scope="col">Nom</th>
      <th scope="col">Compétence</th>
      <th scope="col">Type</th>
      <th scope="col">Dégâts</th>
      <th scope="col">Type de dégâts</th>
      <th scope="col">Portée</th>
      <th scope="col">{'{{solidite}}'}</th>
      <th scope="col">Origine</th>
      <th scope="col" class="ed-seul">Description</th>
      <th scope="col" class="ed-seul">{famille.cout_libelle}</th>
      <th scope="col" class="ed-seul">Effet (texte de l’onglet)</th>
      <th scope="col" class="ed-seul">Arme de départ</th>
      <th scope="col" class="ed-seul">Remarque</th>
    </tr>
  </thead>
  <tbody>
    {famille.armes.map((a) => <Fragment set:html={htmlDeLigneDArme(a, contexte)} />)}
  </tbody>
</Tableau>
