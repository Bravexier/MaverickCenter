---
// Infobulles des pages de magie (altérations d'état, règle spéciale d'un niveau) : un script, inclus une fois par MagiePage.
// Un déclencheur porte `data-bulle="<id>"` ; sa bulle (`<span role="tooltip" id="<id>" hidden>`) s'affiche au survol, au focus (clavier) ou au toucher,
// en position fixe près du déclencheur (le tableau des sorts défile et couperait une bulle absolue). Échap la ferme.
// Sans JavaScript : la bulle reste cachée et l'attribut `title` du déclencheur (texte simple) joue le rôle d'infobulle native.
---

<script>
  let ouverte: { cible: HTMLElement; bulle: HTMLElement } | null = null;

  // Avec JavaScript, la bulle riche remplace l'infobulle native : on retire `title` pour ne pas avoir les deux.
  for (const c of document.querySelectorAll<HTMLElement>('[data-bulle][title]')) c.removeAttribute('title');

  function fermer() {
    if (!ouverte) return;
    ouverte.bulle.hidden = true;
    ouverte.bulle.removeAttribute('style');
    ouverte.cible.removeAttribute('data-ouverte');
    ouverte = null;
  }

  function ouvrir(cible: HTMLElement) {
    const bulle = document.getElementById(cible.dataset.bulle ?? '');
    if (!bulle) return;
    if (ouverte && ouverte.bulle === bulle) return;
    fermer();
    bulle.hidden = false;
    bulle.style.position = 'fixed';
    bulle.style.visibility = 'hidden';
    const r = cible.getBoundingClientRect();
    const b = bulle.getBoundingClientRect();
    const marge = 8;
    const gauche = Math.max(marge, Math.min(r.left, window.innerWidth - b.width - marge));
    const dessous = r.bottom + 6 + b.height <= window.innerHeight - marge || r.top - 6 - b.height < marge;
    bulle.style.left = `${gauche}px`;
    bulle.style.top = `${dessous ? r.bottom + 6 : r.top - 6 - b.height}px`;
    bulle.style.visibility = '';
    cible.setAttribute('data-ouverte', '');
    ouverte = { cible, bulle };
  }

  const declencheur = (e: Event) => (e.target instanceof Element ? e.target.closest<HTMLElement>('[data-bulle]') : null);

  document.addEventListener('mouseover', (e) => {
    const c = declencheur(e);
    if (c) ouvrir(c);
  });
  document.addEventListener('mouseout', (e) => {
    const c = declencheur(e);
    if (c && !c.contains(e.relatedTarget as Node | null)) fermer();
  });
  document.addEventListener('focusin', (e) => {
    const c = declencheur(e);
    if (c) ouvrir(c);
  });
  document.addEventListener('focusout', (e) => {
    if (declencheur(e)) fermer();
  });
  // Toucher : un appui sur la pastille « i » (le navigateur simule d'abord un survol) laisse la bulle ouverte ; un appui ailleurs la ferme.
  // Un lien d'altération garde son rôle de lien.
  document.addEventListener('click', (e) => {
    const c = declencheur(e);
    if (c) ouvrir(c);
    else fermer();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fermer();
  });
  window.addEventListener('scroll', fermer, { passive: true });
  window.addEventListener('resize', fermer);
</script>
