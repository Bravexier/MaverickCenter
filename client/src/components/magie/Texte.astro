---
import { htmlAvecMonnaies } from '../../lib/monnaies.mjs';
import { morceauxAvecEtats, morceauxAvecLiens } from '../../lib/sort-format.mjs';
import type { Magies } from '../../lib/magies';
import EtatPastille from './EtatPastille.astro';

// Texte d'une cellule ou d'un bloc de la base (lib/sort-format.mjs#blocsDeTexte) : intertitres, paragraphes et listes à puces, sans Markdown.
// Une adresse web écrite dans le texte devient un lien (lib/sort-format.mjs#morceauxAvecLiens). Quand `etats` est donné (les altérations d'état
// repérées dans le texte d'un sort, table sort_etat), chacune devient une pastille avec infobulle PLACÉE DANS LE TEXTE, sur son mot ; la liste est
// consommée (une altération n'est placée qu'une fois, même si le texte est coupé en plusieurs appels). Les monnaies en icônes (décisions R61, R63 :
// lib/monnaies.mjs, comme lib/edition-rendu.mjs#htmlDesBlocs).
interface Props {
  blocs: ({ liste: false; titre?: false; texte: string } | { liste: true; items: string[] } | { titre: true; texte: string })[];
  etats?: { etatId: string; stade: number | null; forme: string; extrait: string }[];
  magies?: Magies;
}
const { blocs, etats, magies } = Astro.props;

const rendre = (texte: string) =>
  (etats && magies ? morceauxAvecEtats(texte, etats) : [{ texte }]).flatMap((m: { texte: string; etat?: unknown }) =>
    m.etat ? [m] : morceauxAvecLiens(m.texte),
  ) as { texte?: string; lien?: string; etat?: { etatId: string; stade: number | null } }[];
---

{
  blocs.map((b) => {
    const morceaux = (texte: string) =>
      rendre(texte).map((p) =>
        p.etat && magies ? (
          <EtatPastille etat={magies.etats.get(p.etat.etatId)!} texte={p.texte!} stade={p.etat.stade} />
        ) : p.lien ? (
          <a href={p.lien} rel="noopener noreferrer">{p.lien}</a>
        ) : (
          <Fragment set:html={htmlAvecMonnaies(p.texte ?? '')} />
        ),
      );
    return 'items' in b ? (
      <ul>{b.items.map((i) => <li>{morceaux(i)}</li>)}</ul>
    ) : 'titre' in b && b.titre ? (
      <h6 class="texte-titre">{b.texte}</h6>
    ) : (
      <p class="texte">{morceaux(b.texte)}</p>
    );
  })
}
