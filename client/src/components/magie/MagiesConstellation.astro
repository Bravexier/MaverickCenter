---
import { couleurDeMagie } from '../../lib/sort-format.mjs';
import { normalize } from '../../lib/text.mjs';
import { entryHref, type WikiEntry } from '../../lib/wiki';
import type { MagieDb } from '../../lib/magies';
import orbiteCss from '../../styles/magie/orbit.css?raw';

interface Props {
  magies: { entry: WikiEntry; magie: MagieDb }[];
}

const { magies } = Astro.props;
// Deux cartes, positions au centre de chaque pastille. Grand écran (x, y sur 1000 × HAUTEUR_GRANDE) : les quatre paires de magies entourent
// l'hexagone élémentaire, le Potentiel Illimité au-dessus, sur la rangée de Corruption et du Vide. Écran étroit, sous 60rem (mx, my sur
// 1000 × HAUTEUR_ETROITE) : deux colonnes. Les proportions sont reprises par styles/magie/orbit.css (aspect-ratio du grand écran, hauteur de
// l'écran étroit) ; test/magies-html.test.mjs vérifie qu'aucune pastille n'en touche une autre.
const HAUTEUR_GRANDE = 390;
const HAUTEUR_ETROITE = 600;
const disposition = [
  { cle: 'Potentiel Illimité', nom: 'Potentiel Illimité', region: 'potentiel', x: 500, y: 40, mx: 500, my: 30 },
  { cle: 'Arcane', nom: 'Arcane', region: 'primordiale', x: 225, y: 120, mx: 260, my: 178 },
  { cle: 'Corruption', nom: 'Corruption', region: 'primordiale', x: 85, y: 40, mx: 260, my: 104 },
  { cle: 'Espace/Temps', nom: 'Espace-Temps', region: 'primordiale', x: 775, y: 120, mx: 740, my: 178 },
  { cle: 'Vide', nom: 'Vide', region: 'primordiale', x: 915, y: 40, mx: 740, my: 104 },
  { cle: 'Nécromancie', nom: 'Nécromancie', region: 'primordiale', x: 85, y: 350, mx: 260, my: 262 },
  { cle: 'Sang', nom: 'Sang', region: 'primordiale', x: 225, y: 270, mx: 260, my: 336 },
  { cle: 'Lumière', nom: 'Lumière', region: 'lumiere-ombre', x: 775, y: 270, mx: 740, my: 262 },
  { cle: 'Ombre', nom: 'Ombre', region: 'lumiere-ombre', x: 915, y: 350, mx: 740, my: 336 },
  { cle: 'Feu', nom: 'Feu', region: 'elementaire', x: 425, y: 120, mx: 280, my: 420 },
  { cle: 'Eau', nom: 'Eau', region: 'elementaire', x: 575, y: 120, mx: 720, my: 420 },
  { cle: 'Glace', nom: 'Glace', region: 'elementaire', x: 660, y: 195, mx: 750, my: 494 },
  { cle: 'Terre', nom: 'Terre', region: 'elementaire', x: 575, y: 270, mx: 720, my: 568 },
  { cle: 'Vent', nom: 'Vent', region: 'elementaire', x: 425, y: 270, mx: 280, my: 568 },
  { cle: 'Foudre', nom: 'Foudre', region: 'elementaire', x: 340, y: 195, mx: 250, my: 494 },
];
// Une hauteur ramenée à la carte : en millièmes pour le SVG (viewBox 1000 × 1000, étiré à la carte), en pourcentage pour les pastilles.
const millieme = (valeur: number, total: number) => Math.round((valeur / total) * 10000) / 10;
const pourcent = (valeur: number, total: number) => millieme(valeur, total) / 10;

const index = new Map(magies.map((item) => [normalize(item.magie.nom), item]));
const phraseCourte = (magie: MagieDb) => {
  const texte = magie.description
    .flatMap((bloc: any) => (bloc.liste ? bloc.items : [bloc.texte]))
    .filter(Boolean)
    .join(' ')
    .replace(/\s+/g, ' ')
    .trim();
  const phrase = texte.match(/^.*?[.!?](?=\s|$)/u)?.[0] ?? texte;
  return phrase.length <= 190 ? phrase : `${phrase.slice(0, 187).replace(/\s+\S*$/u, '')}…`;
};

const noeuds = disposition.flatMap((place, ordre) => {
  const item = index.get(normalize(place.cle));
  return item ? [{ ...place, ...item, ordre, description: phraseCourte(item.magie), couleur: couleurDeMagie(item.magie.nom) }] : [];
});
const parNom = new Map(noeuds.map((noeud) => [normalize(noeud.cle), noeud]));
const liens: { a: any; b: any; type: string }[] = [];
const ajouterLien = (a: any, b: any, type: string) => {
  if (a && b) liens.push({ a, b, type });
};
const incompatible = (a: any, b: any) => a.magie.incompatibles.includes(b.magie.id) || b.magie.incompatibles.includes(a.magie.id);
const vulnérableÀ = (a: any, b: any) => a.magie.resistances.vulnerabilite.magies.some((r: any) => r.id === b.magie.id);

for (const [gauche, droite] of [['Arcane', 'Corruption'], ['Espace/Temps', 'Vide'], ['Nécromancie', 'Sang']]) {
  const a = parNom.get(normalize(gauche));
  const b = parNom.get(normalize(droite));
  if (a && b && incompatible(a, b)) ajouterLien(a, b, 'incompatible');
}

const lumiere = parNom.get(normalize('Lumière'));
const ombre = parNom.get(normalize('Ombre'));
if (lumiere && ombre && (vulnérableÀ(lumiere, ombre) || vulnérableÀ(ombre, lumiere))) ajouterLien(lumiere, ombre, 'opposition');
---

<div class="magies-orbite" role="group" aria-label="Carte des magies">
  <svg class="magies-orbite__liens" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
    {
      liens.map(({ a, b, type }) => (
        <g class={`magies-orbite__lien magies-orbite__lien--${type}`}>
          <line class="magies-orbite__lien--grand" x1={a.x} y1={millieme(a.y, HAUTEUR_GRANDE)} x2={b.x} y2={millieme(b.y, HAUTEUR_GRANDE)} />
          <line class="magies-orbite__lien--petit" x1={a.mx} y1={millieme(a.my, HAUTEUR_ETROITE)} x2={b.mx} y2={millieme(b.my, HAUTEUR_ETROITE)} />
        </g>
      ))
    }
  </svg>
  <ul class="magies-orbite__liste">
    {
      noeuds.map((noeud) => (
        <li
          class={`magies-orbite__position magies-orbite__position--${noeud.region}`}
          style={`--x: ${noeud.x / 10}%; --x-fraction: ${noeud.x / 1000}; --y: ${pourcent(noeud.y, HAUTEUR_GRANDE)}%; --mx: ${noeud.mx / 10}%; --mx-fraction: ${noeud.mx / 1000}; --my: ${pourcent(noeud.my, HAUTEUR_ETROITE)}%; --couleur-magie: ${noeud.couleur}; --ordre: ${noeud.ordre}`}
        >
          <a
            class="magies-orbite__noeud"
            href={entryHref(noeud.entry)}
            data-tooltip={noeud.description}
            aria-label={noeud.nom}
            aria-description={noeud.description}
          >
            <span class="magies-orbite__pastille" aria-hidden="true" />
            <span class="magies-orbite__nom">{noeud.nom}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style is:inline set:html={orbiteCss}></style>