---
import { bulleDeCreature, carteDeCreature, pageHref, sortAncre, titreDeCreature, type Magies, type SortDb } from '../../lib/magies';
import { attributEd } from '../../lib/edition-modele.mjs';
import Texte from './Texte.astro';

// Détails d'un sort, affichés juste sous sa ligne quand on la sélectionne : ses effets (le texte des effets secondaires, puis la remarque du classeur
// (note de cellule) et le texte du sort de niveau 5, à la ligne, dans le même cadre ; les altérations d'état y sont des pastilles avec infobulle, placées
// dans le texte) et, quand le sort a **ses propres règles**, un bloc dédié : pour une invocation, ses règles (repliées) et les créatures invoquées ; le
// nom d'une créature montre sa carte du bestiaire en infobulle (demande du propriétaire : « La carte sera à garder et servirait de tooltip dans leur
// correspondance dans les tableaux des magies et leurs sorts associés » : CarteInvoquee.astro, une bulle par créature et par page, posée par
// MagiePage.astro) ; le lien « Bestiaire » mène à sa page. De même pour la créature d'un effet de carte (« Manteau noir ») : un bouton et son lien, pas un
// lien à bulle (au toucher, la carte couvre l'écran d'un téléphone, et un second appui sur le lien tomberait sur elle).
// `prefixe` (« feu- ») rend uniques les identifiants HTML quand une page montre plusieurs magies (TableauNpm.astro).
interface Props {
  sort: SortDb;
  magies: Magies;
  prefixe?: string;
}
const { sort, magies, prefixe = '' } = Astro.props;

// Altérations d'état à placer dans le texte des effets ; chacune n'est placée qu'une fois (la liste est consommée par Texte.astro)
const aPlacer = sort.etats.filter((e) => e.champ === 'effets');
const memeNom = sort.memeNom.map((id) => magies.sorts.get(id)!).map((o) => ({ sort: o, magie: magies.magies.get(o.magieId)! }));
const aDesEffets = sort.effets.length > 0 || sort.remarque.length > 0 || Boolean(sort.incantation);
const titre = `detail-${prefixe}${sort.slug}-titre`;
// l'infobulle d'une créature (sa carte) : `data-bulle` pour components/Infobulles.astro, `title` en repli sans JavaScript
const bulle = (id: string) => {
  const carte = carteDeCreature(id);
  return carte ? { 'data-bulle': bulleDeCreature(id), 'aria-describedby': bulleDeCreature(id), title: titreDeCreature(carte) } : {};
};
// champs modifiables sur le site de dev : effets, remarque et texte du sort de niveau 5 (vides : cachés en lecture, affichés en mode modification)
const ed = (colonne: string) => attributEd('sort', { id: sort.id }, colonne);
---

<div class="sort-detail" role="region" aria-labelledby={titre}>
  <header class="sort-detail__tete">
    <h4 id={titre} data-ed-lecture={ed('nom')}>{sort.nom}</h4>
    <button type="button" class="sort-detail__fermer" aria-label={`Fermer les détails de ${sort.nom}`}>Fermer</button>
  </header>

  <section class="sort-detail__bloc" data-ed-cadre hidden={!aDesEffets}>
    <h5>Effets</h5>
    <div data-ed={ed('effets')} data-ed-rendu="blocs"><Texte blocs={sort.effets} etats={aPlacer} {magies} /></div>
    <div data-ed-cadre hidden={sort.remarque.length === 0}><div data-ed={ed('remarque')} data-ed-rendu="blocs"><Texte blocs={sort.remarque} etats={aPlacer} {magies} /></div></div>
    {
      sort.niveau === 5 && (
        <blockquote class="incantation" data-ed-cadre hidden={!sort.incantation}><div data-ed={ed('texte_niveau5')} data-ed-rendu="blocs">{sort.incantation && <Texte blocs={sort.incantation} />}</div></blockquote>
      )
    }
  </section>

  {
    sort.invoque.map((i) => (
      <section class="sort-detail__regles">
        <h5>Règles propres : invocation</h5>
        {(i.texte.length > 0 || i.remarque.length > 0) && (
          <details class="regles-texte">
            <summary>Règles de l’invocation</summary>
            <Texte blocs={i.texte} />
            {i.remarque.length > 0 && <Texte blocs={i.remarque} />}
          </details>
        )}
        {i.tableau && i.tableau.lignes.length > 0 && (
          <details class="regles-texte">
            <summary>{i.tableau.titre}</summary>
            <div class="sorts-wrap">
              <table class="annexe">
                <thead><tr><th scope="col">Amélioration</th><th scope="col">Effet</th></tr></thead>
                <tbody>
                  {i.tableau.lignes.map((a) => (
                    <tr>
                      <th scope="row">{a.nom}</th>
                      <td>{a.effets.length > 1 ? <ul>{a.effets.map((e: string) => <li>{e}</li>)}</ul> : a.effets[0]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}
        <h6 class="texte-titre">Créatures invoquées ({i.creatures.length})</h6>
        <ul class="invoque">
          {[...new Set(i.creatures.map((c) => c.bloc))].map((bloc) => (
            <li>
              <span class="invoque__bloc">{bloc}</span>
              <span class="invoque__creatures">
                {i.creatures
                  .filter((c) => c.bloc === bloc)
                  .map((c) => (
                    <span class="creature">
                      <button type="button" class="chip creature__bouton" {...bulle(c.id)}>{c.nom}</button>
                      <a class="chip creature__lien" href={pageHref(c.id)} aria-label={`Page de ${c.nom} dans le bestiaire`}>Bestiaire</a>
                    </span>
                  ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    sort.effetsDeCarte.map((e) => (
      <section class="sort-detail__regles">
        <h5>Règles propres : {e.libelle}</h5>
        <p>
          Carte de{' '}
          <span class="creature">
            {carteDeCreature(e.id) ? <button type="button" class="chip creature__bouton" {...bulle(e.id)}>{e.nom}</button> : e.nom}
            <a class="chip creature__lien" href={pageHref(e.id)} aria-label={`Page de ${e.nom} dans le bestiaire`}>Bestiaire</a>
          </span>
        </p>
        <Texte blocs={e.blocs} />
      </section>
    ))
  }

  {
    memeNom.length > 0 && (
      <section class="sort-detail__bloc">
        <h5>Même nom dans une autre magie</h5>
        <ul class="chips">
          {memeNom.map((o) => <li><a class="chip" href={`${pageHref(o.magie.id)}#${sortAncre(o.sort)}`}>{o.magie.nom}</a></li>)}
        </ul>
      </section>
    )
  }
</div>
