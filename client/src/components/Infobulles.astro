---
// Infobulles de tout le site (demande du propriétaire : toutes habillées comme le reste du site) ; un script, inclus une fois par layouts/Base.astro.
// Deux sortes, un seul habillage (styles/global/infobulles.css) :
//   - bulle riche : le déclencheur porte `data-bulle="<id>"`, sa bulle est écrite dans la page (`<span class="bulle" role="tooltip" id="<id>" hidden>` :
//     altérations d'état, règles d'un niveau, résumés des classes et des races, chapitres du guide, objets…) ;
//   - infobulle d'un attribut `title` : son texte dans une bulle partagée (`.bulle--simple`), JAMAIS l'infobulle du navigateur, qui ne se style
//     pas (demande du propriétaire : « uniquement l'habillée »). Tout `title` de la page est déplacé dans `data-infobulle` dès le chargement, et
//     tout `title` qu'un script pose ensuite (la fiche, les armes, l'édition…) dès qu'il est posé (avant que le navigateur ait pu l'afficher) ;
//     le texte reste une description pour les lecteurs d'écran (`aria-description`, sauf s'il redit `aria-label`). Un script qui LIT un `title`
//     lit `data-infobulle` (src/scripts/armes.mjs, bestiaire.mjs, lib/markdown-edition.mjs). `data-infobulle=""` (un `title` vidé) masque,
//     comme `title=""`, l'infobulle d'un parent. Le `title` d'un déclencheur de bulle riche (son repli sans JavaScript) est retiré.
// Affichage :
//   - à la souris : au survol (une bulle riche aussitôt, un `title` après un court délai, aussitôt si une autre bulle vient de se fermer) ; la bulle
//     reste ouverte quand le pointeur passe dessus (WCAG 1.4.13) ;
//   - au clavier : au focus visible ; Échap ferme une bulle riche SEULE (le panneau du sort reste ouvert), une touche ferme celle d'un `title` ;
//   - au toucher (bulles riches seulement, comme l'infobulle du navigateur) : un premier appui ouvre la bulle (sans suivre le lien d'une pastille
//     d'état), un second suit le lien ; un appui ailleurs la ferme.
// La bulle est en position fixe près du déclencheur (un tableau qui défile couperait une bulle absolue), du côté qui a le plus de place, bornée à
// l'écran, avec une pointe vers le déclencheur (un élément à part : la bulle défile quand son texte est trop long), et suit le défilement.
// Une bulle haute (`data-placement="cote"` : la carte d'une créature invoquée, components/bestiaire/CarteInvoquee.astro) se place à côté du
// déclencheur, à droite ou à gauche (pointe de côté), pour ne pas le recouvrir ; de même la bulle d'un `title` dont le déclencheur porte
// `data-placement="cote"` (les chevrons de la chronologie, l'un sous l'autre : dessous, la bulle du premier couvrirait le second) ; sans la place
// de côté, dessous ou dessus comme les autres, sa
// hauteur bornée à l'espace qui reste (à la souris et au clavier : elle ne cache pas son déclencheur). Au toucher, elle couvre presque l'écran d'un
// téléphone : un appui dans une bulle `data-fermer-au-toucher` (sans lien ni bouton) la ferme. Une bulle plus haute que sa place défile : à la
// molette, et au clavier tant que son déclencheur a le focus (flèches haut et bas, pages, début, fin). Un clic dans une bulle ne la ferme pas.
// Une bulle riche peut contenir toute une tuile (la carte d'une créature : un <div class="bulle bulle--carte"> hors de tout paragraphe).
// Une bulle à champs (`data-bulle-champs` : la tuile d'un choix du tiroir de la fiche, src/scripts/fiche.mjs#bulleDeChoix, `role="dialog"`) se
// remplit au clavier : elle reste ouverte tant que le focus est dans la bulle ou sur son déclencheur (jugé juste après la perte du focus : un champ
// retiré quand la bulle est refaite, auquel la page rend le focus, ne la ferme pas), et quand le pointeur la quitte si ce focus est celui du clavier
// (la dernière interaction est une touche, pas un appui : la souris seule la ferme comme avant) ; Échap, le focus dans la bulle, la ferme et rend le
// focus au déclencheur, sans la rouvrir ; son déclencheur porte `aria-expanded`, tenu ici ; un bouton qui la déclenche ne la bascule pas au second
// appui ni ne l'ouvre au clic, comme un déclencheur qui n'est pas un bouton ; tant que le focus du clavier y est, aucune autre bulle ne la remplace
// (le survol d'un autre déclencheur, un `title`). Entrer dans la bulle et en sortir (Entrée, Tab) est
// l'affaire du script de la page. Toutes les autres bulles n'en changent pas.
// Teinte : celle de la page (--mag : magie, classe, race, partie du guide), lue sur le déclencheur pour la bulle partagée ; sinon l'accent du site.
// Sans JavaScript : les bulles riches restent cachées et l'attribut `title` (texte simple) joue le rôle d'infobulle native.
// Script en ligne, sans module : la version portable n'a ni import ni module partagé entre pages (tools/build-artifact.mjs).
---

<script is:inline data-infobulles>
  (function () {
    var ouverte = null; // { cible, bulle, simple, decalage }
    var enAttente = null; // déclencheur d'un `title` dont l'ouverture est différée
    var suspendu = null; // déclencheur appuyé : plus de bulle jusqu'à ce que le pointeur le quitte (comme l'infobulle du navigateur)
    var attente, delai, image, derniereFermeture = 0;
    var tactile = matchMedia('(hover: none)');
    var marge = 8; // distance minimale au bord de l'écran
    var ecart = 9; // entre le déclencheur et la bulle : la place de la pointe
    var simple = null, fleche = null; // créées au premier usage
    var TEXTE = 'data-infobulle'; // le texte d'un `title` déplacé
    var HORS_PAGE = /^(STYLE|LINK|SCRIPT|META|IFRAME)$/; // leur `title` n'est pas une infobulle (feuille de style alternative, nom d'un cadre)
    var CHAMPS = 'data-bulle-champs'; // une bulle à champs, qui se remplit au clavier
    var sansRouvrir = null; // déclencheur qui reprend le focus à la fermeture de sa bulle à champs (Échap) : sa bulle ne se rouvre pas
    var clavier = false; // la dernière interaction est une touche (pas un appui) : le focus d'une bulle à champs est celui du clavier

    /** Le `title` d'un élément quitte l'attribut que le navigateur affiche : son texte va dans `data-infobulle` (bulle riche : retiré). */
    function deplacer(el) {
      var t = el.getAttribute('title');
      if (t === null || HORS_PAGE.test(el.tagName)) return;
      el.removeAttribute('title');
      if (el.hasAttribute('data-bulle')) return;
      el.setAttribute(TEXTE, t);
      if (t.trim() && t !== el.getAttribute('aria-label')) el.setAttribute('aria-description', t);
      else el.removeAttribute('aria-description');
      if (ouverte && ouverte.simple && ouverte.cible === el) {
        if (!t.trim()) return fermer();
        ouverte.bulle.textContent = t; // un script a changé le texte pendant l'affichage (la fiche recalcule les siens)
        placer();
      }
    }
    document.querySelectorAll('body [title]').forEach(deplacer);
    // un `title` posé par un script, ou un élément ajouté qui en porte : déplacé avant le rendu suivant (rappel en microtâche)
    new MutationObserver(function (changements) {
      changements.forEach(function (m) {
        if (m.type === 'attributes') return deplacer(m.target);
        m.addedNodes.forEach(function (n) {
          if (n.nodeType !== 1) return;
          deplacer(n);
          n.querySelectorAll('[title]').forEach(deplacer);
        });
      });
    }).observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['title'] });

    var borner = function (v, min, max) { return Math.max(min, Math.min(v, Math.max(min, max))); };

    function creer(classe, id) {
      var n = document.createElement('span');
      n.className = classe;
      if (id) { n.id = id; n.setAttribute('role', 'tooltip'); } else n.setAttribute('aria-hidden', 'true');
      n.hidden = true;
      document.body.appendChild(n);
      return n;
    }

    /** Le déclencheur sous un nœud : une bulle riche, ou le texte d'un `title` (le plus proche ; vide, il masque celui d'un parent, comme `title=""`). */
    function declencheur(n) {
      for (var el = n instanceof Element ? n : null; el && el !== document.body; el = el.parentElement) {
        if (el.classList.contains('bulle')) return null;
        if (el.hasAttribute('data-bulle')) return el;
        if (el.hasAttribute(TEXTE)) return el.getAttribute(TEXTE).trim() ? el : null;
      }
      return null;
    }
    /** La bulle ouverte est une bulle à champs où se trouve le focus du clavier (la dernière interaction est une touche) : elle reste. */
    var retenue = function () {
      return ouverte !== null && clavier && ouverte.bulle.hasAttribute(CHAMPS) && ouverte.bulle.contains(document.activeElement);
    };
    /** Le déclencheur `c` ouvre une bulle à champs. */
    var aDesChamps = function (c) {
      var b = document.getElementById(c.getAttribute('data-bulle') || '');
      return b !== null && b.hasAttribute(CHAMPS);
    };
    var dansBulle = function (n) { return n instanceof Node && ouverte !== null && ouverte.bulle.contains(n); };

    /** Ferme la bulle ouverte ; `rendre` (Échap dans une bulle à champs) : le focus revient à son déclencheur. */
    function fermer(rendre) {
      clearTimeout(delai);
      if (!ouverte) return;
      var o = ouverte;
      ouverte = null;
      derniereFermeture = Date.now();
      o.bulle.hidden = true;
      o.bulle.style.removeProperty('position');
      o.bulle.style.removeProperty('left');
      o.bulle.style.removeProperty('top');
      o.bulle.style.removeProperty('max-height');
      fleche.hidden = true;
      o.cible.removeAttribute('data-ouverte');
      if (!o.bulle.hasAttribute(CHAMPS)) return;
      o.cible.setAttribute('aria-expanded', 'false');
      if (rendre === true && o.cible.isConnected) {
        sansRouvrir = o.cible;
        try { o.cible.focus({ preventScroll: true }); } finally { sansRouvrir = null; }
      }
    }

    /** Place la bulle près de son déclencheur, du côté qui a le plus de place, sans sortir de l'écran (zone visible : sans la barre de défilement) ; la pointe vise le déclencheur. */
    function placer() {
      if (!ouverte) return;
      var cible = ouverte.cible, bulle = ouverte.bulle;
      var largeur = document.documentElement.clientWidth;
      var hauteur = document.documentElement.clientHeight;
      var r = cible.getBoundingClientRect();
      // le déclencheur a disparu (page recalculée) ou est sorti de l'écran (aussi de côté : un conteneur qui défile en largeur)
      if (!cible.isConnected || (r.width === 0 && r.height === 0) || r.bottom < 0 || r.top > hauteur || r.right < 0 || r.left > largeur) return fermer();
      var dessous = hauteur - r.bottom - ecart - marge;
      var dessus = r.top - ecart - marge;
      bulle.style.maxHeight = hauteur - 2 * marge + 'px';
      var b = bulle.getBoundingClientRect();
      if ((bulle.getAttribute('data-placement') || cible.getAttribute('data-placement')) === 'cote') {
        var aDroite = largeur - r.right - ecart - marge;
        var aGauche = r.left - ecart - marge;
        if (Math.max(aDroite, aGauche) >= b.width) {
          var droite = aDroite >= b.width;
          var g = droite ? r.right + ecart : r.left - ecart - b.width;
          var h = borner(r.top + r.height / 2 - b.height / 2, marge, hauteur - b.height - marge);
          bulle.style.left = g + 'px';
          bulle.style.top = h + 'px';
          // la pointe, sur le bord tourné vers le déclencheur, à sa hauteur
          fleche.hidden = false;
          fleche.setAttribute('data-cote', droite ? 'droite' : 'gauche');
          fleche.style.left = (droite ? g : g + b.width) - 6 + 'px';
          fleche.style.top = borner(r.top + r.height / 2, h + 14, h + b.height - 14) - 6 + 'px';
          return;
        }
        // pas de place à côté : dessous ou dessus, sans dépasser l'espace qui reste (sauf au toucher, où un appui dans la bulle la ferme)
        if (!tactile.matches) {
          bulle.style.maxHeight = Math.max(dessous, dessus, 120) + 'px';
          b = bulle.getBoundingClientRect();
        }
      }
      var enDessous = b.height <= dessous || dessous >= dessus;
      var vise = r.left + borner(ouverte.decalage, Math.min(8, r.width / 2), r.width - Math.min(8, r.width / 2));
      var gauche = borner(vise - 22, marge, largeur - b.width - marge);
      var haut = borner(enDessous ? r.bottom + ecart : r.top - ecart - b.height, marge, hauteur - b.height - marge);
      bulle.style.left = gauche + 'px';
      bulle.style.top = haut + 'px';
      // la pointe, à cheval sur le bord de la bulle ; pas de pointe quand la bulle, faute de place, couvre son déclencheur
      var bord = enDessous ? haut : haut + b.height;
      fleche.hidden = enDessous ? haut < r.bottom : bord > r.top;
      fleche.setAttribute('data-cote', enDessous ? 'dessous' : 'dessus');
      fleche.style.left = borner(vise, gauche + 14, gauche + b.width - 14) - 6 + 'px';
      fleche.style.top = bord - 6 + 'px';
    }

    function ouvrir(cible, x) {
      clearTimeout(attente);
      clearTimeout(delai);
      enAttente = null;
      if (ouverte && ouverte.cible === cible) return;
      if (retenue()) return; // le focus du clavier dans une bulle à champs : aucune autre bulle ne la remplace (le survol, un `title`)
      var estSimple = !cible.hasAttribute('data-bulle');
      var bulle, titre = null;
      if (estSimple) {
        titre = cible.getAttribute(TEXTE);
        if (!titre || !titre.trim()) return;
        if (!simple) {
          simple = creer('bulle bulle--simple', 'bulle-du-titre');
          // son texte est celui d'un attribut, déjà en texte simple (sauf dans une zone brute, où il reste tel qu'écrit) : les mots-clés vivants du site de
          // dev (src/scripts/edition/mots-cles-vivants.mjs) n'y rendent rien
          simple.setAttribute('data-mots-cles-bruts', '');
        }
        bulle = simple;
      } else {
        bulle = document.getElementById(cible.getAttribute('data-bulle') || '');
        if (!bulle) return;
      }
      fermer();
      fleche = fleche || creer('bulle-fleche');
      // une fenêtre modale (<dialog>) passe devant tout le reste de la page : la bulle partagée et la pointe y vont avec le déclencheur
      var hote = cible.closest('dialog[open]') || document.body;
      if (fleche.parentNode !== hote) hote.appendChild(fleche);
      if (estSimple) {
        if (bulle.parentNode !== hote) hote.appendChild(bulle);
        bulle.textContent = titre;
        var teinte = getComputedStyle(cible).getPropertyValue('--mag').trim();
        if (teinte) bulle.style.setProperty('--bulle-teinte', teinte);
        else bulle.style.removeProperty('--bulle-teinte');
      }
      var r = cible.getBoundingClientRect();
      // la pointe vise le pointeur sur un grand déclencheur (une ligne de tableau), le milieu d'un petit, le début d'un champ au clavier
      var decalage = x === undefined ? Math.min(r.width / 2, 24) : r.width > 48 ? x - r.left : r.width / 2;
      ouverte = { cible: cible, bulle: bulle, simple: estSimple, decalage: decalage };
      bulle.hidden = false;
      bulle.style.position = 'fixed';
      bulle.style.visibility = 'hidden';
      cible.setAttribute('data-ouverte', '');
      if (bulle.hasAttribute(CHAMPS)) cible.setAttribute('aria-expanded', 'true');
      var style = getComputedStyle(bulle);
      fleche.style.setProperty('--fleche-fond', style.backgroundColor);
      fleche.style.setProperty('--fleche-ligne', style.borderTopColor);
      fleche.hidden = false;
      placer();
      bulle.style.visibility = '';
    }

    /** Fermeture différée : le pointeur a le temps de passer du déclencheur à la bulle. */
    function fermerBientot() {
      clearTimeout(delai);
      delai = setTimeout(fermer, 150);
    }

    document.addEventListener('pointerover', function (e) {
      if (e.pointerType === 'touch') return;
      if (ouverte && !ouverte.cible.isConnected) fermer();
      if (dansBulle(e.target)) return clearTimeout(delai);
      var c = declencheur(e.target);
      if (!c || c === suspendu) return;
      if (ouverte && ouverte.cible === c) return clearTimeout(delai);
      if (c === enAttente) return;
      clearTimeout(attente);
      enAttente = null;
      // bulle riche : aussitôt ; `title` : après un délai, comme l'infobulle du navigateur, sauf si une bulle est ouverte ou vient de se fermer
      if (c.hasAttribute('data-bulle') || ouverte || Date.now() - derniereFermeture < 400) return ouvrir(c, e.clientX);
      enAttente = c;
      var x = e.clientX;
      attente = setTimeout(function () { if (enAttente === c && c.isConnected) ouvrir(c, x); }, 450);
    });
    document.addEventListener('pointerout', function (e) {
      if (e.pointerType === 'touch') return;
      var vers = e.relatedTarget;
      if (enAttente && !enAttente.contains(vers)) {
        clearTimeout(attente);
        enAttente = null;
      }
      if (suspendu && !suspendu.contains(vers)) suspendu = null;
      if (!ouverte) return;
      if (ouverte.cible.contains(e.target) || dansBulle(e.target)) {
        // une bulle à champs ne se ferme pas au départ du pointeur tant que le focus du clavier est dans la bulle ou sur son déclencheur (un focus donné
        // par un appui : la souris seule, qui la ferme comme avant)
        var ici = document.activeElement;
        if (clavier && ouverte.bulle.hasAttribute(CHAMPS) && ici instanceof Node && (ouverte.cible.contains(ici) || ouverte.bulle.contains(ici))) return;
        if (!ouverte.cible.contains(vers) && !dansBulle(vers)) fermerBientot();
      }
    });
    // un appui ferme la bulle d'un `title` ; plus de bulle tant que le pointeur reste sur l'élément (comme l'infobulle du navigateur)
    document.addEventListener(
      'pointerdown',
      function (e) {
        clavier = false;
        clearTimeout(attente);
        enAttente = null;
        if (dansBulle(e.target)) return;
        var c = declencheur(e.target);
        if (c && !c.hasAttribute('data-bulle')) suspendu = c;
        if (ouverte && ouverte.simple) fermer();
      },
      true,
    );
    // Clavier : seulement le focus visible (un appui au toucher ou un clic de souris donne aussi le focus, mais ne doit pas ouvrir seul la bulle).
    document.addEventListener('focusin', function (e) {
      var c = declencheur(e.target);
      if (c && c !== suspendu && c !== sansRouvrir && c.matches(':focus-visible')) ouvrir(c);
    });
    // le déclencheur perd le focus : la bulle se ferme, sauf si c'est un clic dans la bulle (pour lire, sélectionner, défiler : le pointeur, qui est
    // dessus, la fermera en la quittant) ; une bulle à champs reste ouverte tant que le focus va de son déclencheur à la bulle, ou d'un champ à l'autre
    document.addEventListener('focusout', function (e) {
      if (!ouverte || ouverte.bulle.matches(':hover')) return;
      if (!ouverte.bulle.hasAttribute(CHAMPS)) {
        if (ouverte.cible.contains(e.target)) fermer();
        return;
      }
      // décidé après coup : un champ retiré (la bulle refaite par la page) perd le focus, que la page lui rend aussitôt
      var o = ouverte;
      if (!o.cible.contains(e.target) && !dansBulle(e.target)) return;
      setTimeout(function () {
        var ici = document.activeElement;
        if (ouverte === o && !o.bulle.matches(':hover') && !(ici instanceof Node && (o.cible.contains(ici) || o.bulle.contains(ici)))) fermer();
      });
    });
    document.addEventListener('click', function (e) {
      var c = declencheur(e.target);
      if (dansBulle(e.target)) {
        if (tactile.matches && ouverte.bulle.hasAttribute('data-fermer-au-toucher')) fermer();
        return;
      }
      if (!c) return fermer();
      if (!c.hasAttribute('data-bulle')) return;
      // un bouton qui déclenche une bulle à champs (le choix du tiroir de la fiche) se comporte comme un autre déclencheur : ni bascule au second
      // appui, ni ouverture au clic
      var bascule = c.tagName === 'BUTTON' && !aDesChamps(c);
      if (tactile.matches) {
        // premier appui : la bulle ; une pastille d'état (un lien) ne suit son lien qu'au second appui, sur la même pastille
        if (ouverte && ouverte.cible === c) {
          if (bascule) fermer();
        } else {
          if (c.tagName === 'A') e.preventDefault();
          ouvrir(c);
        }
      } else if (bascule) ouvrir(c);
    });
    // Échap ferme une bulle riche seule : on intercepte avant le gestionnaire du panneau d'un sort (SortsInteractifs), qui n'est pas prévenu
    // quand une bulle était ouverte. Une touche (Échap compris, qui garde alors son effet) ferme la bulle d'un `title`, comme l'infobulle du
    // navigateur. Une bulle riche plus haute que sa place (la carte d'une créature) défile au clavier, au lieu de la page,
    // tant que son déclencheur a le focus.
    document.addEventListener(
      'keydown',
      function (e) {
        clavier = true;
        clearTimeout(attente);
        enAttente = null;
        if (!ouverte) return;
        if (ouverte.simple) {
          if (['Shift', 'Control', 'Alt', 'Meta', 'AltGraph'].indexOf(e.key) < 0) fermer();
        } else if (e.key === 'Escape') {
          fermer(ouverte.bulle.hasAttribute(CHAMPS) && dansBulle(document.activeElement));
          e.stopPropagation();
        } else if (ouverte.bulle.scrollHeight > ouverte.bulle.clientHeight && document.activeElement === ouverte.cible && !(e.altKey || e.ctrlKey || e.metaKey || e.shiftKey)) {
          var b = ouverte.bulle;
          var pas = { ArrowDown: 40, ArrowUp: -40, PageDown: b.clientHeight * 0.9, PageUp: -b.clientHeight * 0.9, Home: -b.scrollHeight, End: b.scrollHeight }[e.key];
          if (pas === undefined) return;
          b.scrollBy({ top: pas });
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );
    var replacer = function () {
      cancelAnimationFrame(image);
      image = requestAnimationFrame(placer);
    };
    addEventListener('scroll', replacer, { passive: true, capture: true });
    addEventListener('resize', replacer);
    addEventListener('blur', function () { if (ouverte && ouverte.simple) fermer(); });
  })();
</script>
