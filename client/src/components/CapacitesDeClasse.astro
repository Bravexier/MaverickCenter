---
import { capacitesOfClass, nomCapacite, nomsSeRepondent } from '../lib/capacites.mjs';
import { bonusAM } from '../lib/classe-bonus.mjs';
import { entryHref, type WikiEntry } from '../lib/wiki';

interface Props {
  entry: WikiEntry;
  entries: WikiEntry[];
}
const { entry, entries } = Astro.props;
const { automatiques, specialites, groupes } = capacitesOfClass(entries, entry);
const am = bonusAM(entries, entry);
const total = automatiques.length + specialites.reduce((n, s) => n + (s.cartouche ? 1 : 0) + s.groupes.reduce((m, g) => m + g.options.length, 0), 0) + groupes.reduce((n, g) => n + g.options.length, 0);
const detail = (e: WikiEntry) => [`Niveau ${e.data.niveau}`, e.data.type_capacite].filter(Boolean).join(' · ');
const nom = nomCapacite;
// Deux noms coupés qui se répondent (« Tenir ... » / « ... ou charger ? ») : pas de « ou » de plus entre eux.
const separateur = (a: WikiEntry, b: WikiEntry) => (nomsSeRepondent(a, b) ? '/' : 'ou');
---

{
  total > 0 && (
    <section class="relations" id="capacites" aria-labelledby="capacites-titre">
      <h2 id="capacites-titre">Capacités de la classe</h2>
      <p class="muted">
        {total} capacités. Celles d'une même ligne dans la feuille sont un <strong>choix</strong> : une seule peut être prise.
        {specialites.length > 1 && ' Choisir une spécialité exclut l’autre et toutes ses capacités.'}
      </p>

      {automatiques.length > 0 && (
        <>
          <h3>Reçues sans choix</h3>
          <ul class="cap-list">
            {automatiques.map((e) => <li><a href={entryHref(e)}>{nom(e)}</a> <span class="muted">{detail(e)}</span></li>)}
          </ul>
        </>
      )}

      {groupes.length > 0 && (
        <>
          <h3>Au choix</h3>
          {groupes.map((g) => (
            <div class="cap-group">
              <div class="muted">Niveau {g.niveau} : une seule parmi {g.options.length}</div>
              <ul class="cap-options">
                {g.options.map((e, i) => (
                  <>
                    {i > 0 && <li class="cap-or" aria-hidden="true">{separateur(g.options[i - 1], e)}</li>}
                    <li><a href={entryHref(e)}>{nom(e)}</a><div class="muted">{e.data.type_capacite}</div></li>
                  </>
                ))}
              </ul>
            </div>
          ))}
        </>
      )}

      {specialites.map((s) => (
        <>
          <h3>
            Spécialité {s.nom}
            {am?.portee === 'specialite' && am.specialite === s.nom && <span class="badge badge--hybride" title="Bonus d'armure magique de cette spécialité">+{am.valeur} AM</span>}
          </h3>
          {s.cartouche && <p>La spécialité : <a href={entryHref(s.cartouche)}>{nom(s.cartouche)}</a> <span class="muted">{detail(s.cartouche)}</span></p>}
          {s.groupes.map((g) => (
            <div class="cap-group">
              <div class="muted">Niveau {g.niveau} : une seule parmi {g.options.length}</div>
              <ul class="cap-options">
                {g.options.map((e, i) => (
                  <>
                    {i > 0 && <li class="cap-or" aria-hidden="true">{separateur(g.options[i - 1], e)}</li>}
                    <li><a href={entryHref(e)}>{nom(e)}</a><div class="muted">{e.data.type_capacite}</div></li>
                  </>
                ))}
              </ul>
            </div>
          ))}
        </>
      ))}
    </section>
  )
}
