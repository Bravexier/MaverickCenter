---
import { url } from '../../lib/wiki';

// Mode modification des pages (demande du propriétaire) : sur le SITE DE DEV seulement, et sur un ordinateur seulement (pas sur mobile). Rien ne
// s'affiche ailleurs : le script demande au service (/api/etat/) si l'édition est ouverte (MAVERICK_EDITION=1, serveur de test), et seulement sur un
// écran large avec une souris ; alors seulement il charge l'éditeur (src/scripts/edition/editeur.mjs) : crayon à cocher pour passer en mode
// modification, bouton de confirmation flottant à droite pour enregistrer et repasser en lecture. Les champs modifiables sont les éléments `data-ed`
// des gabarits (lib/edition-modele.mjs). Absent de la version portable (tools/build-artifact.mjs : pas de service).
interface Props {
  /** Id de la page (« races/elfe-noir », « metiers/ ») : noté au journal avec chaque enregistrement. */
  page: string;
}
const { page } = Astro.props;
---

<div data-edition data-api={url('api/')} data-page={page} data-base={url()} hidden></div>
<script>
  import '../../scripts/edition.mjs';
</script>
