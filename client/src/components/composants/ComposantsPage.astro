---
import composantsCss from '../../styles/composants/composants.css?raw';
import type { chargerComposants } from '../../lib/composants-db.mjs';
import { url } from '../../lib/wiki';
import {
  htmlDeLigneDeBois, htmlDeLigneDeGemme, htmlDeLigneDeMateriau, htmlDeLigneDeMonnaie, htmlDeLigneDIngredient, htmlDeLigneDObjet,
} from '../../lib/composants-rendu.mjs';

// Page /ressources/composants/ (demande du propriétaire, 2026-10-14 : « un onglet "Composants". Il comprendra les tableaux des gemmes, des matériaux, la
// monnaie, et l'ensemble des tables de l'onglet "équipement inventaire" » ; « Il faut aussi y mettre la table des fruits. Ainsi que tout ce qui n'est pas
// directement des consommables mais qui peut servir pour fabriquer les potions / fioles et autres ») : rendue depuis les tables de la base
// (lib/composants-db.mjs), un tableau repliable par liste, dans l'ordre : monnaie, matériaux, gemmes, bois, fruits, ingrédients d'alchimie (par
// catégorie), puis les tableaux de l'onglet « Équipement inventaire ». Une recherche filtre les lignes de tous les tableaux (src/scripts/composants.mjs).
// Mode modification (site de dev, src/scripts/edition/composants.mjs) : chaque case modifiable porte son `data-ed` (lib/composants-rendu.mjs) ; un bouton
// « + Ajouter » par tableau (`data-ajout` : l'entité et ses valeurs données d'office), « Supprimer » sur chaque ligne qui n'est citée par aucune autre règle.
// CSS : styles/composants/composants.css (?raw, inséré ici seulement).
type Composants = ReturnType<typeof chargerComposants>;
interface Props {
  composants: Composants;
}
const { composants } = Astro.props;
const { monnaies } = composants;

/** Un tableau de la page : son ancre, son titre, ses en-têtes, ses lignes (HTML), l'entité à créer (et les valeurs données d'office). */
interface Tableau {
  id: string;
  titre: string;
  groupe?: string | null;
  note?: string;
  entetes: string[];
  lignes: string[];
  ajout: { entite: string; valeurs?: Record<string, string>; montrer?: string[]; libelle: string } | null;
}
const slug = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const QUALITES = ['Commune', 'Raffinée', 'Parfaite'];
const tableaux: Tableau[] = [
  {
    id: 'monnaie', titre: 'Monnaie', note: 'Chaque monnaie vaut un nombre de RF, l’unité (CONVERTISSEUR de l’onglet « Équipement inventaire »).',
    entetes: ['Nom', 'Symbole', 'Valeur', 'Conversion'], lignes: monnaies.map((m) => htmlDeLigneDeMonnaie(m, monnaies)),
    ajout: { entite: 'monnaie', libelle: 'une monnaie' },
  },
  {
    id: 'materiaux', titre: 'Matériaux',
    note: 'La référence des matériaux : nom, type (d’après l’armure), prix et effets sur une arme se modifient ici, les pages des armes et des armures les reprennent.',
    entetes: ['Matière', 'Type', 'Prix', 'Description', 'Effets sur une arme', 'Utilisé pour'], lignes: composants.materiaux.map(htmlDeLigneDeMateriau),
    ajout: { entite: 'materiau', libelle: 'un matériau' },
  },
  {
    id: 'gemmes', titre: 'Gemmes précieuses', note: 'Une gemme par magie. Le prix de la gemme entière (bâton magique) et celui d’un quart de gemme (accessoires), par qualité.',
    entetes: ['Magie', 'Gemme', 'Description', ...QUALITES.map((q) => `Gemme ${q.toLowerCase()}`), ...QUALITES.map((q) => `Quart ${q.toLowerCase()}`)],
    lignes: composants.gemmes.map(htmlDeLigneDeGemme), ajout: { entite: 'gemme', libelle: 'une gemme' },
  },
  {
    id: 'bois', titre: 'Bois des bâtons magiques', note: 'Un bois par magie (onglet « Bâton magique »).',
    entetes: ['Magie', 'Bois', 'Description', 'Prix'], lignes: composants.bois.map(htmlDeLigneDeBois), ajout: { entite: 'bois', libelle: 'un bois' },
  },
  {
    id: 'fruits', titre: 'Fruits', groupe: 'Ingrédients d’alchimie',
    note: 'Les ingrédients de type « Fruit » de la liste d’ingrédients (doc « Alchimie »).',
    entetes: ['Fruit', 'Catégorie', 'Type', 'Affinité'], lignes: composants.fruits.map((i) => htmlDeLigneDIngredient(i, { fruit: true })),
    ajout: { entite: 'ingredient', valeurs: { categorie: 'catalyseur', type_brut: 'Fruit' }, montrer: ['categorie', 'type_brut'], libelle: 'un fruit' },
  },
  ...composants.ingredients.map((c) => ({
    id: `ingredients-${c.categorie}`, titre: c.section, groupe: 'Ingrédients d’alchimie',
    entetes: ['Ingrédient', 'Type', 'Affinité'], lignes: c.ingredients.map((i) => htmlDeLigneDIngredient(i)),
    ajout: { entite: 'ingredient', valeurs: { categorie: c.categorie }, libelle: `un ingrédient (${c.section.toLowerCase()})` },
  })),
  ...composants.objets.map((s) => ({
    id: `objets-${slug(s.section)}`, titre: s.section.charAt(0) + s.section.slice(1).toLowerCase(), groupe: s.groupe ?? 'Équipement',
    entetes: s.description ? ['Nom', 'Prix', 'Description'] : ['Nom', 'Prix'], lignes: s.objets.map((r) => htmlDeLigneDObjet(r, s.description)),
    ajout: { entite: 'composant', valeurs: { tableau: `${s.genre}:${s.section}` }, libelle: 'un objet' },
  })),
];
const nombre = tableaux.reduce((n, t) => n + t.lignes.length, 0);
---

<style is:inline set:html={composantsCss}></style>
<script is:inline>
  document.documentElement.classList.add('js');
</script>
<div class="composants" data-composants>
  <h1>Composants <span class="badge">Ressource</span></h1>
  <p class="composants__chapo">
    Ce qui sert à fabriquer, acheter et équiper sans être consommé tel quel : la monnaie, les matériaux, les gemmes et les bois, les ingrédients
    d’alchimie (fruits compris) et l’équipement d’inventaire. Les potions sont dans <a href={url('ressources/alchimie/')}>Alchimie</a>.
  </p>

  <nav class="composants-sommaire" aria-label="Tableaux de la page">
    {tableaux.map((t) => <a href={`#${t.id}`}>{t.titre}</a>)}
  </nav>

  <div class="composants-outils js-seul">
    <label class="composants-recherche">
      <span>Rechercher</span>
      <input type="search" data-composants-recherche placeholder="Nom, description, affinité…" autocomplete="off" />
    </label>
    <span class="composants-aide" data-composants-compte>{nombre} composants</span>
    <button type="button" class="composants-bouton" data-composants-tout="ouvrir">Tout déplier</button>
    <button type="button" class="composants-bouton" data-composants-tout="fermer">Tout replier</button>
  </div>

  <div class="composants-tableaux">
    {
      tableaux.map((t, i) => (
        <>
          {t.groupe && t.groupe !== tableaux[i - 1]?.groupe && <h2 class="composants-groupe">{t.groupe}</h2>}
          <details class="comp-tableau" id={t.id} open data-repli>
            <summary class="comp-tableau__titre">
              <span class="comp-tableau__nom" id={`${t.id}-titre`}>{t.titre}</span>
              <span class="comp-tableau__compte" data-compte>{t.lignes.length}</span>
            </summary>
            {t.note && <p class="comp-tableau__note">{t.note}</p>}
            <div class="comp-wrap">
              <table class="comp-table" aria-labelledby={`${t.id}-titre`} data-ajout={t.ajout ? JSON.stringify(t.ajout) : undefined}>
                <thead>
                  <tr>{t.entetes.map((h) => <th scope="col">{h}</th>)}</tr>
                </thead>
                <tbody>
                  {t.lignes.map((html) => <Fragment set:html={html} />)}
                </tbody>
              </table>
            </div>
          </details>
        </>
      ))
    }
  </div>
  <p class="composants-rien" data-composants-rien hidden>Aucun composant ne correspond à la recherche.</p>
</div>

<script>
  import '../../scripts/composants.mjs';
</script>
