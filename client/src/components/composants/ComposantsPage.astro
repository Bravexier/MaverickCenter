---
import composantsCss from '../../styles/composants/composants.css?raw';
import Onglets from '../Onglets.astro';
import Tableau from '../Tableau.astro';
import type { chargerComposants } from '../../lib/composants-db.mjs';
import { idDuTableauDIngredients, idDuTableauDObjets } from '../../lib/composants-db.mjs';
import { attributEd } from '../../lib/edition-modele.mjs';
import { url } from '../../lib/wiki';
import {
  htmlDeLigneDeBois, htmlDeLigneDeGemme, htmlDeLigneDeMateriau, htmlDeLigneDeMonnaie, htmlDeLigneDIngredient, htmlDeLigneDObjet,
} from '../../lib/composants-rendu.mjs';
import { cssDesFamilles } from '../../lib/palette-css.mjs';

// Page /ressources/composants/ (demande du propriétaire, 2026-10-14 : « un onglet "Composants". Il comprendra les tableaux des gemmes, des matériaux, la
// monnaie, et l'ensemble des tables de l'onglet "équipement inventaire" » ; « Il faut aussi y mettre la table des fruits. Ainsi que tout ce qui n'est pas
// directement des consommables mais qui peut servir pour fabriquer les potions / fioles et autres ») : rendue depuis les tables de la base
// (lib/composants-db.mjs) : monnaie, matériaux, gemmes, bois, fruits, ingrédients d'alchimie (par catégorie), puis les tableaux de l'onglet « Équipement
// inventaire ». Un onglet par tableau, comme la page « Équipement » (demande du propriétaire du 2026-10-17 : « à l'image de la page d'équipement avoir
// des onglets pour chaque table. Il faudrait aussi qu'elles soient modifiables et directement liées en base ») : components/Onglets.astro, posé une fois
// ici ; chaque onglet est une ligne de la table composant_onglet (migration 0057 : titre, note, place dans la barre), son id l'ancre de l'onglet et l'id
// du panneau de son tableau. Le panneau est le tableau lui-même, sur le gabarit commun du site (components/Tableau.astro, styles/global/tableaux.css :
// `section.tableau.comp-tableau.composants-panneau`, son titre `<h2>`, sa note), dont le titre se cache sous les onglets (l'onglet le dit). Sans
// JavaScript, les panneaux se suivent, chacun sous son titre. Un lien vers une ligne (#composant-…, depuis la page « Équipement ») ouvre son onglet.
// Une recherche filtre les lignes de tous les tableaux ; chaque onglet dit combien il en garde (src/scripts/composants.mjs). À l'impression, tous les
// panneaux sortent, chacun sous son titre.
// Mode modification (site de dev, src/scripts/edition/composants.mjs) : le titre (le titre du panneau, que l'onglet reprend) et la note de chaque onglet ;
// chaque case modifiable porte son `data-ed` (lib/composants-rendu.mjs) ; un bouton « + Ajouter » par tableau (`data-ajout` : l'entité et ses valeurs
// données d'office), « Supprimer » sur chaque ligne qui n'est citée par aucune autre règle.
// CSS : styles/composants/composants.css (?raw, inséré ici seulement).
type Composants = ReturnType<typeof chargerComposants>;
interface Props {
  composants: Composants;
}
const { composants } = Astro.props;
const { monnaies } = composants;

/** Le contenu d'un tableau : ses en-têtes, ses lignes (HTML), l'entité à créer (et les valeurs données d'office). */
interface Contenu {
  entetes: string[];
  lignes: string[];
  ajout: { entite: string; valeurs?: Record<string, string>; montrer?: string[]; libelle: string } | null;
}
const QUALITES = ['Commune', 'Raffinée', 'Parfaite'];
/** Le contenu de chaque tableau, par l'id de son onglet (lib/composants-db.mjs#TABLEAUX_DES_COMPOSANTS). */
const contenus: Record<string, Contenu> = {
  monnaie: {
    entetes: ['Nom', 'Symbole', 'Valeur', 'Conversion'], lignes: monnaies.map((m) => htmlDeLigneDeMonnaie(m, monnaies)),
    ajout: { entite: 'monnaie', libelle: 'une monnaie' },
  },
  materiaux: {
    entetes: ['Matière', 'Type', 'Prix', 'Description', 'Fabrication', 'Effets sur une arme', 'Utilisé pour'], lignes: composants.materiaux.map(htmlDeLigneDeMateriau),
    ajout: { entite: 'materiau', libelle: 'un matériau' },
  },
  gemmes: {
    entetes: ['Magie', 'Gemme', 'Description', ...QUALITES.map((q) => `Gemme ${q.toLowerCase()}`), ...QUALITES.map((q) => `Quart ${q.toLowerCase()}`)],
    lignes: composants.gemmes.map(htmlDeLigneDeGemme), ajout: { entite: 'gemme', libelle: 'une gemme' },
  },
  bois: {
    entetes: ['Magie', 'Bois', 'Description', 'Prix'], lignes: composants.bois.map(htmlDeLigneDeBois), ajout: { entite: 'bois', libelle: 'un bois' },
  },
  fruits: {
    entetes: ['Fruit', 'Catégorie', 'Type', 'Affinité'], lignes: composants.fruits.map((i) => htmlDeLigneDIngredient(i, { fruit: true })),
    ajout: { entite: 'ingredient', valeurs: { categorie: 'catalyseur', type_brut: 'Fruit' }, montrer: ['categorie', 'type_brut'], libelle: 'un fruit' },
  },
  ...Object.fromEntries(composants.ingredients.map((c) => [idDuTableauDIngredients(c.categorie), {
    entetes: ['Ingrédient', 'Type', 'Affinité'], lignes: c.ingredients.map((i) => htmlDeLigneDIngredient(i)),
    ajout: { entite: 'ingredient', valeurs: { categorie: c.categorie }, libelle: `un ingrédient (${c.section.toLowerCase()})` },
  }])),
  ...Object.fromEntries(composants.objets.map((s) => [idDuTableauDObjets(s.section), {
    entetes: s.description ? ['Nom', 'Prix', 'Description'] : ['Nom', 'Prix'], lignes: s.objets.map((r) => htmlDeLigneDObjet(r, s.description)),
    ajout: { entite: 'composant', valeurs: { tableau: `${s.genre}:${s.section}` }, libelle: 'un objet' },
  }])),
};
// les onglets dans l'ordre de la barre (composant_onglet), chacun avec son tableau (lib/composants-db.mjs#ongletsDeLaPage : jamais l'un sans l'autre ;
// un id de TABLEAUX_DES_COMPOSANTS sans contenu ici arrête aussi le build)
const tableaux = composants.onglets.map((o) => {
  if (!contenus[o.id]) throw new Error(`Composants : l’onglet « ${o.id} » n’a pas de contenu dans components/composants/ComposantsPage.astro.`);
  return { ...o, ...contenus[o.id] };
});
const nombre = tableaux.reduce((n, t) => n + t.lignes.length, 0);
const ed = (id: string, colonne: string) => attributEd('composant_onglet', { id }, colonne);
// la couleur de chaque matériau (sa pastille) : la classe de la palette (famille `materiau`, lib/palette-css.mjs), émise par cette page, pour les lignes
// construites comme pour celles que le mode modification ajoute (`par-defaut` pour un matériau sans couleur) ; les gemmes et les bois portent la classe
// de leur magie, posée sur chaque page
const couleurs = cssDesFamilles(['materiau']);
---

<style is:inline set:html={composantsCss}></style>
<style is:inline set:html={couleurs}></style>
{/* Onglets pose aussi `html.js` avant l'affichage (un panneau fermé n'est caché que sous html.js) */}
<Onglets />
<div class="composants" data-composants>
  <h1>Composants <span class="badge">Ressource</span></h1>
  <p class="composants__chapo">
    Ce qui sert à fabriquer, acheter et équiper sans être consommé tel quel : la monnaie, les matériaux, les gemmes et les bois, les ingrédients
    d’alchimie (fruits compris) et l’équipement d’inventaire. Les potions sont dans <a href={url('ressources/alchimie/')}>Alchimie</a>.
  </p>

  <div class="composants-outils js-seul">
    <label class="composants-recherche">
      <span>Rechercher</span>
      <input type="search" data-composants-recherche placeholder="Nom, description, affinité…" autocomplete="off" />
    </label>
    <span class="composants-aide" data-composants-compte>{nombre} composants</span>
  </div>

  <nav class="composants-onglets" aria-label="Composants" data-onglets="Composants">
    {
      tableaux.map((t, i) => (
        <a class={`onglet${i === 0 ? ' is-active' : ''}`} id={`onglet-${t.id}`} href={`#${t.id}`}>
          <span class="onglet__nom" data-ed-lecture={ed(t.id, 'titre')}>{t.titre}</span>
          <span class="onglet__detail" data-compte>{t.lignes.length}</span>
        </a>
      ))
    }
  </nav>

  {
    tableaux.map((t, i) => (
      <Tableau
        id={t.id}
        titre={t.titre}
        note={t.note}
        repliable={false}
        niveau={2}
        bloc="comp-tableau"
        class={`composants-panneau${i === 0 ? ' is-active' : ''}`}
        classeTable="comp-table"
        attributsNom={{ 'data-ed': ed(t.id, 'titre') }}
        attributsNote={{ 'data-ed': ed(t.id, 'note'), 'data-ed-cadre': '' }}
        attributsTable={{ 'data-ajout': t.ajout ? JSON.stringify(t.ajout) : undefined }}
      >
        <thead>
          <tr>{t.entetes.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {t.lignes.map((html) => <Fragment set:html={html} />)}
        </tbody>
        <p slot="apres" class="comp-rien" data-rien hidden>Aucune ligne de cet onglet ne correspond à la recherche.</p>
      </Tableau>
    ))
  }
  <p class="composants-rien" data-composants-rien hidden>Aucun composant ne correspond à la recherche.</p>
</div>

<script>
  import '../../scripts/composants.mjs';
</script>
