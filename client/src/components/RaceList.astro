---
import { entryHref, type WikiEntry } from '../lib/wiki';

// Une colonne de /races/ : le nom et l'accroche de chaque race, rien d'autre (demande du propriétaire). Les magies innées sont dans le tableau
// en bas de la page (components/magie/TableauMagiesInnees.astro), la classe raciale d'une race hybride sur la page de la race.
interface Props {
  races: WikiEntry[];
}
const { races } = Astro.props;
---

<ul class="race-list">
  {
    races.map((race) => (
      <li>
        <a class="race-list__nom" href={entryHref(race)}>{race.data.title}</a>
        {race.data.summary && <div class="muted">{race.data.summary}</div>}
      </li>
    ))
  }
</ul>
