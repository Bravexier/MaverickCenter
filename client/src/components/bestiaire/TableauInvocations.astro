---
// Tableau des créatures invoquées (lib/bestiaire-db.mjs#chargerInvocations) : à part des monstres (demande du propriétaire : elles ne fonctionnent pas tout à
// fait pareillement : un sort les appelle, leurs valeurs suivent souvent le niveau de puissance magique, « /NPM »). Comme pour les monstres, peu de colonnes
// (nom, invocation, magies) et la carte de la créature à côté (CarteInvoquee.astro), avec le lien vers le sort qui l'invoque et vers sa page ; filtres sur
// ces colonnes seulement (invocation, magie : « Inutile de filtrer par les colonnes non affichées »).
import Filtres from './Filtres.astro';
import CarteInvoquee from './CarteInvoquee.astro';
import type { chargerInvocations } from '../../lib/bestiaire-db.mjs';
import { couleurDeMagie, texteSurCouleurDeMagie } from '../../lib/sort-format.mjs';
import { url } from '../../lib/wiki';

interface Props {
  invocations: ReturnType<typeof chargerInvocations>;
}
const { invocations } = Astro.props;
const { lignes, facettes } = invocations;
const P = 'i-'; // préfixe de l'état dans l'adresse (le tableau des monstres n'en a pas)

const COLONNES: { cle: string; libelle: string; titre?: string }[] = [
  { cle: 'nom', libelle: 'Nom' },
  { cle: 'invocation', libelle: 'Invocation' },
  { cle: 'magies', libelle: 'Magies', titre: 'La marge du classeur : magie(s) de l’invocation, ou palier EP des marionnettes' },
];
const pastille = (nom: string) => `--m: ${couleurDeMagie(nom)}; --m-texte: ${texteSurCouleurDeMagie(nom)}`;
---

<section class="btableau" data-bestiaire-tableau data-prefixe={P} data-facettes={JSON.stringify(facettes.map((f) => f.cle))} data-tris={JSON.stringify(COLONNES.map((c) => c.cle))} data-singulier="créature" data-pluriel="créatures" aria-label="Créatures invoquées">
  <Filtres
    id="invoquees"
    facettes={facettes}
    recherche="Rechercher une créature invoquée"
    aide="Tous les mots, où qu’ils soient, carte comprise : nom, magie, capacités, effets… Un filtre par colonne ; plusieurs valeurs d’un même filtre : l’une ou l’autre ; plusieurs filtres : tous à la fois."
  />
  <p class="btableau__aide muted">
    {lignes.length} créatures appelées par trois sorts :
    {
      invocations.invocations.map((i, k) => (
        <>
          {k > 0 && (k === invocations.invocations.length - 1 ? ' et ' : ', ')}
          <a href={url(`${i.id}/`)}>{i.nom}</a>
          {i.magie && <span class="muted"> ({i.magie})</span>}
        </>
      ))
    }. « /NPM » : par niveau de puissance magique. <span class="js-seul">Cliquez sur une ligne pour ouvrir sa carte.</span>
  </p>
  <div class="bvue">
    <div class="btableau__defile" tabindex="0" role="region" aria-label="Tableau des créatures invoquées (défile)">
      <table class="btable">
        <thead>
          <tr>
            {
              COLONNES.map((c) => (
                <th scope="col" title={c.titre} data-tri={c.cle} aria-sort="none">
                  {c.libelle}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            lignes.map((l, i) => (
              <tr class="bligne" id={l.ancre} data-ligne data-ordre={i} data-carte={`carte-${l.ancre}`} data-facettes={JSON.stringify(l.facettes)} data-tri={JSON.stringify(l.tri)}>
                <th scope="row" class="bligne__nom">
                  <a class="bligne__ouvrir" href={`#carte-${l.ancre}`} aria-controls={`carte-${l.ancre}`}>
                    {l.nom}
                  </a>
                </th>
                <td>{l.invocation.nom}</td>
                <td class="bligne__magies">
                  <span class="bmagies" title={l.bloc}>
                    {(l.magiesDuBloc.length ? l.magiesDuBloc : l.magies).map((m) => (
                      <span class="bmagie" style={pastille(m)}>
                        {m}
                      </span>
                    ))}
                    {l.magiesDuBloc.length ? /mono/i.test(l.bloc) && <span class="muted"> mono</span> : <span class="muted"> {l.bloc}</span>}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="btableau__vide" data-aucune hidden>Aucune créature invoquée ne correspond à ces critères.</p>
    </div>
    <aside class="bcartes" aria-label="Carte de la créature choisie" data-cartes>
      <p class="bcartes__invite js-seul">Choisissez une créature dans le tableau pour ouvrir sa carte.</p>
      {lignes.map((l) => <CarteInvoquee ligne={l} />)}
    </aside>
  </div>
</section>
