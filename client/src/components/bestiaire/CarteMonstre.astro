---
// Carte d'un monstre du « Bestiaire 2.0 » (demande du propriétaire : « Le reste est dans le détail. Une carte qui s'ouvrira à côté du tableau avec en plus
// un encart pour un portrait (placeholder du logo en attendant) ») : en-tête (nom, espèce, catégorie, type, alignement, échelle), portrait, puis toute la
// carte telle qu'écrite, rubrique par rubrique (lib/monstre-rendu.mjs : tuiles, cases et pastilles quand l'écriture s'y prête), l'espèce (description, lieu
// de rencontre, tableaux qui suivent ses cartes) et le butin. Une espèce sans carte n'a que sa partie « espèce ».
import { CATEGORIES, type chargerMonstres } from '../../lib/bestiaire-db.mjs';
import { htmlDeRubrique } from '../../lib/monstre-rendu.mjs';
import { url } from '../../lib/wiki';

interface Props {
  ligne: ReturnType<typeof chargerMonstres>['lignes'][number];
}
const { ligne: l } = Astro.props;
const c = l.carte;
const id = `carte-${l.ancre}`;
---

<article class="bcarte" id={id} aria-labelledby={`${id}-titre`} data-carte={l.ancre}>
  <header class="bcarte__tete">
    <div class="bcarte__titres">
      <h3 id={`${id}-titre`}>{l.nom}</h3>
      <p class="bcarte__espece">
        {l.espece.nom} <span class="muted">({l.espece.ep})</span>
      </p>
      <p class="bcarte__badges">
        {
          c ? (
            <>
              <span class={`bcat bcat--${c.categorie}`} title={c.categorieBrut}>
                {CATEGORIES[c.categorie as keyof typeof CATEGORIES]}
              </span>
              {c.type && <span class="bbadge">{c.type}</span>}
              {c.alignement && <span class="bbadge">{c.alignement}</span>}
              <span class="bbadge bbadge--ep">Créature échelle {c.echelle}</span>
            </>
          ) : (
            <span class="bbadge">Pas encore de carte de combat dans le doc</span>
          )
        }
      </p>
    </div>
    <figure class="bcarte__portrait">
      <img src={url('logo.webp')} alt="" width="319" height="320" loading="lazy" decoding="async" />
      <figcaption>Portrait à venir</figcaption>
    </figure>
    <a class="bcarte__fermer" href={`#${l.ancre}`} aria-label={`Fermer la carte de ${l.nom}`}>Fermer</a>
  </header>

  {
    c && (
      <section class="bcarte__section" aria-label="La carte">
        {c.variable && <p class="varie-note">Ses stats varient selon son échelle de puissance.</p>}
        <dl class="brubriques">
          {c.rubriques.map((r) => (
            <div class={`brubrique brubrique--${r.rubrique}`}>
              <dt>{r.titre}</dt>
              <dd set:html={htmlDeRubrique(r.rubrique, r.texte)} />
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="bcarte__section" aria-label="L’espèce">
    <h4>{l.espece.nom}</h4>
    {l.espece.description && <p class="texte">{l.espece.description}</p>}
    {
      l.espece.lieu && (
        <p>
          <strong>Lieu de rencontre :</strong> {l.espece.lieu}
        </p>
      )
    }
    {l.espece.complement && <p class="texte">{l.espece.complement}</p>}
    {
      l.espece.blocs.map((b) => (
        <details class="bbloc">
          <summary>{b.titre}</summary>
          <p class="texte">{b.texte}</p>
        </details>
      ))
    }
  </section>

  {
    l.espece.butin.length > 0 && (
      <section class="bcarte__section" aria-label="Butin">
        <h4>
          Butin <span class="muted">(score au 3d100)</span>
        </h4>
        <div class="bbutin__defile">
          <table class="bbutin">
            <thead>
              <tr>
                <th scope="col">Score</th>
                {Object.entries(CATEGORIES).map(([k, v]) => (
                  <th scope="col" class={c?.categorie === k ? 'est-sienne' : undefined}>
                    {v}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {l.espece.butin.map((t) => (
                <tr>
                  <th scope="row" class="nombre">
                    {t.score}
                  </th>
                  {(Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[]).map((k) => (
                    <td class={c?.categorie === k ? 'est-sienne' : undefined}>{t[k] ? <span class="texte">{t[k]}</span> : <span class="vide">—</span>}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</article>
