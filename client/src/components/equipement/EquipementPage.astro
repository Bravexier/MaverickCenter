---
import equipementCss from '../../styles/equipement/equipement.css?raw';
import Onglets from '../Onglets.astro';
import { pageDeLEquipement } from '../../lib/equipement.mjs';

// Le cadre commun des cinq pages de l'équipement (rubrique Équipement du menu ; demande du propriétaire du 2026-10-29 : « Cinq pages séparées », libellés
// « Comme les onglets (pluriel) ») : Armes (src/pages/ressources/armes.astro, components/armes/ArmesPage.astro), Armures et Boucliers
// (ressources/armures.astro, bouclier.astro : components/armures/ArmuresPage.astro, une page chacun), Ceinture (ressources/objets-a-la-ceinture.astro :
// components/ceinture/CeinturePanneau.astro, ses sous-onglets Consommables, Carquois et Bâtons magiques), Accessoires (ressources/accessoires.astro :
// components/accessoires/AccessoiresPage.astro, le générateur d'accessoire). Avant, les cinq onglets d'une seule page « Équipement »
// (/ressources/equipement/, du 2026-10-16 au 2026-10-29), dont l'adresse et les ancres mènent à la bonne page par la page 404
// (lib/equipement.mjs#RENVOIS_DES_PAGES_ECLATEES). Le titre de la page (`h1#titre-<id>`, le nom de la page au menu, qui étiquette son panneau
// `section.equipement-panneau#<id>`), puis son contenu. Pose une fois `components/Onglets.astro` (les menus des familles d'armes, les sous-onglets de la
// ceinture, les onglets d'effets des accessoires ; et `html.js` avant l'affichage) et le CSS commun (styles/equipement/equipement.css, ?raw : les
// panneaux de règles, l'infobulle des tuiles des fiches, la pastille d'une gemme). Chaque page garde son script (src/scripts/armes.mjs, armures.mjs,
// batons.mjs, accessoires.mjs) et son mode modification (src/scripts/edition/armes.mjs, armures.mjs, panneaux.mjs, l'éditeur commun pour les
// consommables).
interface Props {
  /** l'id de la page (lib/equipement.mjs#PAGES_DE_L_EQUIPEMENT : « armes », « boucliers »…) */
  id: string;
}
const { id } = Astro.props;
const page = pageDeLEquipement(id);
if (!page) throw new Error(`[equipement] page inconnue : ${id}`);
---

<style is:inline set:html={equipementCss}></style>
{/* Onglets pose aussi `html.js` avant l'affichage (un panneau fermé n'est caché que sous html.js) */}
<Onglets />
<div class="equipement" data-equipement={page.id}>
  <h1 id={`titre-${page.id}`}>{page.nom} <span class="badge">Ressource</span></h1>
  <slot />
</div>
