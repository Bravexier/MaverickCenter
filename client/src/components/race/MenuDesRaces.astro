---
import MenuLateral from '../guide/MenuLateral.astro';
import { groupRaces } from '../../lib/race-kinds.mjs';
import { TYPES } from '../../lib/types.mjs';
import type { WikiEntry } from '../../lib/wiki';

// Les pages de race, à côté d'un menu latéral de toutes les races (demande du propriétaire : « Je veux comme pour chronologie, et les bases, un menu
// latéral qui récapitule toutes les races sur le menu d'une race ouverte. »). Le menu latéral commun des Bases et des Règles avancées
// (components/guide/MenuLateral.astro, feuille styles/guide/menu-lateral.css), pour une apparence et un comportement identiques : à gauche, en
// vertical, les races de la liste /races/ dans le même ordre (lib/race-kinds.mjs#groupRaces : races pures puis hybrides, ORDRE_DES_RACES), en une
// seule liste sans titre de groupe (réponse du propriétaire : « Une seule liste », comme le menu des Bases), l'entrée affichée marquée
// (aria-current) ; à droite, la page passée en contenu (fil d'Ariane, gabarit RacePage, pied de page). Liens ordinaires : tout se lit sans
// JavaScript. L'accent du site (réponse du propriétaire : « Accent du site »), pas la couleur de la nature. Petit écran (<= 56rem) : le menu replié
// au-dessus de la page (un <details> : « Races » et le nom de la race), ouvert sans JavaScript ; le script en ligne de MenuLateral le replie sur
// petit écran (il n'importe rien, skill site-version-portable).
// `actif` faux (toute autre page servie par pages/[type]/[slug].astro, la race d'exemple sans ligne dans la base) : la page seule, sans menu.
interface Props {
  actif: boolean;
  entry: WikiEntry;
  entries: WikiEntry[];
}
const { actif, entry, entries } = Astro.props;
const races = actif ? groupRaces(entries).flatMap((g) => g.entries) : [];
const rubrique = { titre: TYPES.races.label, chemin: 'races/' };
---

{
  actif ? (
    <MenuLateral rubrique={rubrique} pages={races} entry={entry}>
      <slot />
    </MenuLateral>
  ) : (
    <slot />
  )
}
