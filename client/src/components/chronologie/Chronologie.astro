---
import chronologieCss from '../../styles/chronologie/chronologie.css?raw';
import { adresseDEvenement, couleursDesEvenements, libelleDeDate, voisins } from '../../lib/chronologie.mjs';
import { url } from '../../lib/wiki';
import ChronologieEvenement from './ChronologieEvenement.astro';
import Frise from './Frise.astro';

// L'onglet Chronologie (demande du propriétaire) : sur la gauche, en vertical, la frise (components/chronologie/Frise.astro : une immense barre en
// dégradé, la date à gauche, le titre à droite) ; un clic sur un événement fait apparaître sa page à côté, sur 75 % de la largeur
// (ChronologieEvenement.astro) ; tout à l'extrémité droite, deux chevrons, Haut et Bas, passent à l'événement précédent ou suivant. Sur /chronologie/
// (`id` null), la page laisse la place au mode d'emploi de la frise. Chaque événement a sa propre adresse (/chronologie/<id>/) : un lien se partage,
// et tout se lit sans JavaScript. Entre deux pages de la chronologie, le navigateur fait glisser la nouvelle page (transition entre documents,
// styles/chronologie/chronologie.css) ; la frise, elle, reste en place. Petit écran (demande du propriétaire : « la mini-frise, en plus du
// tiroir ») : /chronologie/ est la frise ; sur la page d'un événement, la frise réduite à sa barre et à ses points reste collée à gauche, un appui
// l'ouvre en grand par-dessus la page (le tiroir), et une barre en bas de l'écran porte les chevrons et, entre eux, la date et le titre de
// l'événement (qui ouvre aussi le tiroir ; sans JavaScript, un lien vers sa ligne de /chronologie/). Couleur de la page : celle de l'événement affiché ; sur
// /chronologie/, celle du premier (une teinte foncée qui porte un texte blanc, dans les deux thèmes : l'accent du site s'éclaircit en sombre).
interface Props {
  /** Les événements dans l'ordre de lecture (lib/chronologie-db.mjs#chargerChronologie). */
  evenements: any[];
  /** L'événement affiché ; null sur /chronologie/. */
  id: string | null;
}
const { evenements, id } = Astro.props;

const couleurs = couleursDesEvenements(evenements);
const { evenement, precedent, suivant } = id ? voisins(evenements, id) : { evenement: null, precedent: null, suivant: evenements[0] ?? null };
const href = (e: any) => url(adresseDEvenement(e.id));
const etiquette = (e: any) => `${libelleDeDate(e)} : ${e.titre}`;
/** La place de l'événement affiché dans l'ordre de lecture (1 à N : le rang n'est que l'ordre à date égale, lib/chronologie.mjs#ordonner). */
const position = evenement ? evenements.indexOf(evenement) + 1 : 0;
/** La place de l'événement affiché dans la frise, pour le filet de la barre du bas (téléphone). */
const progression = evenement ? `${((position / evenements.length) * 100).toFixed(2)}%` : '0%';
---

<style is:inline set:html={chronologieCss}></style>
{/* La mini-frise et le tiroir (téléphone) ne s'affichent qu'avec JavaScript (`html.js`, posée avant la frise : pas de saut au premier affichage) ;
     sans lui, la page d'un événement garde la barre du bas, dont le bouton du milieu mène à la frise de /chronologie/. */}
<script is:inline>
  document.documentElement.classList.add('js');
</script>
<div
  class:list={['chrono', evenement ? 'chrono--evenement' : 'chrono--accueil']}
  data-chrono
  style={(evenement ?? suivant) ? `--couleur-evenement: ${couleurs.get((evenement ?? suivant).id)}` : undefined}
>
  <Frise evenements={evenements} couleurs={couleurs} courant={evenement?.id ?? null} />
  {
    evenement && (
      <button type="button" class="frise-ouvrir" aria-controls="frise" aria-expanded="false" data-frise-ouvrir>
        <span class="frise-ouvrir__poignee" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg></span>
        <span class="chrono-invisible">Ouvrir la frise chronologique (événement {position} sur {evenements.length})</span>
      </button>
    )
  }

  {
    evenement ? (
      <ChronologieEvenement evenement={evenement} position={position} total={evenements.length} />
    ) : (
      <article class="chrono-page chrono-accueil" aria-labelledby="chrono-titre">
        <h1 id="chrono-titre">Chronologie</h1>
        <p class="chrono-accueil__court">Les {evenements.length} événements de la chronologie, du plus ancien au plus récent. Touchez-en un pour lire sa page.</p>
        <p>
          Les {evenements.length} événements de la chronologie, du plus ancien au plus récent : ceux que datent le Codex et les pages de race, et ceux
          ajoutés depuis. Choisissez-en un dans la frise : sa page s’ouvre ici, avec sa description (pour un événement des sources, les passages qui en
          parlent, leur date surlignée), la page qui en dit plus et ses catégories.
        </p>
        <p>
          En haut de la frise, « Catégorie » ne montre que les événements d’une catégorie. Les chevrons, à droite, passent à l’événement précédent ou
          suivant de la catégorie choisie (au clavier : ← et →). Un losange marque un Impact majeur, un point plus grand un Impact mineur, d’après la liste
          « Les Impacts mineur et majeur » du Codex.
        </p>
        {
          suivant && (
            <p>
              <a class="chrono-commencer" href={href(suivant)} data-chrono-commencer>
                Commencer : <span data-chrono-commencer-titre>{suivant.titre}</span>
              </a>
            </p>
          )
        }
      </article>
    )
  }

  {/* Chaque chevron dit l'événement visé dans l'infobulle du site (`title`), placée à sa gauche (`data-placement="cote"` : dessous, la bulle du
       chevron Haut couvrirait le chevron Bas) ; son nom, pour un lecteur d'écran : « Précédent » ou « Suivant », la bulle en description. Au bord, le
       chevron est grisé (un lien sans adresse, `aria-disabled`) ; le script qui suit la barre les réécrit d'après la frise filtrée. */}
  <nav class="chrono-chevrons" aria-label="Parcourir la chronologie" style={`--progression: ${progression}`}>
    {
      precedent ? (
        <a class="chrono-chevron" href={href(precedent)} rel="prev" title={etiquette(precedent)} data-placement="cote" data-chrono-chevron="precedent" data-chrono-precedent>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
          <span class="chrono-invisible" data-chrono-bord>Précédent</span>
        </a>
      ) : (
        <a class="chrono-chevron" role="link" aria-disabled="true" data-placement="cote" data-chrono-chevron="precedent">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
          <span class="chrono-invisible" data-chrono-bord>Précédent ({evenement ? 'premier événement' : 'aucun événement'})</span>
        </a>
      )
    }
    {/* Téléphone : entre les chevrons, l'événement affiché ; un appui ouvre la frise (sans JavaScript : sa ligne de /chronologie/). */}
    {
      evenement && (
        <a class="chrono-barre__frise" href={`${url('chronologie/')}#evenement-${evenement.id}`} aria-controls="frise" data-frise-ouvrir>
          <svg class="chrono-barre__icone" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 2v20M13 6h7M13 12h7M13 18h5" />
            <circle cx="8" cy="6" r="2.4" />
            <rect x="5.9" y="9.9" width="4.2" height="4.2" transform="rotate(45 8 12)" />
            <circle cx="8" cy="18" r="2.4" />
          </svg>
          <span class="chrono-barre__texte">
            <span class="chrono-barre__date">
              {libelleDeDate(evenement)}
              <span class="chrono-barre__rang"> · {position}/{evenements.length}</span>
            </span>
            <span class="chrono-barre__titre">{evenement.titre}</span>
          </span>
          <span class="chrono-invisible"> : toute la frise</span>
        </a>
      )
    }
    {
      suivant ? (
        <a class="chrono-chevron" href={href(suivant)} rel="next" title={etiquette(suivant)} data-placement="cote" data-chrono-chevron="suivant" data-chrono-suivant>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          <span class="chrono-invisible" data-chrono-bord>Suivant</span>
        </a>
      ) : (
        <a class="chrono-chevron" role="link" aria-disabled="true" data-placement="cote" data-chrono-chevron="suivant">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          <span class="chrono-invisible" data-chrono-bord>Suivant (dernier événement)</span>
        </a>
      )
    }
  </nav>
</div>
{evenement && <div class="frise-voile" data-frise-voile hidden />}
<script is:inline>
  // Les chevrons (et ← →, « Commencer ») vont à l'événement précédent ou suivant VISIBLE dans la frise : celle-ci peut être
  // filtrée par catégorie (script de Frise.astro, évènement « chronologie:frise-filtree ») ou complétée par le site de dev. Chaque chevron prend
  // l'adresse de la ligne visée (qui porte déjà le filtre), son étiquette en infobulle (`title` : l'infobulle du site, components/Infobulles.astro) ;
  // sans ligne visée, il est grisé (sans adresse ni `data-chrono-precedent` / `data-chrono-suivant`, que lit le clavier).
  (function () {
    var frise = document.querySelector('[data-frise]');
    if (!frise) return;
    var chevrons = { precedent: document.querySelector('[data-chrono-chevron="precedent"]'), suivant: document.querySelector('[data-chrono-chevron="suivant"]') };
    var commencer = document.querySelector('[data-chrono-commencer]');
    function regler(sens, li, aucun) {
      var a = chevrons[sens];
      if (!a) return;
      var bord = a.querySelector('[data-chrono-bord]');
      if (li) {
        a.href = li.querySelector('.frise__lien').href;
        a.rel = sens === 'precedent' ? 'prev' : 'next';
        a.title = li.getAttribute('data-etiquette') || '';
        a.removeAttribute('role');
        a.removeAttribute('aria-disabled');
        a.setAttribute(sens === 'precedent' ? 'data-chrono-precedent' : 'data-chrono-suivant', '');
        if (bord) bord.textContent = sens === 'precedent' ? 'Précédent' : 'Suivant';
      } else {
        a.removeAttribute('href');
        a.removeAttribute('rel');
        a.title = '';
        a.setAttribute('role', 'link');
        a.setAttribute('aria-disabled', 'true');
        a.removeAttribute(sens === 'precedent' ? 'data-chrono-precedent' : 'data-chrono-suivant');
        if (bord) bord.textContent = aucun ? 'Précédent (aucun événement)' : sens === 'precedent' ? 'Précédent (premier événement)' : 'Suivant (dernier événement)';
      }
    }
    function suivre() {
      var visibles = Array.prototype.slice.call(frise.querySelectorAll('.frise__evenement')).filter(function (li) { return !li.hidden; });
      var actuel = frise.querySelector('[aria-current="page"]');
      var courant = actuel ? actuel.closest('.frise__evenement') : null;
      var i = courant ? visibles.indexOf(courant) : -1;
      if (courant) {
        regler('precedent', visibles[i - 1]);
        regler('suivant', visibles[i + 1]);
      } else {
        // /chronologie/ : rien avant ; « Suivant » et « Commencer » mènent au premier événement visible
        regler('precedent', null, true);
        regler('suivant', visibles[0]);
        if (commencer && visibles[0]) {
          commencer.href = visibles[0].querySelector('.frise__lien').href;
          var titre = commencer.querySelector('[data-chrono-commencer-titre]');
          var texte = visibles[0].querySelector('.frise__titre [data-ed-lecture]');
          if (titre && texte) titre.textContent = texte.textContent;
        }
      }
    }
    suivre();
    document.addEventListener('chronologie:frise-filtree', suivre);
  })();
</script>
<script is:inline>
  // Téléphone, page d'un événement : la mini-frise (la frise réduite à sa barre et à ses points) est fixée au bord gauche de l'écran, de l'en-tête du
  // site (tant qu'il est visible) à la barre du bas ; l'événement affiché est au milieu de sa partie visible, à chaque défilement et changement de
  // taille. Un appui sur elle (le bouton posé dessus) ou sur le milieu de la barre du bas l'ouvre en grand par-dessus la page (le tiroir : dates et
  // titres), centrée sur l'événement ; un appui sur un événement y mène (lien ordinaire) ; la croix, le voile ou Échap la referment. Réduite, la liste
  // est inerte (le bouton la remplace au clavier et pour un lecteur d'écran) ; ouverte, c'est le reste de la page. Retour sur grand écran (rotation
  // d'une tablette) : le tiroir se ferme et la frise d'ordinateur revient sur l'événement affiché.
  (function () {
    var chrono = document.querySelector('.chrono--evenement');
    var frise = document.querySelector('[data-frise]');
    var ouvrir = document.querySelector('.frise-ouvrir');
    var milieu = document.querySelector('.chrono-barre__frise');
    var voile = document.querySelector('[data-frise-voile]');
    if (!chrono || !frise || !ouvrir) return;
    var liste = frise.querySelector('.frise__liste');
    var tete = frise.querySelector('.frise__tete');
    var actuel = frise.querySelector('[aria-current="page"]');
    var barre = document.querySelector('.chrono-chevrons');
    var poignee = ouvrir.querySelector('.frise-ouvrir__poignee');
    var petit = matchMedia('(max-width: 56rem)');
    var ouverte = false;
    var retour = ouvrir;
    var image = 0;
    if (milieu) {
      milieu.setAttribute('role', 'button');
      milieu.setAttribute('aria-expanded', 'false');
    }
    // ce que le tiroir rend inerte : cherché à l'ouverture (le pied de page n'est pas encore lu quand ce script tourne)
    function autour() {
      return [chrono.querySelector('.chrono-page'), barre, ouvrir, document.querySelector('.site-header'), document.querySelector('.site-footer'), document.querySelector('.bandeau-test')];
    }
    // la place de la mini-frise : du haut de la grille (sous l'en-tête) ou du haut de l'écran, jusqu'au bas de la grille ou à la barre du bas
    function placer() {
      var c = chrono.getBoundingClientRect();
      var bas = Math.min(c.bottom, barre ? barre.getBoundingClientRect().top : window.innerHeight);
      chrono.style.setProperty('--mini-haut', Math.max(c.top, 0) + 'px');
      chrono.style.setProperty('--mini-bas', Math.max(window.innerHeight - bas, 0) + 'px');
    }
    // l'événement au milieu de la partie visible : la mini-frise sous sa poignée (sa liste peut dépasser de son cadre), ou la liste du tiroir
    function centrer() {
      if (!actuel || !liste) return;
      var f = (ouverte ? liste : frise).getBoundingClientRect();
      var haut = Math.max(f.top, 0, !ouverte && poignee ? poignee.getBoundingClientRect().bottom + 6 : 0);
      var bas = Math.min(f.bottom, window.innerHeight);
      var r = actuel.getBoundingClientRect();
      liste.scrollTop += r.top + r.height / 2 - (haut + bas) / 2;
    }
    // grand écran : la frise d'ordinateur défile seule ; l'événement au milieu de sa partie visible, sous son en-tête (comme au chargement, Frise.astro)
    function centrerOrdinateur() {
      if (!actuel) return;
      var f = frise.getBoundingClientRect();
      var haut = Math.max(f.top, 0) + (tete ? tete.offsetHeight : 0) + 8;
      var bas = Math.min(f.bottom, window.innerHeight) - 16;
      var r = actuel.getBoundingClientRect();
      frise.scrollTop += r.top - (haut + bas - r.height) / 2;
    }
    function suivre() {
      cancelAnimationFrame(image);
      image = requestAnimationFrame(function () {
        if (!petit.matches || ouverte) return;
        placer();
        centrer();
      });
    }
    function etat() {
      var reduite = petit.matches && !ouverte;
      frise.inert = reduite;
      ouvrir.setAttribute('aria-expanded', String(ouverte));
      if (milieu) milieu.setAttribute('aria-expanded', String(ouverte));
      if (reduite) {
        placer();
        centrer();
      }
    }
    function basculer(oui, depuis) {
      if (oui === ouverte) return;
      ouverte = oui;
      if (oui) retour = depuis || ouvrir;
      frise.classList.toggle('est-ouverte', oui);
      document.documentElement.classList.toggle('frise-ouverte', oui);
      if (voile) voile.hidden = !oui;
      autour().forEach(function (el) { if (el) el.inert = oui; });
      etat();
      if (oui) {
        centrer();
        if (actuel) actuel.focus({ preventScroll: true });
      } else if (petit.matches) {
        retour.focus({ preventScroll: true });
      }
    }
    ouvrir.addEventListener('click', function () { basculer(true, ouvrir); });
    if (milieu) {
      milieu.addEventListener('click', function (e) {
        if (!petit.matches) return;
        e.preventDefault();
        basculer(true, milieu);
      });
      // annoncé comme un bouton : Espace l'ouvre aussi (sur un lien, Espace ferait défiler la page)
      milieu.addEventListener('keydown', function (e) {
        if (e.key !== ' ' || !petit.matches) return;
        e.preventDefault();
        basculer(true, milieu);
      });
    }
    if (voile) voile.addEventListener('click', function () { basculer(false); });
    frise.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-frise-fermer]')) basculer(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && ouverte) basculer(false);
    });
    petit.addEventListener('change', function () {
      if (!petit.matches) {
        basculer(false);
        requestAnimationFrame(centrerOrdinateur);
      }
      etat();
    });
    addEventListener('scroll', suivre, { passive: true });
    addEventListener('resize', suivre);
    // retour arrière vers une page gardée en mémoire (bfcache) : le tiroir fermé
    window.addEventListener('pageshow', function () {
      basculer(false);
      etat();
    });
    etat();
  })();
</script>
<script is:inline>
  // ← et → : événement précédent ou suivant (les chevrons), sauf pendant une saisie ou avec une touche de modification. ↑ et ↓ gardent leur rôle :
  // faire défiler la page ou la frise. Plus de glissement du doigt (réponse du propriétaire du 2026-10-22 : « Supprime juste le swipe. ») : sur un
  // écran tactile, les chevrons ; le retour arrière du navigateur au glissement horizontal est empêché pour tout le site (styles/global/base.css).
  document.addEventListener('keydown', function (e) {
    var sens = { ArrowLeft: '[data-chrono-precedent]', ArrowRight: '[data-chrono-suivant]' }[e.key];
    if (!sens || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    if (document.documentElement.classList.contains('frise-ouverte')) return; // tiroir ouvert (téléphone) : la page derrière est inerte
    var cible = e.target;
    if (cible && cible.closest && cible.closest('input, textarea, select, [contenteditable]')) return;
    var lien = document.querySelector(sens);
    if (lien) location.href = lien.href;
  });
</script>
