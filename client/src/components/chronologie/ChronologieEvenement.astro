---
import chronologieCss from '../../styles/chronologie/chronologie.css?raw';
import magieTooltipsCss from '../../styles/magie/tooltips.css?raw';
import { adresseDEvenement, extraitsParPage, libelleDeDate, marquerLaDate, periodeDe, periodesDeLaFrise, PORTEES, surlignerLaDate, titreDeSection, voisins } from '../../lib/chronologie.mjs';
import { rendreMarkdown } from '../../lib/guide-rendu';
import { pageHref } from '../../lib/magies';
import { url } from '../../lib/wiki';
import Bulles from '../magie/Bulles.astro';
import Frise from './Frise.astro';

// Un événement de la chronologie (lib/chronologie.mjs) : une page à la fois, comme un chapitre du guide (components/guide/GuideChapitre.astro, dont la
// mise en page et les gestes sont repris : flèches Précédent / Suivant par-dessus les bords de la page, en bas de l'écran, effacées quand les liens du
// bas arrivent ; ← → au clavier ; glissement du doigt sur écran tactile), mais avec une frise en haut et en bas au lieu de la pagination numérotée
// (demande du propriétaire). La page dit la date, le titre, la portée et le lieu d'un Impact du Codex, puis les extraits copiés des pages sources,
// regroupés par page, la date de chacun surlignée, et un lien vers la page. Couleur de la page : celle de sa période sur la frise.
interface Props {
  /** Les événements dans l'ordre de lecture (lib/chronologie-db.mjs#chargerChronologie). */
  evenements: any[];
  id: string;
}
const { evenements, id } = Astro.props;

const { evenement, precedent, suivant } = voisins(evenements, id);
const periodes = periodesDeLaFrise(evenements);
const periode = periodeDe(periodes, id);
const groupes = await Promise.all(
  extraitsParPage(evenement.extraits).map(async (g) => ({
    ...g,
    extraits: await Promise.all(
      g.extraits.map(async (x: any) => ({ ...x, html: surlignerLaDate(await rendreMarkdown(marquerLaDate(x.texte, x.date_brut), x.page_id)) })),
    ),
  })),
);
const href = (e: any) => url(adresseDEvenement(evenements, e.id));
const etiquette = (e: any) => `${libelleDeDate(e)} : ${e.titre}`;
/** Les sections de la page d'où viennent les extraits d'un groupe, dans l'ordre, sans doublon (légende sous le groupe). */
const sections = (g: any) => [...new Set(g.extraits.map((x: any) => x.section).filter(Boolean).map(titreDeSection))];
const css = [chronologieCss, magieTooltipsCss].join('\n');
---

<style is:inline set:html={css}></style>
<div class="chrono" data-chrono style={`--couleur-periode: ${periode.couleur}`}>
  <Frise evenements={evenements} periodes={periodes} courant={evenement.id} position="haut" />

  <div class="chrono-cadre">
    {
      precedent ? (
        <a class="chrono-fleche chrono-fleche--precedent" href={href(precedent)} rel="prev" title={etiquette(precedent)} data-chrono-precedent>
          <span aria-hidden="true">‹</span>
          <span class="chrono-invisible">Précédent : {etiquette(precedent)}</span>
        </a>
      ) : (
        <span class="chrono-fleche chrono-fleche--precedent" role="link" aria-disabled="true" title="Premier événement">
          <span aria-hidden="true">‹</span>
          <span class="chrono-invisible">Précédent (premier événement)</span>
        </span>
      )
    }

    <article class="chrono-page" aria-labelledby="chrono-titre">
      <p class="chrono-numero">
        {periode.epoque === 'datee' && <span class="chrono-periode" title={periode.description}>{periode.libelle}</span>} Chronologie · événement {evenement.rang} sur {evenements.length}
      </p>
      <p class="chrono-date">{libelleDeDate(evenement)}</p>
      <h1 id="chrono-titre">{evenement.titre}</h1>
      {
        (evenement.portee || evenement.lieu) && (
          <p class="chrono-etiquettes">
            {evenement.portee && <span class={`chrono-portee chrono-portee--${evenement.portee}`}>{PORTEES[evenement.portee]}</span>}
            {evenement.lieu &&
              (evenement.lieu_page_id ? (
                <a class="chrono-lieu" href={pageHref(evenement.lieu_page_id)}>{evenement.lieu}</a>
              ) : (
                <span class="chrono-lieu">{evenement.lieu}</span>
              ))}
          </p>
        )
      }
      {
        groupes.map((g) => (
          <figure class="chrono-source">
            {g.extraits.map((x: any) => (
              <blockquote class="chrono-extrait" set:html={x.html} />
            ))}
            <figcaption class="chrono-legende">
              <a href={pageHref(g.page_id)}>{g.page_titre}</a>
              {sections(g).length > 0 && <span class="chrono-legende__sections">· {sections(g).join(', ')}</span>}
            </figcaption>
          </figure>
        ))
      }
    </article>

    {
      suivant ? (
        <a class="chrono-fleche chrono-fleche--suivant" href={href(suivant)} rel="next" title={etiquette(suivant)} data-chrono-suivant>
          <span aria-hidden="true">›</span>
          <span class="chrono-invisible">Suivant : {etiquette(suivant)}</span>
        </a>
      ) : (
        <span class="chrono-fleche chrono-fleche--suivant" role="link" aria-disabled="true" title="Dernier événement">
          <span aria-hidden="true">›</span>
          <span class="chrono-invisible">Suivant (dernier événement)</span>
        </span>
      )
    }
  </div>

  <nav class="chrono-voisins" aria-label="Événements voisins">
    {
      precedent ? (
        <a class="chrono-voisin chrono-voisin--precedent" href={href(precedent)} rel="prev">
          <span class="chrono-voisin__sens">‹ Précédent · {libelleDeDate(precedent)}</span>
          <span class="chrono-voisin__titre">{precedent.titre}</span>
        </a>
      ) : (
        <span class="chrono-voisin chrono-voisin--precedent" aria-disabled="true">
          <span class="chrono-voisin__sens">‹ Précédent</span>
        </span>
      )
    }
    {
      suivant ? (
        <a class="chrono-voisin chrono-voisin--suivant" href={href(suivant)} rel="next">
          <span class="chrono-voisin__sens">{libelleDeDate(suivant)} · Suivant ›</span>
          <span class="chrono-voisin__titre">{suivant.titre}</span>
        </a>
      ) : (
        <span class="chrono-voisin chrono-voisin--suivant" aria-disabled="true">
          <span class="chrono-voisin__sens">Suivant ›</span>
        </span>
      )
    }
  </nav>

  <Frise evenements={evenements} periodes={periodes} courant={evenement.id} position="bas" />
</div>
<Bulles />
<script is:inline>
  // Chaque frise défile de côté : l'événement affiché y est centré (scrollLeft, pas scrollIntoView, qui ferait aussi défiler la page). Un point qui
  // prend le focus au clavier près d'un bord est ramené hors du voile de ce bord (le navigateur ne fait pas défiler un point encore en partie visible).
  (function () {
    var marge = 32;
    function montrer(piste, point, centrer) {
      var a = piste.getBoundingClientRect();
      var b = point.getBoundingClientRect();
      if (centrer) piste.scrollLeft += b.left - a.left - (piste.clientWidth - b.width) / 2;
      else if (b.left < a.left + marge) piste.scrollLeft -= a.left + marge - b.left;
      else if (b.right > a.right - marge) piste.scrollLeft += b.right - (a.right - marge);
    }
    var frises = document.querySelectorAll('[data-frise]');
    for (var i = 0; i < frises.length; i += 1) {
      var piste = frises[i];
      var point = piste.querySelector('[data-frise-actuel]');
      if (point) montrer(piste, point, true);
      piste.addEventListener('focusin', function (e) {
        montrer(e.currentTarget, e.target, false);
      });
    }
  })();

  // ← et → : événement précédent ou suivant, sauf pendant une saisie, dans une frise (les flèches la font défiler) ou avec une touche de modification.
  document.addEventListener('keydown', function (e) {
    var sens = { ArrowLeft: '[data-chrono-precedent]', ArrowRight: '[data-chrono-suivant]' }[e.key];
    if (!sens || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    var cible = e.target;
    if (cible && cible.closest && cible.closest('input, textarea, select, [contenteditable], [data-frise]')) return;
    var lien = document.querySelector(sens);
    if (lien) location.href = lien.href;
  });

  // Écran tactile : glisser le doigt vers la gauche tourne la page (événement suivant), vers la droite revient au précédent, comme dans le guide :
  // geste franchement horizontal (2 fois plus large que haut, 60 px ou le quart de l'écran), d'un seul doigt, hors des frises (elles défilent), d'un
  // champ, d'une sélection de texte, d'une page zoomée et du bord de l'écran. La page suit un peu le doigt, sauf mouvement réduit.
  (function () {
    var page = document.querySelector('.chrono-page');
    if (!page) return;
    var calme = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var depart = null;
    function voisin(dx) {
      return document.querySelector(dx < 0 ? '[data-chrono-suivant]' : '[data-chrono-precedent]');
    }
    function selection() {
      return window.getSelection && String(window.getSelection()) !== '';
    }
    // Décalage borné à 64 px : au-delà de la marge de <main>, la page est coupée (overflow-x: clip, styles/chronologie/chronologie.css).
    function decaler(x, transition, opacite) {
      if (calme) return;
      x = Math.max(-64, Math.min(64, x));
      page.style.transition = transition;
      page.style.transform = x ? 'translateX(' + x + 'px)' : '';
      page.style.opacity = opacite || '';
    }
    document.addEventListener('touchstart', function (e) {
      depart = null;
      var t = e.touches[0];
      var cible = e.target;
      if (e.touches.length !== 1 || !cible.closest || !cible.closest('[data-chrono]') || selection()) return;
      if (cible.closest('input, textarea, select, [contenteditable], [data-frise]')) return;
      if (window.visualViewport && visualViewport.scale > 1.01) return;
      if (t.clientX < 24 || t.clientX > window.innerWidth - 24) return;
      depart = { x: t.clientX, y: t.clientY, horizontal: null };
    }, { passive: true });
    document.addEventListener('touchmove', function (e) {
      if (!depart) return;
      if (e.touches.length !== 1) {
        depart = null;
        decaler(0, 'transform 0.2s ease');
        return;
      }
      var dx = e.touches[0].clientX - depart.x;
      var dy = e.touches[0].clientY - depart.y;
      if (depart.horizontal === null && Math.abs(dx) + Math.abs(dy) > 12) depart.horizontal = Math.abs(dx) > 2 * Math.abs(dy);
      if (depart.horizontal) decaler(dx * (voisin(dx) ? 0.35 : 0.1), 'none');
    }, { passive: true });
    document.addEventListener('touchend', function (e) {
      if (!depart) return;
      var t = e.changedTouches[0];
      var dx = t.clientX - depart.x;
      var dy = t.clientY - depart.y;
      var lien = voisin(dx);
      var tourne = depart.horizontal && lien && Math.abs(dx) >= Math.max(60, window.innerWidth / 4) && Math.abs(dx) > 2 * Math.abs(dy) && !selection();
      depart = null;
      if (!tourne) {
        decaler(0, 'transform 0.2s ease');
        return;
      }
      decaler(dx < 0 ? -64 : 64, 'transform 0.15s ease, opacity 0.15s ease', '0.4');
      location.href = lien.href;
    }, { passive: true });
    document.addEventListener('touchcancel', function () {
      if (depart) decaler(0, 'transform 0.2s ease');
      depart = null;
    }, { passive: true });
    window.addEventListener('pageshow', function () {
      decaler(0, '');
    });
  })();

  // Les flèches de côté s'effacent dès que les liens du bas (Précédent / Suivant avec la date et le titre) arrivent à l'écran.
  (function () {
    var chrono = document.querySelector('[data-chrono]');
    var bas = document.querySelector('.chrono-voisins');
    if (!chrono || !bas || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (entrees) {
      chrono.toggleAttribute('data-bas-visible', entrees[entrees.length - 1].isIntersecting);
    }).observe(bas);
  })();
</script>
