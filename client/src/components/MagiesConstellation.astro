---
import { couleurDeMagie } from '../lib/sort-format.mjs';
import { normalize } from '../lib/text.mjs';
import { entryHref, type WikiEntry } from '../lib/wiki';
import type { MagieDb } from '../lib/magies';

interface Props {
  magies: { entry: WikiEntry; magie: MagieDb }[];
}

const { magies } = Astro.props;
const disposition = [
  { cle: 'Potentiel Illimité', nom: 'Potentiel Illimité', region: 'potentiel', x: 500, y: 65, mx: 500, my: 55 },
  { cle: 'Arcane', nom: 'Arcane', region: 'primordiale', x: 415, y: 270, mx: 270, my: 245 },
  { cle: 'Corruption', nom: 'Corruption', region: 'primordiale', x: 305, y: 190, mx: 270, my: 145 },
  { cle: 'Espace/Temps', nom: 'Espace-Temps', region: 'primordiale', x: 585, y: 270, mx: 730, my: 245 },
  { cle: 'Vide', nom: 'Vide', region: 'primordiale', x: 695, y: 190, mx: 730, my: 145 },
  { cle: 'Nécromancie', nom: 'Nécromancie', region: 'primordiale', x: 305, y: 470, mx: 270, my: 345 },
  { cle: 'Sang', nom: 'Sang', region: 'primordiale', x: 415, y: 390, mx: 270, my: 445 },
  { cle: 'Lumière', nom: 'Lumière', region: 'lumiere-ombre', x: 585, y: 390, mx: 730, my: 345 },
  { cle: 'Ombre', nom: 'Ombre', region: 'lumiere-ombre', x: 695, y: 470, mx: 730, my: 445 },
  { cle: 'Feu', nom: 'Feu', region: 'elementaire', x: 425, y: 585, mx: 500, my: 565 },
  { cle: 'Eau', nom: 'Eau', region: 'elementaire', x: 575, y: 585, mx: 250, my: 670 },
  { cle: 'Glace', nom: 'Glace', region: 'elementaire', x: 745, y: 725, mx: 750, my: 670 },
  { cle: 'Terre', nom: 'Terre', region: 'elementaire', x: 575, y: 855, mx: 250, my: 770 },
  { cle: 'Vent', nom: 'Vent', region: 'elementaire', x: 425, y: 855, mx: 750, my: 770 },
  { cle: 'Foudre', nom: 'Foudre', region: 'elementaire', x: 255, y: 725, mx: 500, my: 870 },
];

const index = new Map(magies.map((item) => [normalize(item.magie.nom), item]));
const phraseCourte = (magie: MagieDb) => {
  const texte = magie.description
    .flatMap((bloc: any) => (bloc.liste ? bloc.items : [bloc.texte]))
    .filter(Boolean)
    .join(' ')
    .replace(/\s+/g, ' ')
    .trim();
  const phrase = texte.match(/^.*?[.!?](?=\s|$)/u)?.[0] ?? texte;
  return phrase.length <= 190 ? phrase : `${phrase.slice(0, 187).replace(/\s+\S*$/u, '')}…`;
};

const noeuds = disposition.flatMap((place, ordre) => {
  const item = index.get(normalize(place.cle));
  const alignementTooltip = place.mx < 400 ? 'gauche' : place.mx > 600 ? 'droite' : 'centre';
  return item ? [{ ...place, ...item, ordre, alignementTooltip, description: phraseCourte(item.magie), couleur: couleurDeMagie(item.magie.nom) }] : [];
});
const parNom = new Map(noeuds.map((noeud) => [normalize(noeud.cle), noeud]));
const liens: { a: any; b: any; type: string }[] = [];
const ajouterLien = (a: any, b: any, type: string) => {
  if (a && b) liens.push({ a, b, type });
};
const incompatible = (a: any, b: any) => a.magie.incompatibles.includes(b.magie.id) || b.magie.incompatibles.includes(a.magie.id);
const vulnérableÀ = (a: any, b: any) => a.magie.resistances.vulnerabilite.magies.some((r: any) => r.id === b.magie.id);

for (const [gauche, droite] of [['Arcane', 'Corruption'], ['Espace/Temps', 'Vide'], ['Nécromancie', 'Sang']]) {
  const a = parNom.get(normalize(gauche));
  const b = parNom.get(normalize(droite));
  if (a && b && incompatible(a, b)) ajouterLien(a, b, 'incompatible');
}

const lumiere = parNom.get(normalize('Lumière'));
const ombre = parNom.get(normalize('Ombre'));
if (lumiere && ombre && (vulnérableÀ(lumiere, ombre) || vulnérableÀ(ombre, lumiere))) ajouterLien(lumiere, ombre, 'opposition');
---

<div class="magies-orbite" role="group" aria-label="Carte des magies">
  <svg class="magies-orbite__liens" viewBox="0 0 1000 920" preserveAspectRatio="none" aria-hidden="true">
    {
      liens.map(({ a, b, type }) => (
        <g class={`magies-orbite__lien magies-orbite__lien--${type}`}>
          <line class="magies-orbite__lien--grand" x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
          <line class="magies-orbite__lien--petit" x1={a.mx} y1={a.my} x2={b.mx} y2={b.my} />
        </g>
      ))
    }
  </svg>
  <ul class="magies-orbite__liste">
    {
      noeuds.map((noeud) => (
        <li
          class={`magies-orbite__position magies-orbite__position--${noeud.region} magies-orbite__position--tooltip-${noeud.alignementTooltip}`}
          style={`--x: ${noeud.x / 10}%; --y: ${noeud.y / 9.2}%; --mx: ${noeud.mx / 10}%; --my: ${noeud.my / 9.2}%; --couleur-magie: ${noeud.couleur}; --ordre: ${noeud.ordre}`}
        >
          <a
            class="magies-orbite__noeud"
            href={entryHref(noeud.entry)}
            data-tooltip={noeud.description}
            aria-label={noeud.nom}
            aria-description={noeud.description}
          >
            <span class="magies-orbite__pastille" aria-hidden="true" />
            <span class="magies-orbite__nom">{noeud.nom}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .magies-orbite {
    position: relative;
    width: 100%;
    max-width: 68rem;
    aspect-ratio: 1000 / 920;
    min-height: 48rem;
    margin: 1.5rem auto 0;
    overflow: visible;
    isolation: isolate;
  }

  .magies-orbite__liens,
  .magies-orbite__liste {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .magies-orbite__liens { z-index: -1; }
  .magies-orbite__liste { margin: 0; padding: 0; list-style: none; }
  .magies-orbite__lien line { vector-effect: non-scaling-stroke; stroke-width: 1.5; }
  .magies-orbite__lien--incompatible line { stroke: var(--muted); stroke-dasharray: 3 6; opacity: 0.55; }
  .magies-orbite__lien--opposition line { stroke: var(--danger); stroke-dasharray: 7 5; opacity: 0.5; }
  .magies-orbite__lien--affinite line { stroke: var(--good); opacity: 0.55; }
  .magies-orbite__lien--petit { display: none; }

  .magies-orbite__position {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: var(--ordre);
    width: min(9rem, 16vw);
    transform: translate(-50%, -50%);
  }

  .magies-orbite__position--potentiel { width: min(12rem, 32vw); }

  .magies-orbite__position:hover,
  .magies-orbite__position:focus-within { z-index: 1000; }

  .magies-orbite__noeud {
    position: relative;
    display: flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--couleur-magie) 68%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--couleur-magie) 10%, var(--surface));
    box-shadow: 0 2px 10px color-mix(in srgb, var(--text) 10%, transparent);
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .magies-orbite__pastille {
    flex: 0 0 0.65rem;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid color-mix(in srgb, var(--text) 28%, var(--couleur-magie));
    border-radius: 50%;
    background: var(--couleur-magie);
  }

  .magies-orbite__nom { overflow-wrap: anywhere; }

  .magies-orbite__noeud::after {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 50%;
    z-index: 5;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
    color: var(--text);
    content: attr(data-tooltip);
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: left;
    transform: translate(-50%, 0.25rem);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease, transform 120ms ease, visibility 120ms;
  }

  .magies-orbite__position--potentiel .magies-orbite__noeud::after {
    top: calc(100% + 0.6rem);
    bottom: auto;
  }

  .magies-orbite__noeud:hover,
  .magies-orbite__noeud:focus-visible {
    z-index: 6;
    outline: 2px solid var(--couleur-magie);
    outline-offset: 3px;
    box-shadow: 0 5px 18px color-mix(in srgb, var(--couleur-magie) 25%, transparent);
    transform: translateY(-2px);
  }

  .magies-orbite__noeud:hover::after,
  .magies-orbite__noeud:focus-visible::after {
    transform: translate(-50%, 0);
    visibility: visible;
    opacity: 1;
  }

  @media (max-width: 44rem) {
    .magies-orbite { height: 57.5rem; min-height: 0; aspect-ratio: auto; }
    .magies-orbite__lien--grand { display: none; }
    .magies-orbite__lien--petit { display: initial; }
    .magies-orbite__position { left: var(--mx); top: var(--my); width: min(9rem, calc(50vw - 1.2rem)); }
    .magies-orbite__position--potentiel { width: min(12rem, calc(80vw - 1.5rem)); }
    .magies-orbite__position--tooltip-gauche .magies-orbite__noeud::after { left: 0; transform: translateY(0.25rem); }
    .magies-orbite__position--tooltip-droite .magies-orbite__noeud::after { right: 0; left: auto; transform: translateY(0.25rem); }
    .magies-orbite__noeud:hover::after,
    .magies-orbite__noeud:focus-visible::after { transform: translateY(0); }
    .magies-orbite__position--tooltip-centre .magies-orbite__noeud:hover::after,
    .magies-orbite__position--tooltip-centre .magies-orbite__noeud:focus-visible::after { transform: translate(-50%, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .magies-orbite__noeud,
    .magies-orbite__noeud::after { transition: none; }
  }
</style>