---
import { TYPES } from '../lib/types.mjs';
import { entryHref, typeOf, type WikiEntry } from '../lib/wiki';

interface Props {
  entries: WikiEntry[];
  showType?: boolean;
}
const { entries, showType = true } = Astro.props;
---

<ul class="entry-list">
  {
    entries.map((entry) => (
      <li>
        <a href={entryHref(entry)}>{entry.data.title}</a>
        {showType && <span class="badge">{TYPES[typeOf(entry)].singular}</span>}
        {entry.data.summary && <div class="muted">{entry.data.summary}</div>}
      </li>
    ))
  }
</ul>
