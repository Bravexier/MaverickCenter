---
import { pageHref, sortAncre, type Magies, type SortDb } from '../lib/magies';
import { lignesDeStat } from '../lib/sort-format.mjs';
import Texte from './Texte.astro';

// Détails d'un sort, affichés juste sous sa ligne quand on la sélectionne : ses effets (le texte des effets secondaires, puis la remarque du classeur
// (note de cellule) et le texte du sort de niveau 5, à la ligne, dans le même cadre ; les altérations d'état y sont des pastilles avec infobulle, placées
// dans le texte) et, quand le sort a **ses propres règles**, un bloc dédié : pour une invocation, ses règles (repliées), les créatures invoquées et,
// au clic sur l'une d'elles, sa fiche minimale (stats et capacités) sous la liste.
interface Props {
  sort: SortDb;
  magies: Magies;
}
const { sort, magies } = Astro.props;

// Altérations d'état à placer dans le texte des effets ; chacune n'est placée qu'une fois (la liste est consommée par Texte.astro)
const aPlacer = sort.etats.filter((e) => e.champ === 'effets');
const memeNom = sort.memeNom.map((id) => magies.sorts.get(id)!).map((o) => ({ sort: o, magie: magies.magies.get(o.magieId)! }));
const aDesEffets = sort.effets.length > 0 || sort.remarque.length > 0 || Boolean(sort.incantation);
---

<div class="sort-detail" role="region" aria-labelledby={`detail-${sort.slug}-titre`}>
  <header class="sort-detail__tete">
    <h4 id={`detail-${sort.slug}-titre`}>{sort.nom}</h4>
    <button type="button" class="sort-detail__fermer" aria-label={`Fermer les détails de ${sort.nom}`}>Fermer</button>
  </header>

  {
    aDesEffets && (
      <section class="sort-detail__bloc">
        <h5>Effets</h5>
        <Texte blocs={sort.effets} etats={aPlacer} {magies} />
        {sort.remarque.length > 0 && <Texte blocs={sort.remarque} etats={aPlacer} {magies} />}
        {sort.incantation && <blockquote class="incantation"><Texte blocs={sort.incantation} /></blockquote>}
      </section>
    )
  }

  {
    sort.invoque.map((i) => (
      <section class="sort-detail__regles">
        <h5>Règles propres : invocation</h5>
        {(i.texte.length > 0 || i.remarque.length > 0) && (
          <details class="regles-texte">
            <summary>Règles de l’invocation</summary>
            <Texte blocs={i.texte} />
            {i.remarque.length > 0 && <Texte blocs={i.remarque} />}
          </details>
        )}
        {i.tableau && i.tableau.lignes.length > 0 && (
          <details class="regles-texte">
            <summary>{i.tableau.titre}</summary>
            <div class="sorts-wrap">
              <table class="annexe">
                <thead><tr><th scope="col">Amélioration</th><th scope="col">Effet</th></tr></thead>
                <tbody>
                  {i.tableau.lignes.map((a) => (
                    <tr>
                      <th scope="row">{a.nom}</th>
                      <td>{a.effets.length > 1 ? <ul>{a.effets.map((e: string) => <li>{e}</li>)}</ul> : a.effets[0]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}
        <h6 class="texte-titre">Créatures invoquées ({i.creatures.length})</h6>
        <ul class="invoque">
          {[...new Set(i.creatures.map((c) => c.bloc))].map((bloc) => (
            <li>
              <span class="invoque__bloc">{bloc}</span>
              <span class="invoque__creatures">
                {i.creatures.filter((c) => c.bloc === bloc).map((c) => (
                  <span class="creature">
                    <button type="button" class="chip creature__bouton" aria-expanded="false" aria-controls={`fiche-${c.id.split('/')[1]}`}>{c.nom}</button>
                    <a class="creature__lien" href={pageHref(c.id)} title={`Page de ${c.nom} dans le bestiaire`}>Bestiaire</a>
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ul>
        <div class="creature__fiches">
          {i.creatures.map((c) => (
            <article class="creature__fiche" id={`fiche-${c.id.split('/')[1]}`} hidden>
              <h6>{c.nom}</h6>
              <div class="creature__colonnes">
                <section>
                  <h6 class="texte-titre">Stats</h6>
                  <dl class="creature__stats">
                    {c.stats.map((st) => (
                      <div>
                        <dt>{st.libelle}</dt>
                        <dd>{lignesDeStat(st.brut).map((l) => <span class="creature__ligne">{l}</span>)}</dd>
                      </div>
                    ))}
                    {c.caracteristiques.length > 0 && (
                      <div>
                        <dt>Caractéristiques</dt>
                        <dd>{c.caracteristiques.map((k) => <span class="creature__ligne">{k.nom} <span class="val">{k.valeur}</span></span>)}{c.bonus.map((b) => <span class="creature__ligne muted">{b}</span>)}</dd>
                      </div>
                    )}
                  </dl>
                </section>
                <section>
                  <h6 class="texte-titre">Capacités</h6>
                  {c.capacites.length === 0 ? (
                    <p class="muted">Aucune</p>
                  ) : (
                    <ul class="creature__capacites">
                      {c.capacites.map((k) => (
                        <li>
                          <strong>{k.nom}</strong>
                          {k.npmMin ? <span class="repere">NPM {k.npmMin}</span> : null}
                          <Texte blocs={k.blocs} />
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  {
    sort.effetsDeCarte.map((e) => (
      <section class="sort-detail__regles">
        <h5>Règles propres : {e.libelle}</h5>
        <p>Carte de <a href={pageHref(e.id)}>{e.nom}</a></p>
        <Texte blocs={e.blocs} />
      </section>
    ))
  }

  {
    memeNom.length > 0 && (
      <section class="sort-detail__bloc">
        <h5>Même nom dans une autre magie</h5>
        <ul class="chips">
          {memeNom.map((o) => <li><a class="chip" href={`${pageHref(o.magie.id)}#${sortAncre(o.sort)}`}>{o.magie.nom}</a></li>)}
        </ul>
      </section>
    )
  }
</div>
