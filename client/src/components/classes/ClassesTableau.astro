---
import listeCss from '../../styles/classe/liste.css?raw';
import magieTooltipsCss from '../../styles/magie/tooltips.css?raw';
import { CLASS_COLORS, classLabel, type groupClasses } from '../../lib/class-groups.mjs';
import { idBulle } from '../../lib/magies';
import { texteSurCouleur } from '../../lib/sort-format.mjs';
import { entryHref } from '../../lib/wiki';
import Bulles from '../magie/Bulles.astro';

// Tableau de /wiki/classes/ : les cinq catégories (lib/class-groups.mjs) côte à côte, une colonne chacune, dans la couleur de la catégorie
// (celle des pages de classe). Le nom d'une classe est écrit sans « (classe) » ; son résumé est dans une infobulle (components/magie/Bulles.astro ;
// sans JavaScript, l'attribut `title` du lien en tient lieu). Sur un écran étroit, les colonnes passent à la ligne.
interface Props {
  groups: ReturnType<typeof groupClasses>;
}
const { groups } = Astro.props;
const css = [listeCss, magieTooltipsCss].join('\n');
const compte = (group: Props['groups'][number]) => group.sections.reduce((n, s) => n + s.entries.length, 0);
---

<style is:inline set:html={css}></style>
<div class="classes-tableau" style={`--colonnes: ${groups.length}`}>
  {
    groups.map((group) => (
      <section
        class="classes-colonne"
        id={group.key}
        style={`--couleur-classe: ${CLASS_COLORS[group.key]}; --couleur-texte-classe: ${texteSurCouleur(CLASS_COLORS[group.key])}`}
      >
        <h2 class="classes-colonne__titre">
          {group.label} <span class="classes-colonne__compte">{compte(group)}</span>
        </h2>
        <div class="classes-colonne__corps">
          {group.sections.map((section) => (
            <>
              {section.label && <h3 id={section.key}>{section.label}</h3>}
              <ul>
                {section.entries.map((entry) => {
                  const resume = entry.data.summary;
                  const id = resume ? idBulle('classe') : null;
                  return (
                    <li>
                      {id ? (
                        <span class="bulle-zone">
                          <a href={entryHref(entry)} data-bulle={id} aria-describedby={id} title={resume}>
                            {classLabel(entry)}
                          </a>
                          <span class="bulle" role="tooltip" id={id} hidden>
                            {resume}
                          </span>
                        </span>
                      ) : (
                        <a href={entryHref(entry)}>{classLabel(entry)}</a>
                      )}
                    </li>
                  );
                })}
              </ul>
            </>
          ))}
        </div>
      </section>
    ))
  }
</div>
<Bulles />
