---
import { alternativesOf, capacitesOfClass, nomCapacite, nomsSeRepondent } from '../../lib/capacites.mjs';
import { isMagicalClass } from '../../lib/classe-magique.mjs';
import { entryHref, type WikiEntry } from '../../lib/wiki';

interface Props {
  entry: WikiEntry;
  entries: WikiEntry[];
}
const { entry, entries } = Astro.props;
const d = entry.data;
const classEntry = entries.find((e) => e.id === d.classe);
const alternatives = alternativesOf(entries, entry);
const cartouche = d.nature === 'choix' && d.specialite && classEntry ? capacitesOfClass(entries, classEntry).specialites.find((s) => s.nom === d.specialite)?.cartouche : null;
const estClasseMagique = classEntry && d.nature === 'specialite' && isMagicalClass(entries, classEntry, entry);
const nom = nomCapacite;
const repond = alternatives.filter((a) => nomsSeRepondent(entry, a));
const natureLabel = { classe: 'Capacité de classe', specialite: 'Spécialité', choix: 'Au choix' }[d.nature as string];
---

<section class="relations" aria-label="Choix et prérequis">
  <ul class="cap-facts">
    {classEntry && <li><strong>Classe</strong> : <a href={entryHref(classEntry)}>{classEntry.data.title}</a></li>}
    {d.specialite && <li><strong>Spécialité</strong> : {d.specialite}</li>}
    {d.niveau && <li><strong>Niveau de classe</strong> : {d.niveau}</li>}
    {d.type_capacite && <li><strong>Type</strong> : {d.type_capacite}</li>}
    {natureLabel && <li><strong>Nature</strong> : {natureLabel}</li>}
    {estClasseMagique && <li><strong>Classe magique</strong> : +4 AM avec cette spécialité</li>}
  </ul>
  {
    alternatives.length > 0 && (
      <>
        <h2>{d.nature === 'specialite' ? 'Spécialités exclusives' : 'Choix exclusif'}</h2>
        <p>
          Cette capacité est un choix : <strong>une seule</strong> parmi {alternatives.length + 1}. On ne peut pas avoir à la fois celle-ci et :
        </p>
        <ul class="chips">
          {alternatives.map((a) => <li><a class="chip chip--incompatible" href={entryHref(a)}>{nom(a)}</a></li>)}
        </ul>
        {d.nature === 'specialite' && <p class="muted">Choisir cette spécialité exclut aussi toutes les capacités de l’autre.</p>}
        {repond.length > 0 && <p class="muted">Les deux noms se répondent (« {nom(entry)} » / « {nom(repond[0])} ») : le classeur les écrit ainsi pour souligner le choix entre les deux.</p>}
      </>
    )
  }
  {cartouche && <p class="muted">Réservée à la spécialité <a href={entryHref(cartouche)}>{nom(cartouche)}</a> : elle exclut les capacités de l’autre spécialité.</p>}
</section>
