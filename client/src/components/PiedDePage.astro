---
import EntryList from './EntryList.astro';
import { loadWiki, url, type WikiEntry } from '../lib/wiki';
import { ouvrirBase } from '../lib/donnees.mjs';
import { idDuMotCle } from '../lib/mots-cles-db.mjs';
import { PARAMETRE_MOT_CLE } from '../lib/recherche-mots-cles.mjs';

// Le pied d'une page du wiki (pages/[type]/[slug].astro, components/guide/PageDuGuide.astro) : ses mots-clés, les pages qu'elle mentionne et celles
// qui la mentionnent (rétroliens, lib/wiki.ts), puis ses sources (`sources` faux : les pages rendues par un gabarit de magie, de race ou de classe ne
// citent pas leurs sources, demande du propriétaire ; les pages de Découvrir et des Bases non plus, comme leurs anciennes pages de livre ; `sources:` reste
// dans le front matter pour la traçabilité).
interface Props {
  entry: WikiEntry;
  sources?: boolean;
}
const { entry, sources = true } = Astro.props;
const { outgoing, incoming } = await loadWiki();
const mentions = outgoing.get(entry.id) ?? [];
const mentionedBy = incoming.get(entry.id) ?? [];
---

{
  /* Chaque mot-clé mène à la liste de ses pages et événements sur /recherche/ (?mot-cle=<id> : l'id figé du vocabulaire, lib/mots-cles-db.mjs) */
  entry.data.tags.length > 0 && (
    <ul class="tags" aria-label="Mots-clés">
      {entry.data.tags.map((tag) => <li><a class="badge" href={`${url('recherche/')}?${PARAMETRE_MOT_CLE}=${encodeURIComponent(idDuMotCle(ouvrirBase(), tag))}`}>{tag}</a></li>)}
    </ul>
  )
}

{
  (mentions.length > 0 || mentionedBy.length > 0) && (
    <div class="linked-pages">
      {mentions.length > 0 && (<section><h2>Cette page mentionne</h2><EntryList entries={mentions} /></section>)}
      {mentionedBy.length > 0 && (<section><h2>Mentionnée par</h2><EntryList entries={mentionedBy} /></section>)}
    </div>
  )
}

{
  sources && entry.data.sources.length > 0 && (
    <section>
      <h2>Sources</h2>
      <ul>
        {entry.data.sources.map((s) => <li>{/^https?:\/\//.test(s) ? <a href={s} rel="noopener noreferrer">{s}</a> : s}</li>)}
      </ul>
    </section>
  )
}
