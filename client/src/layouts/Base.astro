---
import '../styles/global.css';
import packageInfo from '../../package.json';
import { url } from '../lib/wiki';
import { NAV, entreesVisibles, rubriqueCourante } from '../lib/nav.mjs';
import { menuDuSite } from '../lib/menu-db.mjs';
import { avecLesSousEntrees } from '../lib/menu-sous-entrees-site';
import { modeDuSite } from '../lib/mode-site.mjs';
import Edition from '../components/edition/Edition.astro';
import Infobulles from '../components/Infobulles.astro';
import Acces from '../components/Acces.astro';
import Compte from '../components/Compte.astro';
import MenuDuProfil from '../components/MenuDuProfil.astro';
import MenuDuSite from '../components/MenuDuSite.astro';
import { cssDesAttributs } from '../lib/attributs-couleurs.mjs';
import { cssDeLaPalette } from '../lib/palette-css.mjs';
import { classeDeLaPageDuSite, cssDesMotsClesDuSite } from '../lib/couleur-de-la-page.mjs';
import { jsonDesAdressesRenommees } from '../lib/adresses-renommees.mjs';

interface Props {
  title: string;
  description?: string;
  /** Id de la page modifiable (guide, races, magies, classes, métiers) : le mode modification du site de dev s'y propose (components/edition/Edition.astro). */
  edition?: string;
  /** La page de maintenance (pages/maintenance.astro) : menus grisés et inertes, et pas de renvoi vers elle-même. */
  maintenance?: boolean;
  /**
   * L'entrée du menu (son `path`, lib/nav.mjs) d'une page qui n'en est pas une mais qu'on atteint par elle (une page d'un onglet des Règles, ou
   * l'Artisanat : l'onglet du plan de la base, lib/livres.mjs, jamais déduit de l'adresse) : marquée courante (`aria-current="true"`, l'entrée de la
   * page elle-même ayant `aria-current="page"`), et sa rubrique est celle de la page.
   */
  entree?: string;
  /**
   * L'`href` (relatif, lib/livres.mjs#cheminDePage) de la page affichée quand elle l'est à l'adresse d'une autre : la page d'ouverture d'un onglet des Règles, à /regles/<onglet>/
   * ou /regles/ : sa sous-entrée est la page courante (`aria-current="page"`), comme sur sa propre adresse.
   */
  affichee?: string;
  /**
   * La page pose elle-même sa couleur principale (les gabarits des magies, des classes, des races et du guide : lib/couleur-de-la-page.mjs#classeDeLaPage) :
   * <main> n'en prend pas.
   */
  couleurPropre?: boolean;
  /** Les ancres propres à la page (R321 (2) : les sections d'une page de magie), sous l'entrée de la page `page` dans le menu latéral : { page (son id), entrees: [{ ancre: '#id', libelle }] }. */
  ancres?: { page: string; entrees: { ancre: string; libelle: string }[] };
}
const { title, description = 'Wiki et outils pour le JDR Maverick', edition, maintenance = false, entree, affichee, couleurPropre = false, ancres } = Astro.props;
// Version portable (tools/build-artifact.mjs, INLINE_CSS=1) : pas de service, donc pas de mode modification.
const portable = process.env.INLINE_CSS === '1';

const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname.replace(/\/?$/, '/');
const site = modeDuSite(process.env, packageInfo.version);
// Entrées du site de dev seulement (la page Debug : lib/nav.mjs#entreesVisibles) : ni en production ni dans la version portable (sans service)
const dev = !site.prod && !portable;
// Le menu : cinq rubriques dans l'en-tête, les entrées de la rubrique montrée dans le menu latéral (components/MenuDuSite.astro). Les entrées sont résolues d'après
// la base (lib/menu-db.mjs : adresse, libellé et habillage du mot-clé ; titre d'un onglet des Règles), sans celles du site de dev seulement hors du site de dev.
// Les niveaux (R319 (3), lot 4) : le build écrit le menu d'un Observateur — le bouton d'une rubrique ou une entrée à `niveau` porte `data-niveau-menu` et `hidden` — et scripts/compte.mjs le
// montre selon le niveau du compte (un seul `GET /api/moi/`). La version portable, sans service, n'a que ce menu : rubriques et entrées à `niveau` y sont retirées. Cacher un
// lien ne protège pas la page.
// La rubrique courante (accent) est celle de la page, `null` pour l'accueil, la page 404 et les pages du menu du profil ; le menu montré au départ est le sien quand un
// Observateur la voit, sinon celui de la première rubrique qu'il voit (le script du menu latéral montre celle de la page si le niveau du compte la rend visible).
const courante = rubriqueCourante(Astro.url.pathname, base, NAV, entree);
const rubriquesDUnObservateur = NAV.filter((g) => !g.niveau);
const montree = courante && !courante.niveau ? courante : rubriquesDUnObservateur[0];
// Sur toutes les pages, chaque entrée porte ses sous-entrées, repliées (R321 : les pages d'un onglet des Règles, les races ; lib/menu-sous-entrees-site.ts)
const rubriques = await Promise.all(NAV.filter((g) => !(portable && g.niveau)).map(async (g) => ({ key: g.key, label: g.label, niveau: g.niveau, entrees: await avecLesSousEntrees(entreesVisibles(menuDuSite(g.items), { dev, sansNiveau: portable }), ancres) })));
// Balise des pages (métriques du navigateur, page Debug) : dans tous les builds, production comprise (décision du propriétaire du 2026-10-15 :
// « Active-le aussi en prod dans un premier temps ») ; SITE_METRIQUES_PAGES=0 au build la retire (l'interrupteur pour plus tard, comme
// MAVERICK_METRIQUES_PAGES=0 côté service). Ni dans la version portable (pas de service) ni sur la page de maintenance.
const balise = !portable && !maintenance && process.env.SITE_METRIQUES_PAGES !== '0';
// La page mesurée : son chemin construit (jamais l'adresse de la barre, ses paramètres ni ce qu'une adresse inconnue fait servir à la page 404) :
// autant de pages que le site en construit, pas plus.
const pageMesuree = Astro.url.pathname;
// La couleur principale d'une page vers laquelle mène un mot-clé coloré (réponse Q5 du propriétaire, migration 0098) : sur <main>, pour une page qui
// n'a pas de gabarit coloré (`couleurPropre`) ; aucune au départ (les mots-clés colorés mènent aux pages des magies, classes, races et du guide).
const couleurDeLaPage = couleurPropre || maintenance ? null : classeDeLaPageDuSite(Astro.url.pathname, null, { base });
// Les segments d'adresse renommés (R316 : page.slug_adresse, installés par lib/wiki.ts), pour les scripts du navigateur qui calculent une adresse depuis un
// identifiant (src/lib/adresses-renommees.mjs#jsonDesAdressesRenommees) ; null, donc rien d'écrit, tant qu'aucune page n'est renommée.
const adressesRenommees = jsonDesAdressesRenommees();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    {/* les couleurs des attributs (santé, barrière, chakra, corruption ; la 4ᵉ barre de la fiche prend la classe de sa magie) : la règle du site, lib/attributs-couleurs.mjs, lue par la fiche et le bestiaire */}
    <style is:inline set:html={cssDesAttributs()}></style>
    {/* la palette du site en classes (`.couleur-<famille>-<id>` : --couleur, --couleur-texte ; magies, attributs, caractéristiques, affinités), fabriquée
        depuis les modules des règles : lib/palette-css.mjs (choix du propriétaire du 2026-10-22, « Module JS → classe ») */}
    <style is:inline set:html={cssDeLaPalette()}></style>
    {/* les classes des mots-clés colorés (migration 0098 : une couleur écrite, ou une famille d'une zone de la palette) : leurs balises, leurs bulles et
        la page vers laquelle ils mènent (lib/couleur-de-la-page.mjs) ; le site de dev la réécrit quand le glossaire change (mots-cles-vivants.mjs) */}
    <style is:inline data-couleurs-mots-cles set:html={cssDesMotsClesDuSite()}></style>
    <title>{site.test ? '[TEST] ' : ''}{title === 'Accueil' ? 'Maverick Center' : `${title} — Maverick Center`}</title>
    {/* ce qu'une page ajoute à son en-tête (la fiche : sa politique de Referer, pour la connexion à Google) */}
    <slot name="tete" />
    {/* les segments d'adresse renommés { id: segment } (R316), lus par les scripts du navigateur (#adresses-renommees) ; rien tant qu'aucune page n'est renommée */}
    {adressesRenommees && <script is:inline type="application/json" id="adresses-renommees" set:html={adressesRenommees}></script>}
    {/* l'accès au site de dev (R310 : sur un refus de la porte, propose la connexion ou dit que le niveau ne suffit pas ; src/scripts/acces.mjs) : ni dans la version portable (pas de service) */}
    {!portable && <Acces />}
    {
      /* Maintenance pendant une mise à jour (demande du propriétaire ; serveur/maintenance.mjs, docs/serveur.md) : chaque page demande au service si
         ce serveur est en maintenance — au chargement, au retour sur l'onglet, puis toutes les 30 s — et, si oui, grise le menu et part vers
         /maintenance/ (qui revient ici dès que la nouvelle version tourne). Sans service (site statique seul), rien ne se passe. Pas dans la version
         portable, ni sur la page de maintenance (son propre script). Script en ligne : aucun module partagé entre pages (tools/build-artifact.mjs). */
      !portable && !maintenance && (
        <script is:inline data-maintenance-api={url('api/maintenance/')} data-maintenance-page={url('maintenance/')}>
          (function () {
            var s = document.currentScript, api = s.getAttribute('data-maintenance-api'), page = s.getAttribute('data-maintenance-page'), parti = false;
            function verifier() {
              if (parti || document.hidden) return;
              fetch(api, { cache: 'no-store', headers: { Accept: 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (m) {
                  if (!m || m.active !== true || parti) return;
                  parti = true;
                  document.documentElement.setAttribute('data-maintenance', '');
                  var entete = document.querySelector('.site-header__inner');
                  if (entete) entete.inert = true;
                  var lateral = document.querySelector('.menu-site');
                  if (lateral) lateral.inert = true;
                  location.replace(page + '?retour=' + encodeURIComponent(location.pathname + location.search + location.hash));
                })
                .catch(function () {});
            }
            verifier();
            setInterval(verifier, 30000);
            document.addEventListener('visibilitychange', verifier);
            addEventListener('pageshow', function (e) { if (e.persisted) { parti = false; verifier(); } });
          })();
        </script>
      )
    }
  </head>
  <body>
    {
      /* Bandeau du serveur de dev (SITE_MODE=test ; demande du propriétaire) : il renvoie à la page « Mise à jour », qui y liste les modifications en
         cours ; pas de lien sur la page de maintenance, inerte comme le menu. */
      site.test && (
        <p class="bandeau-test" role="note">
          <strong>Serveur de dev.</strong> Consultez l’onglet {maintenance ? 'Mise à jour' : <a href={url('mise-a-jour/')}>Mise à jour</a>} pour lister les modifications en cours.
        </p>
      )
    }
    <header class:list={['site-header', { 'site-header--maintenance': maintenance }]}>
      <div class="site-header__inner" inert={maintenance || undefined}>
        {/* le bouton à trois barres du tiroir du menu latéral (écran étroit) : caché jusqu'à ce que le script du menu (components/MenuDuSite.astro) l'affiche */}
        <button type="button" class="menu-site__burger" aria-expanded="false" aria-controls="menu-du-site" aria-label="Ouvrir le menu latéral" data-menu-burger hidden>
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
        <a class="brand" href={url()}><img src={url('logo.webp')} alt="Maverick Center" width="319" height="320" /></a>
        <div class="site-header__menu">
          {/* les cinq rubriques sur la ligne de l'en-tête (R319 (1)) : cliquer l'une change le menu latéral (components/MenuDuSite.astro) sans changer de page ;
              `aria-current` : la rubrique de la page, `aria-pressed` : celle dont le menu latéral est montré */}
          <nav class="site-nav" aria-label="Rubriques du site">
            <ul class="site-nav__groups">
              {
                rubriques.map((group) => (
                  <li>
                    <button type="button" class="nav-group__toggle" data-group={group.key} aria-pressed={group.key === montree.key ? 'true' : 'false'} aria-current={courante && group.key === courante.key ? 'true' : undefined} data-niveau-menu={group.niveau} hidden={group.niveau ? true : undefined}>
                      {group.label}
                    </button>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        {/* le compte (R310 (7), R319 (1)) : avatar et pseudo qui ouvrent le menu du profil, ou « Connexion via Discord » ; ni dans la version portable (pas de service : seulement le petit menu Glossaire et Recherche) ni sur la page de maintenance */}
        {!portable && !maintenance && <Compte prod={site.prod} dev={dev} ici={here} />}
        {portable && <MenuDuProfil portable ici={here} />}
      </div>
    </header>
    <MenuDuSite rubriques={rubriques} montree={montree.key} ici={here} entree={entree} affichee={affichee} maintenance={maintenance}>
      <main class={couleurDeLaPage ? `page-coloree ${couleurDeLaPage}` : undefined}>
        <slot />
      </main>
    </MenuDuSite>
    <footer class="site-footer">
      <span>Projet de fan pour Maverick JDR — contenu issu du Discord et des Google Docs du MJ.</span>
      {/* les règles de confidentialité (demande du propriétaire, 2026-11-21 : Google les exige pour le bouton « Exporter » de la fiche) : lien discret */}
      <a class="site-footer__lien" href={url('confidentialite/')} data-confidentialite>Confidentialité</a>
      <span class="site-footer__version">{site.etiquette}</span>
    </footer>
    {edition && !portable && <Edition page={edition} />}
    <Infobulles />
    {
      /* Balise des pages (demande du propriétaire du 2026-10-15 : métriques « dans un but de suivi, maintenance et évolutions » ; serveur/metriques.mjs,
         page Debug) : une fois la page chargée, ses temps vus par le navigateur — premier octet (TTFB), DOMContentLoaded, chargement complet, LCP
         (PerformanceObserver quand il existe) — partent UNE fois, par navigator.sendBeacon (texte JSON : { page, ttfb_ms, dom_ms, charge_ms, lcp_ms },
         un temps absent est omis), 5 s après le chargement ou plus tôt si l'on quitte la page (pagehide, ou onglet masqué APRÈS le chargement). Un
         onglet masqué AVANT la fin du chargement n'envoie rien tout de suite : la balise part dès le chargement fini, même en arrière-plan (sinon le
         chargement complet manquerait justement aux pages les plus lentes, celles qu'on quitte en attendant) ; seule la page quittée (pagehide)
         l'envoie avant, sans les temps qui manquent. Rien d'autre : ni adresse complète, ni paramètres, ni identifiant. Chaque instance l'écrit dans SON fichier de métriques, jamais dans la base vivante ; le service peut la refuser (403,
         MAVERICK_METRIQUES_PAGES=0) sans que la page le voie. Script en ligne : aucun module partagé entre pages (tools/build-artifact.mjs). */
      balise && (
        <script is:inline data-metriques-page={url('api/metriques/page/')} data-metriques-chemin={pageMesuree}>
          (function () {
            var s = document.currentScript, adresse = s && s.getAttribute('data-metriques-page'), page = s && s.getAttribute('data-metriques-chemin');
            var perf = typeof performance === 'object' ? performance : null, nav = navigator;
            if (!adresse || !page || !perf || !perf.getEntriesByType || !nav.sendBeacon) return;
            var lcp, parti = false, charge = false, minuterie = 0;
            try {
              new PerformanceObserver(function (liste) {
                var e = liste.getEntries(), d = e[e.length - 1];
                if (d) lcp = d.renderTime || d.startTime;
              }).observe({ type: 'largest-contentful-paint', buffered: true });
            } catch (e) {}
            function ms(v) { return typeof v === 'number' && isFinite(v) && v > 0 ? Math.min(Math.round(v * 100) / 100, 120000) : undefined; }
            function envoyer() {
              if (parti) return;
              var n = perf.getEntriesByType('navigation')[0];
              if (!n) return;
              parti = true;
              clearTimeout(minuterie);
              try {
                nav.sendBeacon(adresse, JSON.stringify({ page: page.slice(0, 200), ttfb_ms: ms(n.responseStart), dom_ms: ms(n.domContentLoadedEventEnd), charge_ms: ms(n.loadEventEnd), lcp_ms: ms(lcp) }));
              } catch (e) {}
            }
            // chargée en arrière-plan : la balise part aussitôt la fin du chargement notée (loadEventEnd n'est posé qu'après les écouteurs de « load »)
            function apresLeChargement() { charge = true; minuterie = setTimeout(envoyer, document.visibilityState === 'hidden' ? 0 : 5000); }
            if (document.readyState === 'complete') apresLeChargement(); else addEventListener('load', apresLeChargement);
            addEventListener('pagehide', envoyer);
            document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden' && charge) envoyer(); });
          })();
        </script>
      )
    }
  </body>
</html>
