---
import '../styles/global.css';
import packageInfo from '../../package.json';
import { url } from '../lib/wiki';
import { NAV, activeGroup, entreesDuMenu, groupIsCurrent } from '../lib/nav.mjs';
import { modeDuSite } from '../lib/mode-site.mjs';
import Edition from '../components/edition/Edition.astro';
import Infobulles from '../components/Infobulles.astro';

interface Props {
  title: string;
  description?: string;
  /** Id de la page modifiable (guide, races, magies, classes, métiers) : le mode modification du site de dev s'y propose (components/edition/Edition.astro). */
  edition?: string;
  /** La page de maintenance (pages/maintenance.astro) : menus grisés et inertes, et pas de renvoi vers elle-même. */
  maintenance?: boolean;
}
const { title, description = 'Wiki et outils pour le JDR Maverick', edition, maintenance = false } = Astro.props;
// Version portable (tools/build-artifact.mjs, INLINE_CSS=1) : pas de service, donc pas de mode modification.
const portable = process.env.INLINE_CSS === '1';

const base = import.meta.env.BASE_URL;
const active = activeGroup(Astro.url.pathname, base);
const here = Astro.url.pathname.replace(/\/?$/, '/');
const site = modeDuSite(process.env, packageInfo.version);
// Entrées du site de dev seulement (la page Debug : lib/nav.mjs#entreesDuMenu) : ni en production ni dans la version portable (sans service)
const dev = !site.prod && !portable;
// Balise des pages (métriques du navigateur, page Debug) : dans tous les builds, production comprise (décision du propriétaire du 2026-10-15 :
// « Active-le aussi en prod dans un premier temps ») ; SITE_METRIQUES_PAGES=0 au build la retire (l'interrupteur pour plus tard, comme
// MAVERICK_METRIQUES_PAGES=0 côté service). Ni dans la version portable (pas de service) ni sur la page de maintenance.
const balise = !portable && !maintenance && process.env.SITE_METRIQUES_PAGES !== '0';
// La page mesurée : son chemin construit (jamais l'adresse de la barre, ses paramètres ni ce qu'une adresse inconnue fait servir à la page 404) :
// autant de pages que le site en construit, pas plus.
const pageMesuree = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <title>{site.test ? '[TEST] ' : ''}{title === 'Accueil' ? 'Maverick Center' : `${title} — Maverick Center`}</title>
    {
      /* Maintenance pendant une mise à jour (demande du propriétaire ; serveur/maintenance.mjs, docs/serveur.md) : chaque page demande au service si
         ce serveur est en maintenance — au chargement, au retour sur l'onglet, puis toutes les 30 s — et, si oui, grise le menu et part vers
         /maintenance/ (qui revient ici dès que la nouvelle version tourne). Sans service (site statique seul), rien ne se passe. Pas dans la version
         portable, ni sur la page de maintenance (son propre script). Script en ligne : aucun module partagé entre pages (tools/build-artifact.mjs). */
      !portable && !maintenance && (
        <script is:inline data-maintenance-api={url('api/maintenance/')} data-maintenance-page={url('maintenance/')}>
          (function () {
            var s = document.currentScript, api = s.getAttribute('data-maintenance-api'), page = s.getAttribute('data-maintenance-page'), parti = false;
            function verifier() {
              if (parti || document.hidden) return;
              fetch(api, { cache: 'no-store', headers: { Accept: 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (m) {
                  if (!m || m.active !== true || parti) return;
                  parti = true;
                  document.documentElement.setAttribute('data-maintenance', '');
                  var entete = document.querySelector('.site-header__inner');
                  if (entete) entete.inert = true;
                  location.replace(page + '?retour=' + encodeURIComponent(location.pathname + location.search + location.hash));
                })
                .catch(function () {});
            }
            verifier();
            setInterval(verifier, 30000);
            document.addEventListener('visibilitychange', verifier);
            addEventListener('pageshow', function (e) { if (e.persisted) { parti = false; verifier(); } });
          })();
        </script>
      )
    }
  </head>
  <body>
    {
      /* Bandeau du serveur de dev (SITE_MODE=test ; demande du propriétaire) : il renvoie à la page « Mise à jour », qui y liste les modifications en
         cours ; pas de lien sur la page de maintenance, inerte comme le menu. */
      site.test && (
        <p class="bandeau-test" role="note">
          <strong>Serveur de dev.</strong> Consultez l’onglet {maintenance ? 'Mise à jour' : <a href={url('mise-a-jour/')}>Mise à jour</a>} pour lister les modifications en cours.
        </p>
      )
    }
    <header class:list={['site-header', { 'site-header--maintenance': maintenance }]}>
      <div class="site-header__inner" inert={maintenance || undefined}>
        <a class="brand" href={url()}><img src={url('logo.webp')} alt="Maverick Center" width="319" height="320" /></a>
        <div class="site-header__menu">
          <nav class="site-nav" aria-label="Navigation principale">
            <ul class="site-nav__groups">
              {
                NAV.map((group) => (
                  <li>
                    <button type="button" class="nav-group__toggle" data-group={group.key} aria-pressed={group.key === active.key ? 'true' : 'false'} aria-current={groupIsCurrent(group, Astro.url.pathname, base) ? 'true' : undefined}>
                      {group.label}
                    </button>
                  </li>
                ))
              }
            </ul>
            {
              NAV.map((group) => (
                <ul class="site-nav__items" data-group={group.key} hidden={group.key !== active.key}>
                  {entreesDuMenu(group, { dev }).length === 0 && <li class="nav-soon">À compléter</li>}
                  {entreesDuMenu(group, { dev }).map((item) => (
                    <li>
                      {item.path ? (
                        <a href={url(item.path)} aria-current={here === url(item.path) ? 'page' : undefined}>{item.label}</a>
                      ) : (
                        <span class="nav-soon">{item.label} <small>(bientôt)</small></span>
                      )}
                    </li>
                  ))}
                </ul>
              ))
            }
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Projet de fan pour Maverick JDR — contenu issu du Discord et des Google Docs du MJ.</span>
      <span class="site-footer__version">{site.etiquette}</span>
    </footer>
    {edition && !portable && <Edition page={edition} />}
    <Infobulles />
    {
      /* Balise des pages (demande du propriétaire du 2026-10-15 : métriques « dans un but de suivi, maintenance et évolutions » ; serveur/metriques.mjs,
         page Debug) : une fois la page chargée, ses temps vus par le navigateur — premier octet (TTFB), DOMContentLoaded, chargement complet, LCP
         (PerformanceObserver quand il existe) — partent UNE fois, par navigator.sendBeacon (texte JSON : { page, ttfb_ms, dom_ms, charge_ms, lcp_ms },
         un temps absent est omis), 5 s après le chargement ou plus tôt si l'on quitte la page. Rien d'autre : ni adresse complète, ni paramètres, ni
         identifiant. Chaque instance l'écrit dans SON fichier de métriques, jamais dans la base vivante ; le service peut la refuser (403,
         MAVERICK_METRIQUES_PAGES=0) sans que la page le voie. Script en ligne : aucun module partagé entre pages (tools/build-artifact.mjs). */
      balise && (
        <script is:inline data-metriques-page={url('api/metriques/page/')} data-metriques-chemin={pageMesuree}>
          (function () {
            var s = document.currentScript, adresse = s && s.getAttribute('data-metriques-page'), page = s && s.getAttribute('data-metriques-chemin');
            var perf = typeof performance === 'object' ? performance : null, nav = navigator;
            if (!adresse || !page || !perf || !perf.getEntriesByType || !nav.sendBeacon) return;
            var lcp, parti = false, minuterie = 0;
            try {
              new PerformanceObserver(function (liste) {
                var e = liste.getEntries(), d = e[e.length - 1];
                if (d) lcp = d.renderTime || d.startTime;
              }).observe({ type: 'largest-contentful-paint', buffered: true });
            } catch (e) {}
            function ms(v) { return typeof v === 'number' && isFinite(v) && v > 0 ? Math.min(Math.round(v * 100) / 100, 120000) : undefined; }
            function envoyer() {
              if (parti) return;
              var n = perf.getEntriesByType('navigation')[0];
              if (!n) return;
              parti = true;
              clearTimeout(minuterie);
              try {
                nav.sendBeacon(adresse, JSON.stringify({ page: page.slice(0, 200), ttfb_ms: ms(n.responseStart), dom_ms: ms(n.domContentLoadedEventEnd), charge_ms: ms(n.loadEventEnd), lcp_ms: ms(lcp) }));
              } catch (e) {}
            }
            function apresLeChargement() { minuterie = setTimeout(envoyer, 5000); }
            if (document.readyState === 'complete') apresLeChargement(); else addEventListener('load', apresLeChargement);
            addEventListener('pagehide', envoyer);
            document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') envoyer(); });
          })();
        </script>
      )
    }
    <script is:inline>
      (function () {
        var toggles = document.querySelectorAll('.nav-group__toggle');
        var rows = document.querySelectorAll('.site-nav__items');
        toggles.forEach(function (t) {
          t.addEventListener('click', function () {
            toggles.forEach(function (o) { o.setAttribute('aria-pressed', o === t ? 'true' : 'false'); });
            rows.forEach(function (r) { r.hidden = r.getAttribute('data-group') !== t.getAttribute('data-group'); });
          });
        });
      })();
    </script>
  </body>
</html>
