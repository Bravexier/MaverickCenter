---
import '../styles/global.css';
import { url } from '../lib/wiki';
import { NAV, groupIsCurrent } from '../lib/nav.mjs';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Wiki et outils pour le JDR Maverick' } = Astro.props;

const base = import.meta.env.BASE_URL;
const current = (group: (typeof NAV)[number]) => groupIsCurrent(group, Astro.url.pathname, base);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title === 'Accueil' ? 'Maverick Center' : `${title} — Maverick Center`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={url()}>Maverick Center</a>
        <nav class="site-nav" aria-label="Navigation principale">
          <ul class="site-nav__groups">
            {
              NAV.map((group) => (
                <li class="nav-group">
                  <button type="button" class="nav-group__toggle" aria-expanded="false" aria-controls={`menu-${group.key}`} aria-current={current(group) ? 'true' : undefined}>
                    {group.label}
                  </button>
                  <ul class="nav-group__menu" id={`menu-${group.key}`}>
                    {group.items.length === 0 && <li class="nav-soon">À compléter</li>}
                    {group.items.map((item) => (
                      <li>
                        {item.path ? (
                          <a href={url(item.path)}>{item.label}</a>
                        ) : (
                          <span class="nav-soon">{item.label} <small>(bientôt)</small></span>
                        )}
                        {item.links && (
                          <ul class="nav-group__links">
                            {item.links.map((l) => <li><a href={url(l.path)}>{l.label}</a></li>)}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </nav>
        <form class="search-form" action={url('recherche/')} role="search">
          <input type="search" name="q" placeholder="Rechercher…" aria-label="Rechercher dans le wiki" />
          <button type="submit">OK</button>
        </form>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">Projet de fan pour Maverick JDR — contenu issu du Discord et des Google Docs du MJ.</footer>
      <script is:inline>
      (function () {
        var toggles = document.querySelectorAll('.nav-group__toggle');
        function closeAll(except) {
          toggles.forEach(function (t) { if (t !== except) t.setAttribute('aria-expanded', 'false'); });
        }
        toggles.forEach(function (t) {
          t.addEventListener('click', function () {
            var open = t.getAttribute('aria-expanded') === 'true';
            closeAll(t);
            t.setAttribute('aria-expanded', open ? 'false' : 'true');
          });
        });
        document.addEventListener('click', function (e) { if (!e.target.closest('.nav-group')) closeAll(); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { var open = document.querySelector('.nav-group__toggle[aria-expanded="true"]'); closeAll(); if (open) open.focus(); }
        });
      })();
    </script>
  </body>
</html>
