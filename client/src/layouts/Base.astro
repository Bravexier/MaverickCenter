---
import '../styles/global.css';
import packageInfo from '../../package.json';
import { url } from '../lib/wiki';
import { NAV, activeGroup, groupIsCurrent } from '../lib/nav.mjs';
import { modeDuSite } from '../lib/mode-site.mjs';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Wiki et outils pour le JDR Maverick' } = Astro.props;

const base = import.meta.env.BASE_URL;
const active = activeGroup(Astro.url.pathname, base);
const here = Astro.url.pathname.replace(/\/?$/, '/');
const site = modeDuSite(process.env, packageInfo.version);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <title>{site.test ? '[TEST] ' : ''}{title === 'Accueil' ? 'Maverick Center' : `${title} — Maverick Center`}</title>
  </head>
  <body>
    {site.test && <p class="bandeau-test" role="note"><strong>Serveur de test</strong> — {site.etiquette}, version en cours de développement : ce n’est pas le site de production.</p>}
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={url()}><img src={url('logo.webp')} alt="Maverick Center" width="319" height="320" /></a>
        <div class="site-header__menu">
          <nav class="site-nav" aria-label="Navigation principale">
            <ul class="site-nav__groups">
              {
                NAV.map((group) => (
                  <li>
                    <button type="button" class="nav-group__toggle" data-group={group.key} aria-pressed={group.key === active.key ? 'true' : 'false'} aria-current={groupIsCurrent(group, Astro.url.pathname, base) ? 'true' : undefined}>
                      {group.label}
                    </button>
                  </li>
                ))
              }
            </ul>
            {
              NAV.map((group) => (
                <ul class="site-nav__items" data-group={group.key} hidden={group.key !== active.key}>
                  {group.items.length === 0 && <li class="nav-soon">À compléter</li>}
                  {group.items.map((item) => (
                    <li>
                      {item.path ? (
                        <a href={url(item.path)} aria-current={here === url(item.path) ? 'page' : undefined}>{item.label}</a>
                      ) : (
                        <span class="nav-soon">{item.label} <small>(bientôt)</small></span>
                      )}
                    </li>
                  ))}
                </ul>
              ))
            }
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Projet de fan pour Maverick JDR — contenu issu du Discord et des Google Docs du MJ.</span>
      <span class="site-footer__version">{site.etiquette}</span>
    </footer>
      <script is:inline>
      (function () {
        var toggles = document.querySelectorAll('.nav-group__toggle');
        var rows = document.querySelectorAll('.site-nav__items');
        toggles.forEach(function (t) {
          t.addEventListener('click', function () {
            toggles.forEach(function (o) { o.setAttribute('aria-pressed', o === t ? 'true' : 'false'); });
            rows.forEach(function (r) { r.hidden = r.getAttribute('data-group') !== t.getAttribute('data-group'); });
          });
        });
      })();
    </script>
  </body>
</html>
