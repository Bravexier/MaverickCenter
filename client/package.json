{
  "name": "maverick-center-client",
  "version": "0.5.33",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:depuis-contenu": "node --no-warnings scripts/fabriquer-depuis-contenu.mjs",
    "comparer-sites": "node --no-warnings scripts/comparer-sites.mjs",
    "preview": "astro preview",
    "serveur": "node --disable-warning=ExperimentalWarning serveur/dev.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:cible": "node --no-warnings scripts/tests-cibles.mjs",
    "autolink": "node scripts/autolink.mjs",
    "decisions:index": "node --no-warnings scripts/decisions-index.mjs",
    "db:init": "node --no-warnings scripts/db-init.mjs",
    "db:doc": "node --no-warnings scripts/db-doc.mjs",
    "db:build": "node --no-warnings scripts/db-build.mjs && node --no-warnings scripts/db-derive.mjs",
    "db:check": "node --no-warnings scripts/db-check.mjs",
    "db:sync-pages": "node --no-warnings scripts/db-sync-pages.mjs",
    "db:pages-check": "python3 -I ../tools/db/pages_md.py check",
    "db:export-pages": "node --no-warnings scripts/db-export-pages.mjs",
    "predev": "node --no-warnings scripts/db-export-pages.mjs",
    "prebuild": "node --no-warnings scripts/db-export-pages.mjs",
    "pretest": "node --no-warnings scripts/db-export-pages.mjs",
    "db:migrate": "python3 -I ../tools/db/migrer.py",
    "db:appliquer-edition": "node --no-warnings scripts/db-appliquer-edition.mjs",
    "db:extrait": "node --no-warnings scripts/db-extrait.mjs",
    "db:epreuve-lots": "node --no-warnings scripts/epreuve-des-lots.mjs refaire",
    "db:controler-migrations": "node --no-warnings scripts/controler-les-migrations.mjs",
    "mutation": "node --no-warnings scripts/mutation.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5",
    "github-slugger": "^2.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  }
}
