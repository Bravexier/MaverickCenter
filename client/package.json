{
  "name": "maverick-center-client",
  "version": "0.1.44",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test \"test/*.test.mjs\"",
    "autolink": "node scripts/autolink.mjs",
    "db:init": "node --no-warnings scripts/db-init.mjs",
    "db:doc": "node --no-warnings scripts/db-doc.mjs",
    "db:build": "node --no-warnings scripts/db-build.mjs && node --no-warnings scripts/db-derive.mjs",
    "db:check": "node --no-warnings scripts/db-check.mjs",
    "db:sync-pages": "python3 -I ../tools/db/pages_md.py sync",
    "db:pages-check": "python3 -I ../tools/db/pages_md.py check",
    "db:export-pages": "node --no-warnings scripts/db-export-pages.mjs",
    "predev": "node --no-warnings scripts/db-export-pages.mjs",
    "prebuild": "node --no-warnings scripts/db-export-pages.mjs",
    "pretest": "node --no-warnings scripts/db-export-pages.mjs",
    "db:migrate": "python3 -I ../tools/db/migrer.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5",
    "yaml": "^2.9.1"
  }
}
